		// изменение статуса инвойса через комплектовщика или упаковщика с сохранением акцептации
		public static function doSetStatusAndAccept($result, $params)
		{
			global $ioSession;
			
			$pkid = xarr($params, 'pkid');
			$status = xarr($params, 'status');
			$accepted_products = xarr($params, 'products', array());
			
			if($pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid';
				goto __exit;
			}
			if(!in_array($status, array(0, 2, 5, 7)))
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Некорректный статус инвойса';
				goto __exit;
			}
			if($status == 7)
			{
				if(count($accepted_products) <= 0)
				{
					$result->error_code = EIO_USER - 2;
					$result->error_str = 'Добавьте товары';
					goto __exit;
				}
				$products_accepted_cnt = 0;
				foreach($accepted_products as $accepted_product)
				{
					$accpr_creator_number = xarr($accepted_product, 'qr_code_creator_number');
					$accpr_serial_number = xarr($accepted_product, 'qr_code_serial_number');
					if($accpr_creator_number != null and $accpr_creator_number != ''
					and $accpr_serial_number != null and $accpr_serial_number != '')
					{
						$products_accepted_cnt++;
					}
				}
				if($products_accepted_cnt < count($accepted_products))
				{
					$result->error_code = EIO_USER - 3;
					$result->error_str = 'Акцептуйте все товары';
					goto __exit;
				}
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$obj = array_shift($res);
			if($obj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			
			$obj->products = $accepted_products;
			$obj->status = $status;
			if(in_array($status, array(2, 7)))
			{
				$obj->picker_pkid = $ioSession->user->id;
				$obj->picker_login = $ioSession->user->login;
			}
			else
			{
				$obj->picker_pkid = null;
				$obj->picker_login = null;
			}
			$obj->update();
			
			$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
			$result->error_str = xarr($obj, 'error_str', '');
			
			__exit:
			return $result;
		}
		
		
		
		
		
