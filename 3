		// подтверждение доставки товара покупателем
		public static function doSetDeliveryUser($result, $params)
		{
			global $ioSession;
			
			$pkid = xarr($params, 'pkid');
			$pos = xarr($params, 'pos', array());
			
			if($pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid инвойса';
				goto __exit;
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$obj = array_shift($res);
			if($obj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			if(xarr($obj, 'client_pkid') != 'user_'.$ioSession->user->login)
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Вы не можете подтверждать доставку товаров чужого инвойса';
				goto __exit;
			}
			
			$flag_delivered = true;
			if(count($pos) > 0)
			{
				$obj_products = xarr($obj, 'products', array());
				foreach($pos as $el)
				{
					$obj_products[$el]['isDelivered'] = true;
				}
				$obj->products = $obj_products;
				
				foreach($obj_products as $product)
				{
					if(!xarr($product, 'isDelivered', false))
					{
						$flag_delivered = false;
					}
				}
				if($flag_delivered)
				{
					$obj->status = 12; // доставлен
					$obj->dateDelivery = time();
				}
			}
			else
			{
				$obj_products = xarr($obj, 'products', array());
				foreach($obj_products as &$product)
				{
					$product['isDelivered'] = true;
				}
				$obj->products = $obj_products;
				$obj->status = 12; // доставлен
				$obj->dateDelivery = time();
			}
			$result->delivered = $flag_delivered;
			
			$obj->update();
			if(xarr($obj, 'error_code', EIO_FALSE) != EIO_OK)
			{
				$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
				$result->error_str = xarr($obj, 'error_str', '');
				goto __exit;
			}
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
