		// изменение возврата
		public static function doEditReturn($result, $params)
		{
			global $ioSession, $ioProjects;
			
			$pkid = xarr($params, 'pkid');
			$event = xarr($params, 'event', 'edit');
			$warehouse_pkid = xarr($params, 'warehouse_pkid');
			$status = xarr($params, 'status', 101);
			$client_pkid = xarr($params, 'client_pkid');
			$client_cardnum = xarr($params, 'client_cardnum');
			$currency = xarr($params, 'currency');
			$amount = xarr($params, 'amount');
			$amount_cash = xarr($params, 'amount_cash');
			$amount_paid = xarr($params, 'amount_paid');
			$amount_odd = xarr($params, 'amount_odd');
			$products = xarr($params, 'products', array());
			$payments = xarr($params, 'payments', array());
			
			$rinvoice = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'company_pkid' => $ioSession->user->getCompanyID(),
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$resinvoice = xarr($rinvoice, 'res', array());
			$invoiceobj = array_shift($resinvoice);
			if($invoiceobj == null)
			{
				$result->error_code = EIO_OBJECT_NOTFOUND;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			if(xarr($invoiceobj, 'status', 101) == -1)
			{
				$result->error_code = EIO_USER - 14;
				$result->error_str = 'Инвойс отменен';
				goto __exit;
			}
			
			if(in_array($event, array('edit-return')))
			{
				if(!$ioSession->user->permission('bmc.trade2.items.return'))
				{
					$result->error_code = EIO_USER - 1;
					$result->error_str = 'Вы не имеете полномочий оформить возврат товара';
					goto __exit;
				}
				
				if(!valid_money($amount))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма продажи';
					goto __exit;
				}
				if(!valid_money($amount_paid))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма возврата';
					goto __exit;
				}
				if(!valid_money($amount_cash))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма возврата';
					goto __exit;
				}
				
				if(xarr($invoiceobj, 'status', 101) == 102)
				{
					$result->error_code = EIO_USER - 15;
					$result->error_str = 'Возврат уже оформлен';
					goto __exit;
				}
			}
			
			// проверка платежей
			foreach($payments as $payment)
			{
				$payment_pay_type = xarr($payment, 'pay_type');
				$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
				$payment_amount = xarr(xarr($payment, 'amount', array()), 'value', 0);
				
				if($payment_pay_type == null)
				{
					$result->error_code = EIO_USER - 18;
					$result->error_str = 'Один из платежей имеет неизвестный тип';
					goto __exit;
				}
				elseif($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
				{
					$payment_client_login = '';
					if(strpos($client_pkid, 'user_') === 0)
					{
						$payment_client_login = substr($client_pkid, 5);
					}
					if($payment_client_login == '')
					{
						$result->error_code = EIO_USER - 18;
						$result->error_str = 'Платежи с использованием счетов либо баланса аккаунта возможны только для зарегистрированных клиентов';
						goto __exit;
					}
					
					if($payment_moneypacket_pkid)
					{
						// проверка счета покупателя на наличие активности
						$rmp = IOCore::call(
							'upi.class.moneyPackets.dbsearch2',
							array(
								'filter' => array(
									'pkid' => $payment_moneypacket_pkid,
									'isActive' => true,
									'isDeleted' => false,
								),
								'limit' => 1,
								'out' => 'array',
							)
						);
						$resmp = xarr($rmp, 'res', array());
						$mp = array_shift($resmp);
						if(!$mp)
						{
							$result->error_code = EIO_USER - 22;
							$result->error_str = 'В одном из платежей используется счет, который в данный момент деактивирован';
							goto __exit;
						}
					}
				}
			}
			
			if(xarr($invoiceobj, 'type') == null)
			{
				$invoiceobj->type = 1; // возврат
			}
			$invoiceobj->status = $status;
			
			$client_isCompany = false;
			$client_company_pkid = null;
			
			if($ioSession->user->permission('bmc.trade2.invoice.manage'))
			{
				if(!xarr($invoiceobj, 'isPayed', false)
				and in_array(xarr($invoiceobj, 'status'), array(101)))
				{
					if(strpos($client_pkid, 'crm_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$crm_client_pkid = intval(substr($client_pkid, 4));
						if($crm_client_pkid != 0)
						{
							$invoiceobj->client_pkid = $client_pkid;
						}
					}
					elseif(strpos($client_pkid, 'user_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$user_client_pkid = substr($client_pkid, 5);
						if($user_client_pkid != '')
						{
							$invoiceobj->client_pkid = $client_pkid;
						}
					}
					elseif(strpos($client_pkid, 'company_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$company_client_pkid = substr($client_pkid, 8);
						if($company_client_pkid != '')
						{
							$invoiceobj->client_pkid = $client_pkid;
							$client_isCompany = true;
							$client_company_pkid = $company_client_pkid;
						}
					}
					else
					{
						$invoiceobj->client_pkid = $client_pkid;
					}
					
					$invoiceobj->client_cardnum = $client_cardnum;
					
					$invoiceobj->warehouse_pkid = $warehouse_pkid;
				}
			}
			
			if(in_array(xarr($invoiceobj, 'status'), array(101)))
			{
				if($ioSession->user->permission('bmc.trade2.invoice.items.add'))
				{
					$invoiceobj->products = $products;
				}
				if(!xarr($invoiceobj, 'isPayed', false))
				{
					// общая сумма товаров, которая вычисляется по предложениям (без учета доставки, общей скидки и аванса)
					$amount_value = xarr($amount, 'value');
					$amount['value'] = -$amount_value;
					$invoiceobj->amount = $amount;
					
					// сумма инвойса (за которую были куплены товары + доставка + скидка + аванс)
					$amount_paid_value = xarr($amount_paid, 'value');
					$amount_paid['value'] = -$amount_paid_value;
					$invoiceobj->amount_paid = $amount_paid;
					
					// сумма наличных (сколько денег дал клиент. например товар стоит 85, клиент дал 100, тогда в этом поле будет 100)
					$amount_cash_value = xarr($amount_cash, 'value');
					$invoiceobj->amount_cash = $amount_cash;
					
					if($amount_paid_value == 'NaN') $amount_paid_value = $amount_value;
					
					// раcсчитываем сумму скидки
					$discount = $amount_value - $amount_paid_value; 
					$invoiceobj->discount = array(
						'currency' => xarr($amount_cash, 'currency'),
						'value' => $discount,
						'pay_type' => null,
					);
					
					$invoiceobj->amount_delivery = array(
						'currency' => xarr($amount_cash, 'currency'),
						'value' => 0,
						'pay_type' => null,
					);
				}
			}
			
			if(in_array($event, array('edit-return')))
			{
				foreach($products as &$product1)
				{
					$product1_amount = xarr($product1, 'amount', array());
					$product1_amount_value = floatval(xarr($product1_amount, 'value', 0));
					$product1['amount']['value'] = -$product1_amount_value;
					
					$product1_discount = floatval(xarr($product1, 'discount', 0));
					$product1['discount'] = -$product1_discount;
				}
				$invoiceobj->products = $products;
				
				// рассчитываем наличные
				$amount_value = abs(xarr(xarr($invoiceobj, 'amount', array()), 'value', 0));
				$amount_cash_value = xarr(xarr($invoiceobj, 'amount_cash', array()), 'value', 0);
				$amount_paid_value = abs(xarr(xarr($invoiceobj, 'amount_paid', array()), 'value', 0));
				$amount_odd = ($amount_value - $discount) - $amount_cash_value; // сдача
				if($amount_odd <= 0)
				{
					$amount_cash_value += $amount_odd;
				}
				else
				{
					// если сдача ушла в минус, запретить оформлять продажу и доставку
					$result->error_code = EIO_USER - 3;
					$result->error_str = 'Сдача не может быть отрицательной';
					goto __exit;
				}
				$invoiceobj->amount_cash = array(
					'currency' => xarr($amount_cash, 'currency'),
					'value' => -$amount_cash_value,
					'pay_type' => xarr($amount_cash, 'pay_type'),
				);
				
				$discount_v = xarr($invoiceobj, 'discount');
				$discount_v['value'] = -$discount;
				$invoiceobj->discount = $discount_v;
				
				// проверка на валюту
				$currencies = array(
					xarr(xarr($invoiceobj, 'discount', array()), 'currency'),
					xarr(xarr($invoiceobj, 'amount', array()), 'currency'),
					xarr(xarr($invoiceobj, 'amount_cash', array()), 'currency'),
					xarr(xarr($invoiceobj, 'amount_paid', array()), 'currency'),
				);
				foreach($currencies as $key => $val)
				{
					if($val != $currency or !$val)
					{
						$result->error_code = EIO_VALIDATION_FIELD;
						$result->error_str = 'Валюта';
						goto __exit;
					}
				}
				
				if(count(xarr($invoiceobj, 'products', array())) == 0)
				{
					$result->error_code = EIO_USER - 4;
					$result->error_str = 'Добавьте товары';
					goto __exit;
				}
				
				$invoiceobj->status = 102;
				$invoiceobj->isPayed = true;
				$invoiceobj->dateSale = time();
				$invoiceobj->cashier_pkid = $ioSession->user->id;
				$invoiceobj->cashier_login = $ioSession->user->login;
				
				// проверяем корректность доставки товара клиенту
				// начинаем процесс списания QR кодов
				$findQRUID = null;
				$object_products = $products;
				$serial_index = array();
				$qr_uids = array();	
				
				// чистим массив $products (новые установленные QR коды) от тех что уже есть в базе
				// в итоге должны остаться только те QR коды, для которых установлен новый серийный номер
				// либо не установлен вообще. Здесь идет сверка QR кодов формы с теми что в базе
				foreach($object_products as $i => $obj)
				{
					$tid = xarr($obj, 'tid');
					$size_pkid = xarr($obj, 'size_pkid');
					$color_pkid = xarr($obj, 'color_pkid');
					$gender_pkid = xarr($obj, 'gender_pkid');
					$qr_code_creator_number = xarr($obj, 'qr_code_creator_number');
					$qr_code_serial_number = xarr($obj, 'qr_code_serial_number');
					foreach($products as $j => $product)
					{
						$product_tid = xarr($product, 'tid');
						$product_size_pkid = xarr($product, 'size_pkid');
						$product_color_pkid = xarr($product, 'color_pkid');
						$product_gender_pkid = xarr($product, 'gender_pkid');
						$product_qr_code_creator_number = xarr($product, 'qr_code_creator_number');
						$product_qr_code_serial_number = xarr($product, 'qr_code_serial_number');
						
						if($tid == $product_tid
						and $size_pkid == $product_size_pkid
						and $color_pkid == $product_color_pkid
						and $gender_pkid == $product_gender_pkid
						and $qr_code_creator_number == $product_qr_code_creator_number
						and $qr_code_serial_number == $product_qr_code_serial_number)
						{
							$object_products[$i]['__qr_correct'] = true;
							unset($products[$j]);
							break;
						}
					}
				}
				
				// устанавливаем новые QR коды если они пустые, из тех, что остались в массиве $products
				foreach($object_products as $i => $obj)
				{
					$tid = xarr($obj, 'tid');
					$size_pkid = xarr($obj, 'size_pkid');
					$color_pkid = xarr($obj, 'color_pkid');
					$gender_pkid = xarr($obj, 'gender_pkid');
					
					$__qr_correct = xarr($obj, '__qr_correct', false);
					if($__qr_correct) continue;
					
					$object_products[$i]['qr_code_creator_number'] = null;
					$object_products[$i]['qr_code_serial_number'] = null;
					$obj['qr_code_creator_number'] = null;
					$obj['qr_code_serial_number'] = null;
					$qr_code_creator_number = xarr($obj, 'qr_code_creator_number');
					$qr_code_serial_number = xarr($obj, 'qr_code_serial_number');
					
					if($qr_code_creator_number == null and $qr_code_serial_number == null)
					{
						foreach($products as $j => $product)
						{
							$product_tid = xarr($product, 'tid');
							$product_size_pkid = xarr($product, 'size_pkid');
							$product_color_pkid = xarr($product, 'color_pkid');
							$product_gender_pkid = xarr($product, 'gender_pkid');
							$product_qr_code_creator_number = xarr($product, 'qr_code_creator_number');
							$product_qr_code_serial_number = xarr($product, 'qr_code_serial_number');
							
							if($tid == $product_tid
							and $size_pkid == $product_size_pkid
							and $color_pkid == $product_color_pkid
							and $gender_pkid == $product_gender_pkid)
							{
								$object_products[$i]['qr_code_creator_number'] = $product_qr_code_creator_number;
								$object_products[$i]['qr_code_serial_number'] = $product_qr_code_serial_number;
								unset($products[$j]);
								$object_products[$i]['__qr_correct'] = true;
								break;
							}
						}
					}
				}
				
				if(count($products) > 0)
				{
					$result->error_code = EIO_USER - 11;
					$result->error_str = 'Вы добавили лишний товар'; 
					goto __exit;
				}
				
				$flag = false;
				foreach($object_products as $i => $obj)
				{
					$__qr_correct = xarr($obj, '__qr_correct', false);
					if($__qr_correct) continue;
					$flag = true;
					
					$tid = xarr($obj, 'tid');
					$size_pkid = xarr($obj, 'size_pkid');
					$color_pkid = xarr($obj, 'color_pkid');
					$gender_pkid = xarr($obj, 'gender_pkid');
					
					$findQRUID = $tid;
					
					break;
				}
				
				// остался один товар не отмеченный QR кодом
				if($flag)
				{
					$result->error_code = EIO_USER - 6;
					$result->error_str = 'Акцептуйте все товары';
					goto __exit;
				}
				
				// билдим $qr_uids
				foreach($object_products as $key => $obj)
				{
					$tid = xarr($obj, 'tid');
					$type = xarr($obj, 'qr_code_type');
					$size_pkid = xarr($obj, 'size_pkid');
					$color_pkid = xarr($obj, 'color_pkid');
					$gender_pkid = xarr($obj, 'gender_pkid');
					$qr_code_creator_number = xarr($obj, 'qr_code_creator_number');
					$qr_code_serial_number = xarr($obj, 'qr_code_serial_number');
