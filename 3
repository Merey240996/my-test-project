		// получение статистики продаж
		public static function doGetStat($result, $params)
		{
			$xfilter = xarr($params, 'filter');
			$filter = array();
			$nfilter = call_user_func_array(
				array(get_called_class(), 'event'), 
				array(
					'searchFilter',
					array(
						'object' => null,
						'form' => null,
						'params' => $params,
						'filter' => $xfilter,
						'do' => 0,
						'action' => 'actionNiceData',
					)
				)
			);
			if($nfilter === 0)
			{
				$result->error_code = EIO_UNKNOWN;
				return $result;
			}
			if(gettype($nfilter) == 'array') $filter = $nfilter;
			if(count($filter) == 1) if(count($filter[0]) > 0) $filter = array_shift($filter);
			
			$rinvoices = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => $filter,
					'out' => 'count',
				)
			);
			$invoices_count = xarr($rinvoices, 'count', 0);
			// продаж: 0
			$result->invoices_count = $invoices_count;
			
			$rinvoices_sum = IOCore::call(
				'app.class.invoices.dbMapReduce',
				array(
					'filter' => $filter,
					'map' => (
						'function(){'.
							'emit("total", this.amount_paid.value);'.
						'}'
					),
					'reduce' => (
						'function(key, vals){'.
							'return Array.sum(vals);'.
						'}'
					),
				)
			);
			$resinvoices_sum = array_shift($rinvoices_sum);
			$invoices_sum = xarr($resinvoices_sum, 'value', 0);
			
			// на сумму: 0.00 тг.
			$result->invoices_sum = $invoices_sum;
			
			// средний чек: 0.00 тг.
			$result->invoices_sredn_sum = ($invoices_sum > 0 and $invoices_count > 0) ?
				($invoices_sum / $invoices_count)
			: 0;
			
			$clients = IOCore::call(
				'app.class.invoices.dbDistinct',
				array(
					'filter' => array_merge($filter, array(
						'!=client_pkid' => array(null, ''),
					)),
					'field' => 'client_pkid',
				)
			);
			
			// клиентов: 0
			$result->clients_sum = count($clients);
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
