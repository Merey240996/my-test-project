		public static function event($event = '', $params = array())
		{
			global $ioData, $ioSession, $ioProjects;
			
			$action = xarr($params, 'action', array());
			$struct = xarr($params, 'struct', array());
			$object = xarr($params, 'object', array());
			$olddata = xarr($params, 'olddata', array());
			$form = xarr($params, 'form', array());
			$p = xarr($params, 'params', array());
			
			$company_pkid = xarr($params, 'company_pkid');
			if($company_pkid == null)
			{
				$company_pkid = xarr($p, 'company_pkid', $ioSession->user->getCompanyID());
			}
			
			if($event == 'init')
			{
				// Check if console
				$is_cli = (php_sapi_name() == 'cli');
				if($is_cli) return EIO_OK;
				
				if($ioSession->user->permission('bmc.trade2.access')
				and $ioSession->user->permission('bmc.trade2.invoice'))
				{
					if(in_array($action, array(
						//'actionShowNiceList',
						//'actionShowNiceFilter',
						//'actionShowNiceFilterField',
						'actionNiceData',
						//'actionGetFields',
						'actionShowEdit',
						'actionEdit',
						'actionEditDo',
						//'actionGetConsultantStat',
						
						'actionEditOrder',
						'actionEditSale',
						'actionEditReturn',
					)))
					{
						return EIO_OK;
					}
					
					if(in_array($action, array(
						'actionAdd',
						'actionAddDo',
						//'actionAddConsultant',
						//'actionEditConsultant',
						//'actionDelete',
						//'actionDeleteConsultant',
						//'actionDeleteDo',
						//'actionEditField',
						'actionShowAdd',
						//'actionShowDelete',
						
						'actionAddOrder',
						'actionAddSale',
						'actionAddReturn',
					)))
					{
						if($ioSession->user->permission('bmc.trade2.invoice.manage'))
						{
							return EIO_OK;
						}
					}
					
					if(in_array($action, array(
						'actionGetReport',
						'actionGetReportMore',
						'actionGetReportByCash',
						//'actionShowGetReportByCash',
					)))
					{
						//if($ioSession->user->permission('bmc.trade2.getReport'))
						//{
							return EIO_OK;
						//}
					}
				}
				if(!$ioSession->user->isGuest())
				{
					if(in_array($action, array(
						'actionNiceData',
						//'actionAddBuyer',
						'actionCancelUser',
						'actionSetDeliveryUser',
						'actionSetHide',
						'actionGetStat',
					)))
					{
						return EIO_OK;
					}
				}
				if(in_array($action, array(
					'actionCancel',
					'actionSetStatus3',
					'actionAddFromBasket',
					'actionAddPredZakaz',
					'actionAddTerminal',
					'actionEditTerminal',
					//'actionCancelTerminal',
					//'actionSetType',
					'actionSetStatus',
					'actionSetStatus2',
					'actionSetStatusAndAccept',
					'actionGetData',
					'actionGetDataMore',
					'actionGetPdfBill',
					'actionGetReceipt',
					'actionGetWaybill',
				)))
				{
					return EIO_OK;
				}
				return EIO_NOPERMISSIONS;
			}
			
			elseif($event == 'delete')
			{
				if(xarr($object, 'isPayed', false) or !in_array(xarr($object, 'status'), array(0, 1, 2, 3, 4, 5, 6, 7)))
				{
					$form->fields['raw-data']['raw-data'] = 'Вы не можете удалить инвойс, так как уже была оформлена продажа либо доставка';
					$form->formButtons = array(
						'close' => array(
							'label' => 'Закрыть',
							'event' => 'form_close',
							'type' => 'single',
							'style' => 'primary',
						),
					);
				}
				return EIO_OK;
			}
			
			elseif($event == 'delete_pre')
			{
				if(xarr($object, 'isPayed', false) or !in_array(xarr($object, 'status'), array(0, 1, 2, 3, 4, 5, 6, 7)))
				{
					$object->error_str = 'Вы не можете удалить инвойс, так как уже была оформлена продажа либо доставка';
					return EIO_UNKNOWN;
				}
				return EIO_OK;
			}
			
			elseif($event == 'searchFilter')
			{
				$params['xfilter'] = array(
					//'company_pkid' => $company_pkid,
					//'type' => 0,
					'isDeleted' => false,
				);
				$filter = parent::event($event, $params);
				return $filter;
			}
			
			elseif($event == 'getObjectFilter')
			{
				$params['xfilter'] = array(
					//'company_pkid' => $company_pkid,
					'isDeleted' => false,
				);
				$filter = parent::event($event, $params);
				//n_dump($filter);
				return $filter;
			}
			
			elseif($event == 'search_post')
			{
				$data = xarr($ioData, 'data2');
				$crm_clients_pkid = array();
				$user_clients_login = array();
				$company_clients_pkid = array();
				$moneypackets_pkid = array();
				
				foreach($data as $i => $row)
				{
					// получение pkid клиентов
					$client_pkid = xarr($row, 'client_pkid');
					// проверка начинается ли с crm_ ?
					if(strpos($client_pkid, 'crm_') === 0)
					{
						$client_pkid = substr($client_pkid, 4);
						$crm_clients_pkid[$client_pkid] = $client_pkid;
					}
					// проверка начинается ли с user_ ?
					elseif(strpos($client_pkid, 'user_') === 0)
					{
						$client_login = substr($client_pkid, 5);
						$user_clients_login[] = $client_login;
					}
					// проверка начинается ли с company_ ?
					elseif(strpos($client_pkid, 'company_') === 0)
					{
						$client_company_pkid = substr($client_pkid, 8);
						$company_clients_pkid[] = $client_company_pkid;
					}
					
					$moneypacket_pkid = xarr($row, 'moneyPacket_pkid');
					if(!in_array($moneypacket_pkid, $moneypackets_pkid))
					{
						$moneypackets_pkid[] = $moneypacket_pkid;
					}
				}
				
				$crm_clients_index = array();
				$crm_clients = array();
				if(count($crm_clients_pkid) > 0)
				{
					$res = IOCore::callAction(
						'bmc.crm.model.crm.crmClient.find',
						array(
							'filter' => array(
								'pkid' => array_values($crm_clients_pkid),
								'isDeleted' => false,
							),
							'limit' => count($crm_clients_pkid),
						)
					);
					//v_dump($res);
					$crm_clients = xarr($res, 'data', array());
					foreach($crm_clients as $key =>  $obj)
					{
						$crm_clients_index[$obj['pkid']] = $key;
					}
				}
				
				$user_clients = array();
				if(count($user_clients_login) > 0)
				{
					$user_clients = IOCore::call(
						'com.class.user.findByLogin',
						array(
							'login' => $user_clients_login,
						)
					);
				}
				
				$companyForms = array();
				$company_clients = array();
				if(count($company_clients_pkid) > 0)
				{
					$rcompanyForms = IOCore::call('com.class.company.companyForm.getForms', array());
					foreach($rcompanyForms as $cform)
					{
						$companyForms[xarr($cform, 'pkid')] = xarr($cform, 'title');
					}
					
					$company_clients = IOCore::call(
						'com.class.company.company.findCompanyByID',
						array(
							'id' => $company_clients_pkid,
						)
					);
				}
				
				//v_dump($crm_clients_index);
				
				//TODO: Здесь нужно получить список баз, чтобы писать в какой базе находится клиент
				// если несколько выводить все в дополнительной подсказке (или одну), нужно решить
				
				$moneypackets_groups_pkid = array();
				$moneypackets = array();
				if(count($moneypackets_pkid) > 0)
				{
					// получение счетов
					$rmoneypackets = IOCore::call(
						'upi.class.moneyPackets.dbsearch2',
						array(
							'filter' => array(
								'pkid' => $moneypackets_pkid,
							),
							'limit' => count($moneypackets_pkid),
							'out' => 'array',
						)
					);
					$t_moneypackets = xarr($rmoneypackets, 'res', array());
					foreach($t_moneypackets as $packet)
					{
						$packet_pkid = xarr($packet, 'pkid');
						$moneypackets[$packet_pkid] = $packet;
						
						$packet_group_pkid = xarr($packet, 'group_pkid');
						if(!in_array($packet_group_pkid, $moneypackets_groups_pkid))
						{
							$moneypackets_groups_pkid[] = $packet_group_pkid;
						}
					}
				}
				$moneypackets_groups = array();
				if(count($moneypackets_groups_pkid) > 0)
				{
					// получение групп счетов
					$rmoneypackets_groups = IOCore::call(
						'upi.class.moneyPacketsGroups.dbsearch2',
						array(
							'filter' => array(
								'pkid' => $moneypackets_groups_pkid,
							),
							'limit' => count($moneypackets_groups_pkid),
							'out' => 'array',
						)
					);
					$t_moneypackets_groups = xarr($rmoneypackets_groups, 'res', array());
					foreach($t_moneypackets_groups as $packetgroup)
					{
						$packetgroup_pkid = xarr($packetgroup, 'pkid');
						$moneypackets_groups[$packetgroup_pkid] = $packetgroup;
					}
				}
				
				foreach($data as $i => $row)
				{
					$client_pkid = xarr($row, 'client_pkid');
					
					// проверка начинается ли с crm_ ?
					if(strpos($client_pkid, 'crm_') === 0)
					{
						//$crm_clients_pkid = substr($client_pkid, 4);
						$client_pkid = substr($client_pkid, 4);
