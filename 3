		public static function doGetReportByCash($result, $params)
		{
			global $ioSession;
			
			$date_ot = xarr($params, 'date_ot', '0000-00-00');
			$date_do = xarr($params, 'date_do', '0000-00-00');
			$date_begin = iostrtotimestamp($date_ot.' 00:00:00', null, $ioSession->user->timezone);
			$date_end = iostrtotimestamp($date_do.' 23:59:59', null, $ioSession->user->timezone);
			
			$result->data = IOCore::call(
				'app.class.invoices.dbGroupBy',
				array(
					'filter' => array(
						'company_pkid' => $ioSession->user->getCompanyID(),
						'$or' => array(
							array(
								'type' => 0, // продажа
								'isPayed' => true,
								'$and' => array(
									array('>=dateSale' => $date_begin),
									array('<=dateSale' => $date_end),
								),
							),
							array(
								'type' => 1, // возврат
								'isPayed' => true,
								'$and' => array(
									array('>=dateSale' => $date_begin), //dateDelivery
									array('<=dateSale' => $date_end), //dateDelivery
								),
							),
						),
						'isDeleted' => false,
					),
					'groupBy' => array(
						'warehouse_pkid',
						'cashier_login',
					),
					'reduce' => (
						'function (obj, prev){'.
							'prev.count += 1;'.
							'if(obj.status == 102){'.
								'prev.return_product_count += obj.products_count;'.
								'prev.return_count += 1;'.
								'if((typeof obj.amount_paid) != "undefined" && obj.amount_paid != null) prev.return_amount_paid.push(obj.amount_paid);'.
								'if((typeof obj.amount_cash) != "undefined" && obj.amount_cash != null) prev.return_amount_cash.push(obj.amount_cash);'.
								'prev.return_number.push(obj.invoice_number);'.
							'} else {'.
								'prev.sale_product_count += obj.products_count;'.
								'prev.sale_count += 1;'.
								'if((typeof obj.amount_paid) != "undefined" && obj.amount_paid != null) prev.sale_amount_paid.push(obj.amount_paid);'.
								'if((typeof obj.amount_cash) != "undefined" && obj.amount_cash != null) prev.sale_amount_cash.push(obj.amount_cash);'.
								'prev.sale_number.push(obj.invoice_number);'.
							'}'.
						'}'
					),
					'initial' => array(
						'return_product_count' => 0,
						'return_amount_paid' => array(),
						'return_amount_cash' => array(),
						'return_number' => array(),
						'sale_product_count' => 0,
						'sale_amount_paid' => array(),
						'sale_amount_cash' => array(),
						'sale_number' => array(),
						'sale_count' => 0,
						'return_count' => 0,
						'count' => 0,
					),
				)
			);
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
