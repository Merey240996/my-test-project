			}
			if($referer_login != null and $referer_login != '')
			{
				$c->referer_login = $referer_login;
			}
			$c->status = $status;
			$c->delivery_info = $delivery_info;
			$c->delivery_time = $delivery_time;
			$c->delivery_method = $delivery_method;
			$c->tracknumber = $tracknumber;
			
