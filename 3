					$ci_email = xarr($companyinfo, 'email');
					$ci_tel = xarr($companyinfo, 'phone');
					$ci_form = xarr($companyinfo, 'form_pkid');
					$ci_form_name = xarr($companyForms, $ci_form);
					
					$comment .= 'Компания: '.($ci_form ? $ci_form_name.' "'.$ci_name.'"' : $ci_name).' (email: '.($ci_email ? $ci_email : '-').', тел.: '.($ci_tel ? $ci_tel : '-').')'."\n";
				}
				$comment .= 'ФИО: '.$user_sname.' '.$user_fname.' '.$user_lname."\n";
				$comment .= 'Логин: '.$user_login."\n";
				$comment .= 'Тел: '.$user_tel."\n";
				$comment .= 'Email: '.$user_email;
				
				if($deliveryaddress_pkid == null
				or $deliveryaddress_pkid == '')
				{
					if($deliveryaddress_country != ''
					and $deliveryaddress_city != ''
					and $deliveryaddress_address != ''
					and $deliveryaddress_zipcode != '')
					{
						$rda = IOCore::callAction(
							'com.model.userDeliveryAddresses.add2',
							array(
								'user_pkid' => $user_id,
								'user_login' => $user_login,
								'country' => $deliveryaddress_country,
								'city' => $deliveryaddress_city,
								'address' => $deliveryaddress_address,
								'zipcode' => $deliveryaddress_zipcode,
							)
						);
						$resda = xarr($rda, 'res', array());
						$deliveryaddress_pkid = xarr($resda, 'pkid');
					}
				}
				if($deliveryaddress_pkid)
				{
					$rda = IOCore::call(
						'com.class.userDeliveryAddresses.dbsearch2',
						array(
							'filter' => array(
								'pkid' => $deliveryaddress_pkid,
								'isDeleted' => false,
							),
							'limit' => 1,
							'out' => 'array',
						)
					);
					$resda = xarr($rda, 'res', array());
					$deliveryaddress = array_shift($resda);
					
					$deliveryaddress_country = xarr($deliveryaddress, 'country');
					$deliveryaddress_city = xarr($deliveryaddress, 'city');
					$deliveryaddress_address = xarr($deliveryaddress, 'address');
					$deliveryaddress_zipcode = xarr($deliveryaddress, 'zipcode');
					
					$comment .= "\n\n";
					$comment .= 'Адрес доставки:'."\n";
					$comment .= 'Страна: '.$deliveryaddress_country."\n";
					$comment .= 'Город: '.$deliveryaddress_city."\n";
					$comment .= 'Адрес: '.$deliveryaddress_address."\n";
					$comment .= 'Индекс: '.$deliveryaddress_zipcode;
				}
				
				$offers_numbers = array();
				$delivery_methods = array();
				foreach($resob as $el)
				{
					// собираем pkid'ы предложений
					$offer_number = xarr($el, 'offer_number');
					if(!in_array($offer_number, $offers_numbers))
					{
						$offers_numbers[] = $offer_number;
					}
					
					// собираем pkid'ы методов доставки
					$delivery_method = xarr($el, 'delivery_method');
					if($delivery_method != 0 and !in_array($delivery_method, $delivery_methods))
					{
						$delivery_methods[] = $delivery_method;
					}
				}
				
				// получаем предложения
				$roffers = IOCore::call(
					'app.class.offersMany.dbsearch2',
					array(
						'filter' => array(
							'offer_number' => $offers_numbers,
							'isDeleted' => false,
						),
						'limit' => count($offers_numbers),
						'out' => 'array',
					)
				);
				$resoffers = xarr($roffers, 'res', array());
				$companies = array();
				
				// получаем методы доставки
				$rdeliverymethods = IOCore::call(
					'app.class.deliveryMethods.dbsearch2',
					array(
						'filter' => array(
							'pkid' => $delivery_methods,
							'isDeleted' => false,
						),
						'limit' => count($delivery_methods),
						'out' => 'array',
					)
				);
				$resdeliverymethods = xarr($rdeliverymethods, 'res', array());
				$deliverymethods = array();
				foreach($resdeliverymethods as $deliverymethod)
				{
					$deliverymethod_pkid = xarr($deliverymethod, 'pkid');
					if(!in_array($deliverymethod_pkid, $deliverymethods))
					{
						$deliverymethods[$deliverymethod_pkid] = $deliverymethod;
					}
				}
				
				$offers = array();
				foreach($resob as $ob)
				{
					$offer_number = xarr($ob, 'offer_number');
					$referer_login = xarr($ob, 'referer_login');
					$company_pkid = xarr($ob, 'company_pkid');
					$delivery_method = xarr($ob, 'delivery_method');
					
					if($referer_login == '') $referer_login = null;
					
					$offer = array();
					foreach($resoffers as $offeritem)
					{
						$offeritem_offer_number = xarr($offeritem, 'offer_number');
						if($offeritem_offer_number == $offer_number)
						{
							$offer = $offeritem;
							$offer['tmp_pkid'] = xarr($ob, 'tmp_pkid');
							$offer['offerbasket_pkid'] = xarr($ob, 'pkid');
							$offer['referer_login'] = $referer_login;
							$offer['count'] = xarr($ob, 'count', 1);
							$offer['color_pkid'] = xarr($ob, 'color_pkid');
							$offer['size_pkid'] = xarr($ob, 'size_pkid');
							$offer['gender_pkid'] = xarr($ob, 'gender_pkid');
							$offer['delivery_method'] = xarr($ob, 'delivery_method');
							$offer['delivery_warehouse_pkid'] = xarr($ob, 'delivery_warehouse_pkid');
							break;
						}
					}
					if($offer)
					{
						$offer_parameters = xarr($offer, 'offer_parameters', array());
						$offer['offer_sel_parameter'] = array();
						foreach($offer_parameters as $offer_parameter)
						{
							$offer_parameter_color_pkid = xarr($offer_parameter, 'color_pkid');
							$offer_parameter_size_pkid = xarr($offer_parameter, 'size_pkid');
							$offer_parameter_gender_pkid = xarr($offer_parameter, 'gender_pkid');
							if($offer_parameter_color_pkid == xarr($offer, 'color_pkid')
							and $offer_parameter_size_pkid == xarr($offer, 'size_pkid')
							and $offer_parameter_gender_pkid == xarr($offer, 'gender_pkid'))
							{
								$offer_parameter_count = xarr($offer_parameter, 'count', 0);
								if($offer_parameter_count > 0)
								{
									$offer['offer_sel_parameter'] = $offer_parameter;
								}
								break;
							}
						}
						
						$offers[$company_pkid][] = $offer;
						if(!in_array($company_pkid, $companies))
						{
							$companies[] = $company_pkid;
						}
					}
				}
				
				// сортировка инвойсов по компаниям
				foreach($companies as $company_pkid)
				{
					$company_delivery_methods = array();
					$company_delivery_methods_offers = array();
					
					$company_offers = xarr($offers, $company_pkid, array());
					foreach($company_offers as $offer)
					{
						$o_delivery_method = xarr($offer, 'delivery_method');
						$company_delivery_methods_offers[$o_delivery_method][] = $offer;
						if($o_delivery_method != null and !in_array($o_delivery_method, $company_delivery_methods))
						{
							$company_delivery_methods[] = $o_delivery_method;
						}
					}
					
					// Для каждого метода доставки создаем отдельный инвойс (или несколько, если разные склады)
					foreach($company_delivery_methods as $o_delivery_method)
					{
						$company_warehouses_pkids = array();
						$company_warehouses_offers = array();
						
						$company_delivery_method_offers = xarr($company_delivery_methods_offers, $o_delivery_method, array());
						foreach($company_delivery_method_offers as $offer)
						{
							$warehouse_pkid = xarr($offer, 'delivery_warehouse_pkid');
							$company_warehouses_offers[$warehouse_pkid][] = $offer;
							if($warehouse_pkid != null and !in_array($warehouse_pkid, $company_warehouses_pkids))
							{
								$company_warehouses_pkids[] = $warehouse_pkid;
							}
						}
						
						// Для каждого склада с этим методом доставки создаем отдельный инвойс
						foreach($company_warehouses_pkids as $warehouse_pkid)
						{
							$amount = 0;
							$amount_delivery = 0;
							$products = array();
							
							// Собираем все товары для этого склада
							$company_warehouse_offers = xarr($company_warehouses_offers, $warehouse_pkid, array());
							
							// Группируем товары по методу доставки и считаем суммарные показатели
							// (все товары в этой группе уже имеют одинаковый метод доставки, так как мы внутри цикла по $o_delivery_method)
							$total_count = 0;
							$total_weight = 0;
							$deliverymethod = null;
							
							// Сначала проходим по всем товарам, чтобы собрать данные для расчета доставки
							foreach($company_warehouse_offers as $offer)
							{
								$offer_count = intval(xarr($offer, 'count', 1));
								$offer_weight = floatval(xarr($offer, 'weight', 0));
								
								$total_count += $offer_count;
								$total_weight += $offer_weight * $offer_count;
								
								if($deliverymethod === null)
								{
									$deliverymethod = xarr($deliverymethods, xarr($offer, 'delivery_method'));
								}
							}
							
							// Теперь рассчитываем доставку для ВСЕХ товаров в этом инвойсе
							$deliverymethod_type = xarr($deliverymethod, 'type', 0);
							$deliverymethod_method = xarr($deliverymethod, 'method', 'fixed');
							
							if($deliverymethod_type != 0)
							{
								$deliverymethod_step = floatval(xarr($deliverymethod, 'step', 1));
								$deliverymethod_amount = xarr($deliverymethod, 'amount_value', 0);
								
								if($deliverymethod_method == 'fixed')
								{
									$amount_delivery = $deliverymethod_amount;
								}
								elseif($deliverymethod_method == 'fixedgoodscount')
								{
									// Всегда добавляем базовую стоимость за первый шаг
									$amount_delivery += $deliverymethod_amount;
									$total_count -= $deliverymethod_step;
									
									// Добавляем за дополнительные шаги
									while($total_count > 0)
									{
										$total_count -= $deliverymethod_step;
										$amount_delivery += $deliverymethod_amount;
									}
								}
								elseif($deliverymethod_method == 'fixedweight')
								{
									// Всегда добавляем базовую стоимость за первый шаг
									$amount_delivery += $deliverymethod_amount;
									$total_weight -= $deliverymethod_step;
									
									// Добавляем за дополнительные шаги
									while($total_weight > 0)
									{
										$total_weight -= $deliverymethod_step;
										$amount_delivery += $deliverymethod_amount;
									}
								}
							}
							
							// Теперь формируем товары для инвойса
							foreach($company_warehouse_offers as $offer)
							{
								$referer_login = xarr($offer, 'referer_login');
								if($referer_login == '') $referer_login = null;
								
								$offer_count = intval(xarr($offer, 'count', 1));
								$offer_weight = floatval(xarr($offer, 'weight', 0));
								$offer_discount = intval(xarr($offer, 'offer_discount', 0));
								$offer_site_discount = intval(xarr($offer, 'offer_site_discount', 0));
								$offer_broker_interes = intval(xarr($offer, 'offer_broker_interes', 0));
								$offer_amount_first = xarrj($offer, 'offer_sel_parameter.cost_per_unit');
								$offer_amount = floatval(xarr($offer_amount_first, 'value', 0));
								$offer_discount2 = 0;
								
								if($offer_discount > 0 or $offer_site_discount > 0 or ($referer_login and $offer_broker_interes > 0))
								{
									$offer_discounts = array($offer_discount, $offer_site_discount);
									if($referer_login)
									{
										$offer_discounts[] = $offer_broker_interes;
									}
									$offer_discount2 = max($offer_discounts);
									$offer_amount -= ($offer_amount / 100) * max($offer_discounts);
								}
								
								$offer_amount = ceil($offer_amount);
								$offer_amount *= $offer_count;
								$amount += $offer_amount;
								
								for($i = 0; $i < $offer_count; $i++)
								{
									$products[] = array(
										'tid' => xarr($offer, 'tid'), // акцептованнный ИНТ товара
										'offer_name' => xarr($offer, 'offer_name', xarrj($offer, 'goods_name.ru', '')),
										'offer_number' => xarr($offer, 'offer_number'),
										'size_pkid' => xarr($offer, 'size_pkid'),
										'color_pkid' => xarr($offer, 'color_pkid'),
										'gender_pkid' => xarr($offer, 'gender_pkid'),
										'weight' => $offer_weight,
										'amount' => $offer_amount_first, // цена за единицу (без скидок)
										
										'discount' => $offer_discount2, // скидка в процентах
										'isSaleWithoutQr' => xarr($offer, 'isSaleWithoutQr'), // разрешена ли продажа без QR кодов?
										'isDelivered' => false, // был ли получен товар клиентом?
										'isDeleted' => false, // был ли возврат товара?
										
										// если не null то товары были акцептованы
										'qr_code_creator_number' => null, // создатель QR кода (номер)
										'qr_code_serial_number' => null, // серийный номер продукта
										'qr_code_type' => null, // серийный номер продукта
										
										// значения устанавливаются в момент продажи
										//'qr_code_count_si' => 1, // количество товара в СИ
										//'qr_code_si' => 1, // ед. измерения
									);
								}
							}
							
							// Создаем инвойс для этого метода доставки и склада
							$c = IOCore::Instance('app.class.invoices');
							$c->assign_arr(
								array(
									'company_pkid' => $company_pkid,
									'client_phone' => $user_tel,
									'creator_pkid' => $user_id,
									'creator_login' => $user_login,
									//'referer_pkid' => $referer_pkid,
									'referer_login' => $referer_login,
									'products' => $products,
									
									// клиент user_<login> - логин пользователя; company_<pkid> - pkid компании; crm_<pkid> - pkid записи из CRM; text_<ФИО> - незарегистрированный пользователь;
									'client_pkid' => $user_company_pkid ? 'company_'.$user_company_pkid : 'user_'.$user_login,
									
									// тип инвойса (ioEnum.invoices_types)
									'type' => 0, // продажа
									
									// статус инвойса
									'status' => 0, // 0: cоздан,
									
									// массив из акцептованных ИНТ товаров
									'products_tids' => [],
									
									// количество продуктов
									'products_count' => count($products),
									
									// общая сумма товаров, которая вычисляется по предложениям
									'amount' => array(
										'value' => $amount,
										'currency' => 'KZT',
										'pay_type' => $payment_method,
									),
									
									'delivery_method' => $o_delivery_method,
									'warehouse_pkid' => $warehouse_pkid,
									
									// информация о доставке
									'delivery_info' => $comment,
									
									// стоимость доставки
									'amount_delivery' => array(
										'value' => $amount_delivery,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									
									// сумма за которую были куплены товары
									'amount_paid' => array(
										'value' => $amount + $amount_delivery,
										'currency' =>  'KZT',
										'pay_type' => 0,
									),
									// сумма наличных
									'amount_cash' => array(
										'value' => 0,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									// сумма скидки
									'discount' => array(
										'value' => 0,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									// сумма аванса
									/*'prepayment' => array(
										'value' => 0,
										'currency' => 'KZT',
										'pay_type' => 0,
									),*/
									
									// дата продажи
									//'dateSale' => iogetdbtimeutc_rfc822(time()),
								)
							);
							$c->create();
							$invoices_pkids[] = xarr($c, 'pkid');
							
							if(xarr($c, 'error_code', EIO_FALSE) != EIO_OK)
							{
								$result->error_code = xarr($c, 'error_code', EIO_FALSE);
								$result->error_str = xarr($c, 'error_str', '');
								goto __exit;
							}
							
							// уведомление сотрудников по телеграму
							$rnusers = IOCore::call(
								'app.class.noticeUsers.dbsearch2',
								array(
									'filter' => array(
										'company_pkid' => $company_pkid,
										'isDeleted' => false,
									),
									'limit' => 1000,
									'out' => 'array',
								)
							);
							$nusers = xarr($rnusers, 'res', array());
							$nusers_user_pkid = array();
							foreach($nusers as $nuser)
							{
								if(!in_array(xarr($nuser, 'user_pkid'), $nusers_user_pkid))
								{
									$nusers_user_pkid[] = xarr($nuser, 'user_pkid');
								}
								$sendTelegram = IOCore::callAction(
									'telegram.model.kdtappbot.sendTextByID',
									array(
										'id' => xarr($nuser, 'user_pkid'),
										'message' => array(
											'Уважаемый сотрудник отдела продаж BMC Trade!'."\n\n".
											'Поступил новый интернет-заказ № "'.xarr($c, 'invoice_number', '???').'".'."\n".
											'Просьба, обработать заказ как можно скорее.'."\n".
											'https:'.xarr($ioProjects, 'trade').'/cabinet/invoices'."\n\n".
											'Спасибо.',
										),
									)
								);
							}
							$sendNotice = IOCore::callAction(
								'com.notice.model.notices.add',
								array(
									'service' => 'trade',
									'module_name' => 'bmc.trade2.model.invoices2',
									'method' => 'actionAddFromBasket',
									'type' => 0, // тип уведомления (0: по умолчанию, 1: информация, 2: предупреждение, 3: ошибка)
									'cat' => 0, // 0=bell, 1=billhorn, 2=coin1, 3=coin2, 4=webinar, 5=webinar2
									'link' => 'http:'.xarr($ioProjects, 'trade').'/cabinet/invoices',
									'title' => 'Поступил интернет-заказ',
									'message_lk' => 'Поступил новый интернет-заказ № "'.xarr($c, 'invoice_number', '???').'". Просьба, обработать заказ как можно скорее.',
									'message_email' => 'Поступил новый интернет-заказ № "'.xarr($c, 'invoice_number', '???').'".<br/>Просьба, обработать заказ как можно скорее.',
									//'message_sms' => '',
									'sendMethods' => array(1), // дополнительные методы отправки уведомления (1=email, 2=sms)
									//'rules' => 'org.eopkz.webinars.accept',
									//'sender' => $ioSession->user->id,
									'users_pkid' => $nusers_user_pkid,
									//'company_pkid' => $ioSession->user->getCompanyID(),
									'gmtimeEvent' => iogetdbtimeutc_rfc822(time()),
									'gmtimeShow' => iogetdbtimeutc_rfc822(time()),
								)
							);
						}
					}
				}
				foreach($resob as $ob)
				{
					$offer_number = xarr($ob, 'offer_number');
					$company_pkid = xarr($ob, 'company_pkid');
					
					// увеличиваем количество заказов (покупок) предложений
					$roffer = IOCore::call(
						'app.class.offers.dbsearch2',
						array(
							'filter' => array(
								'company_pkid' => $company_pkid,
								'offer_number' => $offer_number,
								'isDeleted' => false,
							),
							'limit' => 1,
						)
					);
					$resoffer = xarr($roffer, 'res', array());
					$offerobj = array_shift($resoffer);
					if($offerobj != null)
					{
						$offerobj->orders++;
						$offerobj->update();
					}
				}
				if(!$user_reg)
				{
					// удаление заказанных товаров из корзины
					$rob = IOCore::call(
						'app.class.offersBasket.dbsearch2',
						array(
							'filter' => array(
								'user_pkid' => $user_id,
								'pkid' => $offerBasket_pkids,
								'isDeleted' => false,
							),
							'limit' => count($offerBasket_pkids),
						)
					);
					$resob = xarr($rob, 'res', array());
					foreach($resob as $obj)
					{
						$obj->delete();
						
						if(xarr($obj, 'error_code', EIO_FALSE) != EIO_OK)
						{
							$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
							$result->error_str = xarr($obj, 'error_str', '');
							goto __exit;
						}
					}
				}
			}
			
			$result->pkids = $invoices_pkids;
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
		// создание инвойса "заказа" через спец. страницы предзаказов
		public static function doAddPredZakaz($result, $params)
		{
			global $ioSession, $ioProjects, $ioHash;
			
			$resob = xarr($params, 'products', array());
			
			$deliveryaddress_pkid = xarr($params, 'deliveryaddress_pkid');
			$deliveryaddress_country = xarr($params, 'deliveryaddress_country', '');
			$deliveryaddress_city = xarr($params, 'deliveryaddress_city', '');
			$deliveryaddress_address = xarr($params, 'deliveryaddress_address', '');
			$deliveryaddress_zipcode = xarr($params, 'deliveryaddress_zipcode', '');
			$comment = xarr($params, 'comment', '');
			
			$invoices_pkids = array();
			
			$user_login = $ioSession->user->login;
			$user_id = $ioSession->user->id;
			$user_sname = xarr($ioSession->user->info, 'sname');
			$user_fname = xarr($ioSession->user->info, 'fname');
			$user_lname = xarr($ioSession->user->info, 'lname');
			$user_tel = xarr($ioSession->user->info, 'tel');
			$user_email = xarr($ioSession->user->info, 'email');
			$user_reg = false;
			
			if(gettype($resob) == 'array' and count($resob) > 0)
			{
				if($ioSession->user->isGuest())
				{
					$user_reg = true;
					
					$site = array();
					$site_pkid = xarr($params, 'site_pkid');
					$captcha = xarr($params, 'captcha', '');
					if($captcha)
					{
						$captcha_keystring = $ioHash->get('captcha_keystring.'.$ioSession->session);
						
						if($captcha != $captcha_keystring)
						{
							$result->error_code = EIO_USER - 20;
							$result->error_str = 'Неверно указан код с картинки';
							goto __exit;
						}
					}
					else
					{
						if($site_pkid)
						{
							$rsite = IOCore::call(
								'io.class.cms20.site.dbsearch2',
								array(
									'filter' => array(
										'pkid' => $site_pkid,
									),
									'limit' => 1,
									'out' => 'array',
								)
							);
							$ressite = xarr($rsite, 'res', array());
							$site = array_shift($ressite);
						}
						$site_enableGoogleRecaptcha = xarr($site, 'enableGoogleRecaptcha', false);
						if($site_enableGoogleRecaptcha)
						{
							$site_googleRecaptchaPrivateKey = xarr($site, 'googleRecaptchaPrivateKey');
							$response = xarr($params, 'g-recaptcha-response');
							
							// запрос к гуглу для проверки капчи
							$query = http_build_query(array(
								'secret' => $site_googleRecaptchaPrivateKey,
								'response' => $response,
							));
							$context  = stream_context_create(array(
								'http' => array(
									'method' => 'POST',
									'header' => "Content-Type: application/x-www-form-urlencoded\r\n".
												"Content-Length: ".strlen($query)."\r\n".
												"User-Agent:MyAgent/1.0\r\n",
									'content' => $query,
								)
							));
							$verify = file_get_contents('https://www.google.com/recaptcha/api/siteverify', false, $context);
							$captcha_success = json_decode($verify);
							if(!$captcha_success->success)
							{
								$result->error_code = EIO_USER - 20;
								$result->error_str = 'Проверка на капчу не пройдена';
								goto __exit;
							}
						}
						else
						{
							$result->error_code = EIO_USER - 20;
							$result->error_str = 'Проверка на капчу не пройдена';
							goto __exit;
						}
					}
					
					$user_sname = xarr($params, 'user_sname');
					$user_fname = xarr($params, 'user_fname');
					$user_lname = xarr($params, 'user_lname');
					$user_tel = xarr($params, 'user_tel');
					$user_email = xarr($params, 'user_email');
					
					if($user_sname == null or $user_sname == '')
					{
						$result->error_code = EIO_USER - 1;
						$result->error_str = 'Не указана фамилия';
						goto __exit;
					}
					if($user_fname == null or $user_fname == '')
					{
						$result->error_code = EIO_USER - 2;
						$result->error_str = 'Не указано имя';
						goto __exit;
					}
					if($user_tel == null or $user_tel == '')
					{
						$result->error_code = EIO_USER - 4;
						$result->error_str = 'Не указано номер телефона';
						goto __exit;
					}
					if($user_email == null or $user_email == '')
					{
						$result->error_code = EIO_USER - 3;
						$result->error_str = 'Не указано email';
						goto __exit;
					}
					
					$user_tel = preg_replace("/\D/", '', $user_tel); //"/[^\d;]/g" ??? maybe
					$user_tel = substr_replace($user_tel, 7, 0, 1);
					
					$user_login = strtolower(str_replace(' ', '', translit($user_sname).'_'.translit($user_fname)[0]));
					$suser = IOCore::call(
						'com.class.user.findByLogin',
						array(
							'login' => $user_login,
						)
					);
					$suser = xarr($suser, $user_login);
					$cnt_user_login_postfix = 0;
					$user_login_t = $user_login;
					while($suser != null)
					{
						$cnt_user_login_postfix++;
						$user_login = $user_login.'_'.$cnt_user_login_postfix;
						$suser = IOCore::call(
							'com.class.user.findByLogin',
							array(
								'login' => $user_login,
							)
						);
						$suser = xarr($suser, $user_login);
					}
					
					// регистрация пользователя
					$r = IOCore::callAction(
						'com.model.user.regUserForProfile',
						array(
							'sname' => $user_sname,
							'fname' => $user_fname,
							'lname' => $user_lname,
							'email' => $user_email,
							'tel' => $user_tel,
							'login' => $user_login,
						)
					);
					if(xarr($r, 'error_code', EIO_FALSE) != EIO_OK)
					{
						$result->error_code = xarr($r, 'error_code', EIO_FALSE);
						$result->error_str = xarr($r, 'error_str', '');
						goto __exit;
					}
					$result->jwt_string = xarr($r, 'jwt_string', '0');
					
					$user_login = xarr($r, 'user_login', $user_login);
					$user_id = xarr($r, 'user_id');
				}
				
				if($comment) $comment .= "\n\n";
				$comment .= 'Клиент:'."\n";
				$comment .= 'ФИО: '.$user_sname.' '.$user_fname.' '.$user_lname."\n";
				$comment .= 'Логин: '.$user_login."\n";
				$comment .= 'Тел: '.$user_tel."\n";
				$comment .= 'Email: '.$user_email;
				
				if($deliveryaddress_pkid == null
				or $deliveryaddress_pkid == '')
				{
					if($deliveryaddress_country != ''
					and $deliveryaddress_city != ''
					and $deliveryaddress_address != ''
					and $deliveryaddress_zipcode != '')
					{
						$rda = IOCore::callAction(
							'com.model.userDeliveryAddresses.add2',
							array(
								'user_pkid' => $user_id,
								'user_login' => $user_login,
								'country' => $deliveryaddress_country,
								'city' => $deliveryaddress_city,
								'address' => $deliveryaddress_address,
								'zipcode' => $deliveryaddress_zipcode,
							)
						);
						$resda = xarr($rda, 'res', array());
						$deliveryaddress_pkid = xarr($resda, 'pkid');
					}
				}
				if($deliveryaddress_pkid)
				{
					$rda = IOCore::call(
						'com.class.userDeliveryAddresses.dbsearch2',
						array(
							'filter' => array(
								'pkid' => $deliveryaddress_pkid,
								'isDeleted' => false,
							),
							'limit' => 1,
							'out' => 'array',
						)
					);
					$resda = xarr($rda, 'res', array());
					$deliveryaddress = array_shift($resda);
					
					$deliveryaddress_country = xarr($deliveryaddress, 'country');
					$deliveryaddress_city = xarr($deliveryaddress, 'city');
					$deliveryaddress_address = xarr($deliveryaddress, 'address');
					$deliveryaddress_zipcode = xarr($deliveryaddress, 'zipcode');
					
					$comment .= "\n\n";
					$comment .= 'Адрес доставки:'."\n";
					$comment .= 'Страна: '.$deliveryaddress_country."\n";
					$comment .= 'Город: '.$deliveryaddress_city."\n";
					$comment .= 'Адрес: '.$deliveryaddress_address."\n";
					$comment .= 'Индекс: '.$deliveryaddress_zipcode;
				}
				
				$offers_numbers = array();
				$delivery_methods = array();
				foreach($resob as $el)
				{
					// собираем pkid'ы предложений
					$offer_number = xarr($el, 'offer_number');
					if(!in_array($offer_number, $offers_numbers))
					{
						$offers_numbers[] = $offer_number;
					}
					
					// собираем pkid'ы методов доставки
					$delivery_method = xarr($el, 'delivery_method');
					if($delivery_method != 0 and !in_array($delivery_method, $delivery_methods))
					{
						$delivery_methods[] = $delivery_method;
					}
				}
				
				// получаем предложения
				$roffers = IOCore::call(
					'app.class.offersMany.dbsearch2',
					array(
						'filter' => array(
							'offer_number' => $offers_numbers,
							'isDeleted' => false,
						),
						'limit' => count($offers_numbers),
						'out' => 'array',
					)
				);
				$resoffers = xarr($roffers, 'res', array());
				$companies = array();
				
				// получаем методы доставки
				$rdeliverymethods = IOCore::call(
					'app.class.deliveryMethods.dbsearch2',
					array(
						'filter' => array(
							'pkid' => $delivery_methods,
							'isDeleted' => false,
						),
						'limit' => count($delivery_methods),
						'out' => 'array',
					)
				);
				$resdeliverymethods = xarr($rdeliverymethods, 'res', array());
				$deliverymethods = array();
				foreach($resdeliverymethods as $deliverymethod)
				{
					$deliverymethod_pkid = xarr($deliverymethod, 'pkid');
					if(!in_array($deliverymethod_pkid, $deliverymethods))
					{
						$deliverymethods[$deliverymethod_pkid] = $deliverymethod;
					}
				}
				
				$offers = array();
				foreach($resob as $ob)
				{
					$offer_number = xarr($ob, 'offer_number');
					$company_pkid = xarr($ob, 'company_pkid');
					$referer_login = xarr($ob, 'referer_login');
					$delivery_method = xarr($ob, 'delivery_method');
					
					if($referer_login == '') $referer_login = null;
					
					$offer = array();
					foreach($resoffers as $offeritem)
					{
						$offeritem_offer_number = xarr($offeritem, 'offer_number');
						if($offeritem_offer_number == $offer_number)
						{
							$offer = $offeritem;
							$offer['count'] = xarr($ob, 'count', 1);
							$offer['referer_login'] = $referer_login;
							$offer['color_pkid'] = xarr($ob, 'color_pkid');
							$offer['size_pkid'] = xarr($ob, 'size_pkid');
							$offer['gender_pkid'] = xarr($ob, 'gender_pkid');
							$offer['delivery_method'] = xarr($ob, 'delivery_method');
							$offer['delivery_warehouse_pkid'] = xarr($ob, 'delivery_warehouse_pkid');
							break;
						}
					}
					if($offer)
					{
						$offer_parameters = xarr($offer, 'offer_parameters', array());
						$offer['offer_sel_parameter'] = array();
						foreach($offer_parameters as $offer_parameter)
						{
							$offer_parameter_color_pkid = xarr($offer_parameter, 'color_pkid');
							$offer_parameter_size_pkid = xarr($offer_parameter, 'size_pkid');
							$offer_parameter_gender_pkid = xarr($offer_parameter, 'gender_pkid');
							if($offer_parameter_color_pkid == xarr($offer, 'color_pkid')
							and $offer_parameter_size_pkid == xarr($offer, 'size_pkid')
							and $offer_parameter_gender_pkid == xarr($offer, 'gender_pkid'))
							{
								$offer_parameter_count = xarr($offer_parameter, 'count', 0);
								//if($offer_parameter_count > 0)
								//{
									$offer['offer_sel_parameter'] = $offer_parameter;
								//}
								break;
							}
						}
						
						$offers[$company_pkid][] = $offer;
						if(!in_array($company_pkid, $companies))
						{
							$companies[] = $company_pkid;
						}
					}
				}
				
				// сортировка инвойсов по компаниям
				foreach($companies as $company_pkid)
				{
					$company_delivery_methods = array();
					$company_delivery_methods_offers = array();
					
					$company_offers = xarr($offers, $company_pkid, array());
					foreach($company_offers as $offer)
					{
						$o_delivery_method = xarr($offer, 'delivery_method');
						$company_delivery_methods_offers[$o_delivery_method][] = $offer;
						if($o_delivery_method != null and !in_array($o_delivery_method, $company_delivery_methods))
						{
							$company_delivery_methods[] = $o_delivery_method;
						}
					}
					
					// Для каждого метода доставки создаем отдельный инвойс (или несколько, если разные склады)
					foreach($company_delivery_methods as $o_delivery_method)
					{
						$company_warehouses_pkids = array();
						$company_warehouses_offers = array();
						
						$company_delivery_method_offers = xarr($company_delivery_methods_offers, $o_delivery_method, array());
						foreach($company_delivery_method_offers as $offer)
						{
							$warehouse_pkid = xarr($offer, 'delivery_warehouse_pkid');
							$company_warehouses_offers[$warehouse_pkid][] = $offer;
							if($warehouse_pkid != null and !in_array($warehouse_pkid, $company_warehouses_pkids))
							{
								$company_warehouses_pkids[] = $warehouse_pkid;
							}
						}
						
						// Для каждого склада с этим методом доставки создаем отдельный инвойс
						foreach($company_warehouses_pkids as $warehouse_pkid)
						{
							$amount = 0;
							$amount_delivery = 0;
							$products = array();
							
							// Собираем все товары для этого склада
							$company_warehouse_offers = xarr($company_warehouses_offers, $warehouse_pkid, array());
							
							// Группируем товары по методу доставки и считаем суммарные показатели
							// (все товары в этой группе уже имеют одинаковый метод доставки, так как мы внутри цикла по $o_delivery_method)
							$total_count = 0;
							$total_weight = 0;
							$deliverymethod = null;
							
							// Сначала проходим по всем товарам, чтобы собрать данные для расчета доставки
							foreach($company_warehouse_offers as $offer)
							{
								$offer_count = intval(xarr($offer, 'count', 1));
								$offer_weight = floatval(xarr($offer, 'weight', 0));
								
								$total_count += $offer_count;
								$total_weight += $offer_weight * $offer_count;
								
								if($deliverymethod === null)
								{
									$deliverymethod = xarr($deliverymethods, xarr($offer, 'delivery_method'));
								}
							}
							
							// Теперь рассчитываем доставку для ВСЕХ товаров в этом инвойсе
							$deliverymethod_type = xarr($deliverymethod, 'type', 0);
							$deliverymethod_method = xarr($deliverymethod, 'method', 'fixed');
							
							if($deliverymethod_type != 0)
							{
								$deliverymethod_step = floatval(xarr($deliverymethod, 'step', 1));
								$deliverymethod_amount = xarr($deliverymethod, 'amount_value', 0);
								
								if($deliverymethod_method == 'fixed')
								{
									$amount_delivery = $deliverymethod_amount;
								}
								elseif($deliverymethod_method == 'fixedgoodscount')
								{
									// Всегда добавляем базовую стоимость за первый шаг
									$amount_delivery += $deliverymethod_amount;
									$total_count -= $deliverymethod_step;
									
									// Добавляем за дополнительные шаги
									while($total_count > 0)
									{
										$total_count -= $deliverymethod_step;
										$amount_delivery += $deliverymethod_amount;
									}
								}
								elseif($deliverymethod_method == 'fixedweight')
								{
									// Всегда добавляем базовую стоимость за первый шаг
									$amount_delivery += $deliverymethod_amount;
									$total_weight -= $deliverymethod_step;
									
									// Добавляем за дополнительные шаги
									while($total_weight > 0)
									{
										$total_weight -= $deliverymethod_step;
										$amount_delivery += $deliverymethod_amount;
									}
								}
							}
							
							// Теперь формируем товары для инвойса
							foreach($company_warehouse_offers as $offer)
							{
								$referer_login = xarr($offer, 'referer_login');
								if($referer_login == '') $referer_login = null;
								
								$offer_count = intval(xarr($offer, 'count', 1));
								$offer_weight = floatval(xarr($offer, 'weight', 0));
								$offer_discount = intval(xarr($offer, 'offer_discount', 0));
								$offer_site_discount = intval(xarr($offer, 'offer_site_discount', 0));
								$offer_broker_interes = intval(xarr($offer, 'offer_broker_interes', 0));
								$offer_amount_first = xarrj($offer, 'offer_sel_parameter.cost_per_unit');
								$offer_amount = floatval(xarr($offer_amount_first, 'value', 0));
								$offer_discount2 = 0;
								
								if($offer_discount > 0 or $offer_site_discount > 0 or ($referer_login and $offer_broker_interes > 0))
								{
									$offer_discounts = array($offer_discount, $offer_site_discount);
									if($referer_login)
									{
										$offer_discounts[] = $offer_broker_interes;
									}
									$offer_discount2 = max($offer_discounts);
									$offer_amount -= ($offer_amount / 100) * max($offer_discounts);
								}
								
								$offer_amount = ceil($offer_amount);
								$offer_amount *= $offer_count;
								$amount += $offer_amount;
								
								for($i = 0; $i < $offer_count; $i++)
								{
									$products[] = array(
										'tid' => xarr($offer, 'tid'), // акцептованнный ИНТ товара
										'offer_name' => xarr($offer, 'offer_name', xarrj($offer, 'goods_name.ru', '')),
										'offer_number' => xarr($offer, 'offer_number'),
										'size_pkid' => xarr($offer, 'size_pkid'),
										'color_pkid' => xarr($offer, 'color_pkid'),
										'gender_pkid' => xarr($offer, 'gender_pkid'),
										'weight' => $offer_weight,
										'amount' => $offer_amount_first, // цена за единицу (без скидок)
										
										'discount' => $offer_discount2, // скидка в процентах
										'isSaleWithoutQr' => xarr($offer, 'isSaleWithoutQr'), // разрешена ли продажа без QR кодов?
										'isDelivered' => false, // был ли получен товар клиентом?
										'isDeleted' => false, // был ли возврат товара?
										
										// если не null то товары были акцептованы
										'qr_code_creator_number' => null, // создатель QR кода (номер)
										'qr_code_serial_number' => null, // серийный номер продукта
										'qr_code_type' => null, // серийный номер продукта
										
										// значения устанавливаются в момент продажи
										//'qr_code_count_si' => 1, // количество товара в СИ
										//'qr_code_si' => 1, // ед. измерения
									);
								}
							}
							
							// Создаем инвойс для этого метода доставки и склада
							$c = IOCore::Instance('app.class.invoices');
							$c->assign_arr(
								array(
									'company_pkid' => $company_pkid,
									'client_phone' => $user_tel,
									'creator_pkid' => $user_id,
									'creator_login' => $user_login,
									//'referer_pkid' => $referer_pkid,
									'referer_login' => $referer_login,
									'products' => $products,
									
									// клиент user_<login> - логин пользователя; company_<pkid> - pkid компании; crm_<pkid> - pkid записи из CRM; text_<ФИО> - незарегистрированный пользователь;
									'client_pkid' => 'user_'.$user_login,
									
									// тип инвойса (ioEnum.invoices_types)
									'type' => 2, // заказ
									
									// статус инвойса
									'status' => 0, // 0: заказан клиентом,
									
									// массив из акцептованных ИНТ товаров
									'products_tids' => array(),
									
									// количество продуктов
									'products_count' => count($products),
									
									// общая сумма товаров, которая вычисляется по предложениям
									'amount' => array(
										'value' => $amount,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									
									'delivery_method' => $o_delivery_method,
									'warehouse_pkid' => $warehouse_pkid,
									
									// информация о доставке
									'delivery_info' => $comment,
									
									// стоимость доставки
									'amount_delivery' => array(
										'value' => $amount_delivery,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									
									// сумма за которую были куплены товары
									'amount_paid' => array(
										'value' => $amount + $amount_delivery,
										'currency' =>  'KZT',
										'pay_type' => 0,
									),
									// сумма наличных
									'amount_cash' => array(
										'value' => 0,
										'currency' => 'KZT',
										'pay_type' => 0,
									),
									// сумма скидки
									'discount' => array(
										'value' => 0,
										'currency' => 'KZT',
										'pay_type' => 0,
