		// for estol, terminal, tablo
		// создание инвойса через терминал
		public static function doAddTerminal($result, $params)
		{
			$resob = xarr($params, 'offersBasket', array());
			
			$company_pkid = xarr($params, 'company_pkid');
			$warehouse_pkid = xarr($params, 'warehouse_pkid'); // точка продажи (например столовая школы)
			
			$hasTerminal = xarr($params, 'terminal', true); // заказ через терминал? (то true) т.к. если через приложение (то false)
			
			$payments = xarr($params, 'payments', array());
			
			$deliveryInfo = xarr($params, 'deliveryInfo');
			
			$creator_user_pkid = xarr($params, 'creator_user_pkid');
			$creator_user_login = xarr($params, 'creator_user_login');
			
			$cashier_user_pkid = xarr($params, 'cashier_user_pkid');
			$cashier_user_login = xarr($params, 'cashier_user_login');
			
			$client_pkid = xarr($params, 'client_pkid'); // user_<login>
			
			$payment_client_login = '';
			$payment_client_pkid = null;
			if(strpos($client_pkid, 'user_') === 0)
			{
				$payment_client_login = substr($client_pkid, 5);
				$rpayment_client = IOCore::call(
					'com.class.user.findByLogin',
					array(
						'login' => $payment_client_login,
					)
				);
				$payment_client = array_shift($rpayment_client);
				$payment_client_pkid = xarr($payment_client, 'id');
			}
			if($creator_user_login == $payment_client_login)
			{
				$creator_user_pkid = $payment_client_pkid;
			}
			$invoice_status = ($cashier_user_pkid ? 2 : ($hasTerminal ? 2 : 0)); // 0: заказан клиентом, 2: подготавливается
			
			if(gettype($resob) != 'array' or count($resob) <= 0)
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Не переданы товары для заказа';
				goto __exit;
			}
			
			$offers_numbers = array();
			foreach($resob as $el)
			{
				// собираем pkid'ы предложений
				$offer_number = xarr($el, 'offer_number');
				$offers_numbers[] = $offer_number;
			}
			
			// получаем предложения
			$roffers = IOCore::call(
				'app.class.offersMany.dbsearch2',
				array(
					'filter' => array(
						'offer_number' => $offers_numbers,
						'isDeleted' => false,
					),
					'limit' => count($offers_numbers),
					'out' => 'array',
				)
			);
			$resoffers = xarr($roffers, 'res', array());
			
			$offers = array();
			foreach($resob as $ob)
			{
				$offer_number = xarr($ob, 'offer_number');
				
				$offer = array();
				foreach($resoffers as $offeritem)
				{
					$offeritem_offer_number = xarr($offeritem, 'offer_number');
					if($offeritem_offer_number == $offer_number)
					{
						$offer = $offeritem;
						$offer['tmp_pkid'] = xarr($ob, 'tmp_pkid');
						$offer['offerbasket_pkid'] = xarr($ob, 'pkid');
						$offer['count'] = xarr($ob, 'count', 1);
						$offer['color_pkid'] = xarr($ob, 'color_pkid');
						$offer['size_pkid'] = xarr($ob, 'size_pkid');
						$offer['gender_pkid'] = xarr($ob, 'gender_pkid');
						$offer['delivery_method'] = 0;
						$offer['delivery_warehouse_pkid'] = null;
						break;
					}
				}
				if($offer)
				{
					$offer_parameters = xarr($offer, 'offer_parameters', array());
					$offer['offer_sel_parameter'] = array();
					foreach($offer_parameters as $offer_parameter)
					{
						$offer_parameter_color_pkid = xarr($offer_parameter, 'color_pkid');
						$offer_parameter_size_pkid = xarr($offer_parameter, 'size_pkid');
						$offer_parameter_gender_pkid = xarr($offer_parameter, 'gender_pkid');
						if($offer_parameter_color_pkid == xarr($offer, 'color_pkid')
						and $offer_parameter_size_pkid == xarr($offer, 'size_pkid')
						and $offer_parameter_gender_pkid == xarr($offer, 'gender_pkid'))
						{
							$offer_parameter_count = xarr($offer_parameter, 'count', 0);
							if($offer_parameter_count > 0)
							{
								$offer['offer_sel_parameter'] = $offer_parameter;
							}
							break;
						}
					}
					
					$offers[] = $offer;
				}
			}
			
			$amount = 0;
			$amount_delivery = 0;
			$products = array();
			
			foreach($offers as $offer)
			{
				$offer_tid = xarr($offer, 'tid');
				$offer_number = xarr($offer, 'offer_number');
				$offer_isSaleWithoutQr = xarr($offer, 'isSaleWithoutQr', false);
				$offer_count = intval(xarr($offer, 'count', 1));
				$offer_weight = floatval(xarr($offer, 'weight', 0));
				$offer_discount = intval(xarr($offer, 'offer_discount', 0));
				$offer_site_discount = intval(xarr($offer, 'offer_site_discount', 0));
				$offer_amount_first = xarrj($offer, 'offer_sel_parameter.cost_per_unit');
				$offer_amount = floatval(xarr($offer_amount_first, 'value', 0));
				$offer_discount2 = 0;
				if($offer_discount > 0 or $offer_site_discount > 0)
				{
					if($offer_discount > $offer_site_discount)
					{
						$offer_discount2 = $offer_discount;
						$offer_amount -= ($offer_amount / 100) * $offer_discount;
						//$offer_amount_first['value'] = $offer_amount;
					}
					else
					{
						$offer_discount2 = $offer_site_discount;
						$offer_amount -= ($offer_amount / 100) * $offer_site_discount;
						//$offer_amount_first['value'] = $offer_amount;
					}
				}
				$offer_amount = ceil($offer_amount);
				$offer_amount *= $offer_count;
				$amount += $offer_amount;
				
				for($i = 0; $i < $offer_count; $i++)
				{
					$products[] = array(
						'tid' => $offer_tid, // акцептованнный ИНТ товара
						'offer_name' => xarr($offer, 'offer_name', xarrj($offer, 'goods_name.ru', '')),
						'offer_number' => $offer_number,
						'size_pkid' => xarr($offer, 'size_pkid'),
						'color_pkid' => xarr($offer, 'color_pkid'),
						'gender_pkid' => xarr($offer, 'gender_pkid'),
						'weight' => $offer_weight, // вес товара
						'amount' => $offer_amount_first, // цена за единицу (без скидок)
						
						'discount' => $offer_discount2, // скидка в процентах
						'isSaleWithoutQr' => $offer_isSaleWithoutQr, // разрешена ли продажа без QR кодов?
						'isDelivered' => false, // был ли получен товар клиентом?
						'isDeleted' => false, // был ли возврат товара?
						
						// если не null то товары были акцептованы
						'qr_code_creator_number' => $offer_isSaleWithoutQr ? 1 : null, // создатель QR кода (номер)
						'qr_code_serial_number' => $offer_isSaleWithoutQr ? 0 : null, // серийный номер продукта
						'qr_code_type' => $offer_isSaleWithoutQr ? 0 : null, // серийный номер продукта
						
						// значения устанавливаются в момент продажи
						'qr_code_count_si' => $offer_isSaleWithoutQr ? 1 : null, // количество товара в СИ
						'qr_code_si' =>  $offer_isSaleWithoutQr ? 1 : null, // ед. измерения
						'qr_code_si_visible' =>  $offer_isSaleWithoutQr ? 257 : null, // ед. измерения
					);
				}
			}
			
			// проверка платежей
			$payments_check = array();
			foreach($payments as $payment)
			{
				$payment_pay_type = intval(xarr($payment, 'pay_type', 0));
				$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
				$payment_amount = xarr(xarr($payment, 'amount', array()), 'value', 0);
				
				if($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
				{
					if($payment_client_login == '')
					{
						$result->error_code = EIO_USER - 4;
						$result->error_str = 'Платежи с использованием счетов либо баланса аккаунта возможны только для зарегистрированных клиентов';
						goto __exit;
					}
					
					$payments_check_str = ($payment_pay_type||0).($payment_moneypacket_pkid||0);
					if(in_array($payments_check_str, $payments_check))
					{
						$result->error_code = EIO_USER - 5;
						$result->error_str = 'Нельзя добавлять новые платежи с баланса аккаунта либо одного и того же счета несколько раз';
						goto __exit;
					}
					$payments_check[] = $payments_check_str;
					
					if($payment_moneypacket_pkid)
					{
						// проверка счета покупателя на наличие средств
						$rmp = IOCore::call(
							'upi.class.moneyPackets.dbsearch2',
							array(
								'filter' => array(
									'pkid' => $payment_moneypacket_pkid,
									'>balance' => 0,
									'isActive' => true,
									'isDeleted' => false,
								),
								'limit' => 1,
								'out' => 'array',
							)
						);
						$resmp = xarr($rmp, 'res', array());
						$mp = array_shift($resmp);
						if($mp)
						{
							$mp_balance = floatval(xarr($mp, 'balance', 0));
							if($mp_balance < $payment_amount)
							{
								$result->error_code = EIO_USER - 2;
								$result->error_str = 'В одном из платежей, c использованием счетов аккаунта покупателя недостаточно средств для выполнения платежа';
								goto __exit;
							}
						}
					}
					else
					{
						$ub = IOCore::callAction(
							'com.model.user.getBalance',
							array(
								'user_login' => $payment_client_login,
							)
						);
						$ub_balance = floatval(xarr($ub, 'balance', 0));
						if($ub_balance < $payment_amount)
						{
							$result->error_code = EIO_USER - 3;
							$result->error_str = 'В одном из платежей, c использованием баланса аккаунта покупателя недостаточно средств для выполнения платежа';
							goto __exit;
						}
					}
				}
			}
			
			$c = IOCore::Instance('app.class.invoices');
			$c->assign_arr(
				array(
					'company_pkid' => $company_pkid,
					
					'creator_pkid' => $creator_user_pkid,
					'creator_login' => $creator_user_login,
					
					// клиент user_<login> - логин пользователя; company_<pkid> - pkid компании; crm_<pkid> - pkid записи из CRM; text_<ФИО> - незарегистрированный пользователь;
					'client_pkid' => $client_pkid ? $client_pkid : null,
					
					'cashier_pkid' => $cashier_user_pkid,
					'cashier_login' => $cashier_user_login,
					
					// тип инвойса (ioEnum.invoices_types)
					'type' => 0, // продажа
					
					// статус инвойса
					'status' => $invoice_status,
					
					'products' => $products,
					
					// общая сумма товаров, которая вычисляется по предложениям
					'amount' => array(
						'value' => $amount,
						'currency' => 'KZT',
						'pay_type' => 0,
					),
					
					'delivery_method' => 0,
					'warehouse_pkid' => $warehouse_pkid,
					
					// информация о доставке
					'delivery_info' => $deliveryInfo,
					
					// стоимость доставки
					'amount_delivery' => array(
						'value' => $amount_delivery,
						'currency' => 'KZT',
						'pay_type' => 0,
					),
					
					// сумма за которую были куплены товары
					'amount_paid' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 0,
					),
					// сумма наличных
					'amount_cash' => array(
						'value' => 0,
						'currency' => 'KZT',
						'pay_type' => 0,
					),
					// сумма скидки
					'discount' => array(
						'value' => 0,
						'currency' => 'KZT',
						'pay_type' => 0,
					),
					
					'isPayed' => false,
					'dateSale' => null,
					'dateDelivery' => null,
				)
			);
			$c->create();
			if(xarr($c, 'error_code', EIO_FALSE) != EIO_OK)
			{
				$result->error_code = xarr($c, 'error_code', EIO_FALSE);
				$result->error_str = xarr($c, 'error_str', '');
				goto __exit;
			}
			
			$result->pkid = xarr($c, 'pkid');
			$result->invoice_number = xarr($c, 'invoice_number');
			
			$payment_errors = array();
			// добавление платежей
			foreach($payments as $payment)
			{
				$payment_pay_type = intval(xarr($payment, 'pay_type', 0));
				$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
				$payment_moneypacket_group_pkid = xarr($payment, 'moneypacket_group_pkid');
				$payment_moneypacket_company_pkid = xarr($payment, 'moneypacket_company_pkid');
				$payment_vseobuch_period_pkid = xarr($payment, 'vseobuch_period_pkid');
				
				$cp = IOCore::Instance('app.class.invoicesPayments');
				$cp->company_pkid = $company_pkid;
				$cp->invoice_pkid = xarr($c, 'pkid');
				$cp->invoice_number = xarr($c, 'invoice_number');
				$cp->warehouse_pkid = $warehouse_pkid;
				$cp->client_pkid = xarr($c, 'client_pkid', '');
				$cp->cashier_pkid = xarr($c, 'cashier_pkid');
				$cp->cashier_login = xarr($c, 'cashier_login');
				$cp->type = xarr($payment, 'type', 1);
				$cp->pay_type = $payment_pay_type;
				$cp->moneyPacket_pkid = $payment_moneypacket_pkid;
				$cp->moneyPacket_group_pkid = $payment_moneypacket_group_pkid;
				$cp->moneyPacket_company_pkid = $payment_moneypacket_company_pkid;
				$cp->vseobuch_period_pkid = $payment_vseobuch_period_pkid;
				/*$cp->amount = xarr($payment, 'amount', array(
					'value' => 0,
					'currency' => 'KZT',
					'pay_type' => $payment_pay_type,
				));*/
				$cp->amount_value = xarrj($payment, 'amount.value', 0);
				$cp->amount_currency = xarrj($payment, 'amount.currency', 'KZT');
				if($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
				{
					if($payment_client_login != '')
					{
						if($payment_moneypacket_pkid)
						{
							// списание со счета покупателя
							$payment_pay = IOCore::callAction(
								'upi.model.moneyPackets.writeoffMoney',
								array(
									'pkid' => $payment_moneypacket_pkid,
									'money' => xarr($cp, 'amount_value', 0),
									'description' => 'Оплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
									'status' => 4, // успшно завершен
								)
							);
							if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
							{
								$payment_errors[] = array(
									'type' => 'moneypacket_delInBalance',
									'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
									'error_str' => xarr($payment_pay, 'error_str', ''),
								);
							}
							else
							{
								$payment_history = IOCore::callAction(
									'com.model.cabinet.buyhistory.add',
									array(
										'user_pkid' => $payment_client_pkid,
										'user_login' => $payment_client_login,
										'userMoneyPacket_pkid' => $payment_moneypacket_pkid,
										'name' => 'Оплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
										'type' => 2, // списание
										'price' => xarr($cp, 'amount_value', 0),
										'count' => 1,
									)
								);
								
								$cp->create();
								if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'payment_moneypacket_create',
										'error_code' => xarr($cp, 'error_code', EIO_FALSE),
										'error_str' => xarr($cp, 'error_str', ''),
									);
								}
							}
						}
						else
						{
							// списание с баланса аккаунта покупателя
							$payment_pay = IOCore::callAction(
								'com.model.user.delInBalance',
								array(
									'user_login' => $payment_client_login,
									'value' => xarr($cp, 'amount_value', 0),
								)
							);
							if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
							{
								$payment_errors[] = array(
									'type' => 'balance_delInBalance',
									'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
									'error_str' => xarr($payment_pay, 'error_str', ''),
								);
							}
							else
							{
								$payment_history = IOCore::callAction(
									'com.model.cabinet.buyhistory.add',
									array(
										'user_pkid' => $payment_client_pkid,
										'user_login' => $payment_client_login,
										'name' => 'Оплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
										'type' => 2, // списание
										'price' => xarr($cp, 'amount_value', 0),
										'count' => 1,
									)
								);
								
								$cp->create();
								if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'payment_balance_create',
										'error_code' => xarr($cp, 'error_code', EIO_FALSE),
										'error_str' => xarr($cp, 'error_str', ''),
									);
								}
							}
						}
					}
				}
				else
				{
					$cp->create();
					if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
					{
						$payment_errors[] = array(
							'type' => 'payment_create',
							'error_code' => xarr($cp, 'error_code', EIO_FALSE),
							'error_str' => xarr($cp, 'error_str', ''),
						);
					}
				}
			}
			$result->payment_errors = $payment_errors;
			
			if(count($payments) > 0
			and count($payment_errors) <= 0)
			{
				$c->isPayed = true;
				$c->dateSale = time();
				// сумма за которую были куплены товары
				$c->amount_paid = array(
					'value' => floatval(xarr(xarr($c, 'amount', array()), 'value', 0)) + floatval(xarr(xarr($c, 'amount_delivery', array()), 'value', 0)),
					'currency' =>  'KZT',
					'pay_type' => 0,
				);
				// сумма наличных
				$c->amount_cash = $c->amount_paid;
				$c->update();
				if(xarr($c, 'error_code', EIO_FALSE) != EIO_OK)
				{
					$result->error_code = xarr($c, 'error_code', EIO_FALSE);
					$result->error_str = xarr($c, 'error_str', '');
					goto __exit;
				}
				foreach(xarr($c, 'products', array()) as $key => $obj)
				{
					$cproduct_tid = xarr($obj, 'tid');
					$cproduct_offer_number = xarr($obj, 'offer_number');
					$cproduct_size_pkid = xarr($obj, 'size_pkid');
					$cproduct_color_pkid = xarr($obj, 'color_pkid');
					$cproduct_gender_pkid = xarr($obj, 'gender_pkid');
					
					// уменьшение количества товаров в предложениях
					$rcproductoffer = IOCore::call(
						'app.class.offers.dbsearch2',
						array(
							'filter' => array(
								'company_pkid' => xarr($c, 'company_pkid'),
								'tid' => $cproduct_tid,
								'offer_number' => $cproduct_offer_number,
								'isDeleted' => false,
							),
							'limit' => 1,
						)
					);
					$rescproductoffer = xarr($rcproductoffer, 'res', array());
					$cproduct_offer = array_shift($rescproductoffer);
					if($cproduct_offer)
					{
						$cproduct_offer_parameters = xarr($cproduct_offer, 'parameters', array());
						foreach($cproduct_offer_parameters as &$cpo_param)
						{
							$cpo_param_size_pkid = xarr($cpo_param, 'size_pkid');
							$cpo_param_color_pkid = xarr($cpo_param, 'color_pkid');
							$cpo_param_gender_pkid = xarr($cpo_param, 'gender_pkid');
							if($cpo_param_size_pkid == $cproduct_size_pkid
							and $cpo_param_color_pkid == $cproduct_color_pkid
							and $cpo_param_gender_pkid == $cproduct_gender_pkid)
							{
								$cpo_param['count'] = (intval(xarr($cpo_param, 'count', 0)) > 0) ? intval(xarr($cpo_param, 'count', 1)) - 1 : 0;
							}
						}
						$cproduct_offer->parameters = $cproduct_offer_parameters;
						$cproduct_offer->orders++; // увеличиваем количество заказов (покупок) предложений
						$cproduct_offer->update();
					}
				}
			}
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
		// for estol, terminal, tablo
		// изменение инвойса через терминал
		public static function doEditTerminal($result, $params)
		{
			$resob = xarr($params, 'offersBasket', array());
			
			$invoice_pkid = xarr($params, 'pkid');
			
			if($invoice_pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid инвойса';
				goto __exit;
			}
			
			$company_pkid = xarr($params, 'company_pkid');
			
			$hasTerminal = xarr($params, 'terminal', true); // заказ через терминал? (то true) т.к. если через приложение (то false)
			
			$payments = xarr($params, 'payments', array());
			
			$deliveryInfo = xarr($params, 'deliveryInfo');
			
			$cashier_user_pkid = xarr($params, 'cashier_user_pkid');
			$cashier_user_login = xarr($params, 'cashier_user_login');
			
			$invoice_status = ($cashier_user_pkid ? 2 : ($hasTerminal ? 2 : 0)); // 0: заказан клиентом, 2: подготавливается
			
			if(gettype($resob) != 'array' or count($resob) <= 0)
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Не переданы товары для заказа';
				goto __exit;
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'company_pkid' => $company_pkid,
						'pkid' => $invoice_pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$invoiceobj = array_shift($res);
			if($invoiceobj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			if(in_array(xarr($invoiceobj, 'status'), array(12, 102)))
			{
				$result->error_code = EIO_USER - 1;
				if(xarr($invoiceobj, 'status') == 12)
				{
					$result->error_str = 'Вы не можете изменить инвойс, так как уже оформлена доставка';
				}
				elseif(xarr($invoiceobj, 'status') == 102)
				{
					$result->error_str = 'Вы не можете изменить инвойс, так как возврат уже совершен';
				}
				goto __exit;
			}
			if(xarr($invoiceobj, 'isPayed', false))
			{
				$result->error_code = EIO_USER - 2;
				$result->error_str = 'Вы не можете изменить инвойс, так как была внесена оплата';
				goto __exit;
			}
			
			$payment_client_login = '';
			$payment_client_pkid = null;
			if(strpos(xarr($invoiceobj, 'client_pkid'), 'user_') === 0)
			{
				$payment_client_login = substr(xarr($invoiceobj, 'client_pkid'), 5);
				$rpayment_client = IOCore::call(
					'com.class.user.findByLogin',
					array(
						'login' => $payment_client_login,
					)
				);
				$payment_client = array_shift($rpayment_client);
				$payment_client_pkid = xarr($payment_client, 'id');
			}
			
			$offers_numbers = array();
			foreach($resob as $el)
			{
				// собираем pkid'ы предложений
				$offer_number = xarr($el, 'offer_number');
				$offers_numbers[] = $offer_number;
			}
			
			// получаем предложения
			$roffers = IOCore::call(
				'app.class.offersMany.dbsearch2',
				array(
					'filter' => array(
						'offer_number' => $offers_numbers,
						'isDeleted' => false,
					),
					'limit' => count($offers_numbers),
					'out' => 'array',
				)
			);
			$resoffers = xarr($roffers, 'res', array());
			
			$offers = array();
			foreach($resob as $ob)
			{
				$offer_number = xarr($ob, 'offer_number');
				
				$offer = array();
				foreach($resoffers as $offeritem)
				{
					$offeritem_offer_number = xarr($offeritem, 'offer_number');
					if($offeritem_offer_number == $offer_number)
					{
						$offer = $offeritem;
						$offer['tmp_pkid'] = xarr($ob, 'tmp_pkid');
						$offer['offerbasket_pkid'] = xarr($ob, 'pkid');
						$offer['count'] = xarr($ob, 'count', 1);
						$offer['color_pkid'] = xarr($ob, 'color_pkid');
						$offer['size_pkid'] = xarr($ob, 'size_pkid');
						$offer['gender_pkid'] = xarr($ob, 'gender_pkid');
						$offer['delivery_method'] = 0;
						$offer['delivery_warehouse_pkid'] = null;
						break;
					}
				}
				if($offer)
				{
					$offer_parameters = xarr($offer, 'offer_parameters', array());
					$offer['offer_sel_parameter'] = array();
					foreach($offer_parameters as $offer_parameter)
					{
						$offer_parameter_color_pkid = xarr($offer_parameter, 'color_pkid');
						$offer_parameter_size_pkid = xarr($offer_parameter, 'size_pkid');
						$offer_parameter_gender_pkid = xarr($offer_parameter, 'gender_pkid');
						if($offer_parameter_color_pkid == xarr($offer, 'color_pkid')
						and $offer_parameter_size_pkid == xarr($offer, 'size_pkid')
						and $offer_parameter_gender_pkid == xarr($offer, 'gender_pkid'))
						{
							$offer_parameter_count = xarr($offer_parameter, 'count', 0);
							if($offer_parameter_count > 0)
							{
								$offer['offer_sel_parameter'] = $offer_parameter;
							}
							break;
						}
					}
					
					$offers[] = $offer;
				}
			}
			
			$amount = 0;
			$amount_delivery = 0;
			$products = array();
			
			foreach($offers as $offer)
			{
				$offer_tid = xarr($offer, 'tid');
				$offer_number = xarr($offer, 'offer_number');
				$offer_isSaleWithoutQr = xarr($offer, 'isSaleWithoutQr', false);
				$offer_count = intval(xarr($offer, 'count', 1));
				$offer_weight = floatval(xarr($offer, 'weight', 0));
				$offer_discount = intval(xarr($offer, 'offer_discount', 0));
				$offer_site_discount = intval(xarr($offer, 'offer_site_discount', 0));
				$offer_amount_first = xarrj($offer, 'offer_sel_parameter.cost_per_unit');
				$offer_amount = floatval(xarr($offer_amount_first, 'value', 0));
				$offer_discount2 = 0;
				if($offer_discount > 0 or $offer_site_discount > 0)
				{
					if($offer_discount > $offer_site_discount)
					{
						$offer_discount2 = $offer_discount;
						$offer_amount -= ($offer_amount / 100) * $offer_discount;
						//$offer_amount_first['value'] = $offer_amount;
					}
					else
					{
						$offer_discount2 = $offer_site_discount;
						$offer_amount -= ($offer_amount / 100) * $offer_site_discount;
						//$offer_amount_first['value'] = $offer_amount;
					}
				}
				$offer_amount = ceil($offer_amount);
				$offer_amount *= $offer_count;
				$amount += $offer_amount;
				
				for($i = 0; $i < $offer_count; $i++)
				{
					$products[] = array(
						'tid' => $offer_tid, // акцептованнный ИНТ товара
						'offer_name' => xarr($offer, 'offer_name', xarrj($offer, 'goods_name.ru', '')),
						'offer_number' => $offer_number,
						'size_pkid' => xarr($offer, 'size_pkid'),
						'color_pkid' => xarr($offer, 'color_pkid'),
						'gender_pkid' => xarr($offer, 'gender_pkid'),
						'weight' => $offer_weight, // вес товара
						'amount' => $offer_amount_first, // цена за единицу (без скидок)
						
						'discount' => $offer_discount2, // скидка в процентах
						'isSaleWithoutQr' => $offer_isSaleWithoutQr, // разрешена ли продажа без QR кодов?
						'isDelivered' => false, // был ли получен товар клиентом?
						'isDeleted' => false, // был ли возврат товара?
						
						// если не null то товары были акцептованы
						'qr_code_creator_number' => $offer_isSaleWithoutQr ? 1 : null, // создатель QR кода (номер)
						'qr_code_serial_number' => $offer_isSaleWithoutQr ? 0 : null, // серийный номер продукта
						'qr_code_type' => $offer_isSaleWithoutQr ? 0 : null, // серийный номер продукта
						
						// значения устанавливаются в момент продажи
						'qr_code_count_si' => $offer_isSaleWithoutQr ? 1 : null, // количество товара в СИ
						'qr_code_si' =>  $offer_isSaleWithoutQr ? 1 : null, // ед. измерения
						'qr_code_si_visible' =>  $offer_isSaleWithoutQr ? 257 : null, // ед. измерения
					);
				}
			}
			
			// проверка платежей
			$payments_check = array();
			foreach($payments as $payment)
			{
				$payment_pay_type = intval(xarr($payment, 'pay_type', 0));
				$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
				$payment_amount = xarr(xarr($payment, 'amount', array()), 'value', 0);
				
				if($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
				{
					if($payment_client_login == '')
					{
						$result->error_code = EIO_USER - 4;
						$result->error_str = 'Платежи с использованием счетов либо баланса аккаунта возможны только для зарегистрированных клиентов';
						goto __exit;
					}
					
					$payments_check_str = ($payment_pay_type||0).($payment_moneypacket_pkid||0);
					if(in_array($payments_check_str, $payments_check))
					{
						$result->error_code = EIO_USER - 5;
						$result->error_str = 'Нельзя добавлять новые платежи с баланса аккаунта либо одного и того же счета несколько раз';
						goto __exit;
					}
					$payments_check[] = $payments_check_str;
					
					if($payment_moneypacket_pkid)
					{
						// проверка счета покупателя на наличие средств
						$rmp = IOCore::call(
							'upi.class.moneyPackets.dbsearch2',
							array(
								'filter' => array(
									'pkid' => $payment_moneypacket_pkid,
									'>balance' => 0,
									'isActive' => true,
									'isDeleted' => false,
								),
								'limit' => 1,
								'out' => 'array',
							)
						);
						$resmp = xarr($rmp, 'res', array());
						$mp = array_shift($resmp);
						if($mp)
						{
							$mp_balance = floatval(xarr($mp, 'balance', 0));
							if($mp_balance < $payment_amount)
							{
								$result->error_code = EIO_USER - 2;
								$result->error_str = 'В одном из платежей, c использованием счетов аккаунта покупателя недостаточно средств для выполнения платежа';
								goto __exit;
							}
						}
					}
					else
					{
						$ub = IOCore::callAction(
							'com.model.user.getBalance',
							array(
								'user_login' => $payment_client_login,
							)
						);
						$ub_balance = floatval(xarr($ub, 'balance', 0));
						if($ub_balance < $payment_amount)
						{
							$result->error_code = EIO_USER - 3;
							$result->error_str = 'В одном из платежей, c использованием баланса аккаунта покупателя недостаточно средств для выполнения платежа';
							goto __exit;
						}
					}
				}
			}
			
			$invoiceobj->cashier_pkid = $cashier_user_pkid;
			$invoiceobj->cashier_login = $cashier_user_login;
			
			// статус инвойса
			$invoiceobj->status = $invoice_status;
			
			$invoiceobj->products = $products;
			
			// общая сумма товаров, которая вычисляется по предложениям
			$invoiceobj->amount = array(
				'value' => $amount,
				'currency' => 'KZT',
				'pay_type' => 0,
			);
			
			// информация о доставке
			$invoiceobj->delivery_info = $deliveryInfo;
			
			// стоимость доставки
			$invoiceobj->amount_delivery = array(
				'value' => $amount_delivery,
				'currency' => 'KZT',
				'pay_type' => 0,
			);
			
			// сумма за которую были куплены товары
			$invoiceobj->amount_paid = array(
				'value' => 0,
				'currency' =>  'KZT',
				'pay_type' => 0,
			);
			// сумма наличных
			$invoiceobj->amount_cash = array(
				'value' => 0,
				'currency' => 'KZT',
				'pay_type' => 0,
			);
			// сумма скидки
			$invoiceobj->discount = array(
				'value' => 0,
				'currency' => 'KZT',
				'pay_type' => 0,
			);
			
			$invoiceobj->isPayed = false;
			$invoiceobj->dateSale = null;
			$invoiceobj->dateDelivery = null;
			
			$invoiceobj->update();
			if(xarr($invoiceobj, 'error_code', EIO_FALSE) != EIO_OK)
			{
				$result->error_code = xarr($invoiceobj, 'error_code', EIO_FALSE);
				$result->error_str = xarr($invoiceobj, 'error_str', '');
				goto __exit;
			}
			
			$payment_errors = array();
			// добавление платежей
			foreach($payments as $payment)
			{
				$payment_pay_type = intval(xarr($payment, 'pay_type', 0));
				$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
				$payment_moneypacket_group_pkid = xarr($payment, 'moneypacket_group_pkid');
				$payment_moneypacket_company_pkid = xarr($payment, 'moneypacket_company_pkid');
				$payment_vseobuch_period_pkid = xarr($payment, 'vseobuch_period_pkid');
				
				$cp = IOCore::Instance('app.class.invoicesPayments');
				$cp->company_pkid = $company_pkid;
				$cp->invoice_pkid = xarr($invoiceobj, 'pkid');
				$cp->invoice_number = xarr($invoiceobj, 'invoice_number');
				$cp->client_pkid = xarr($invoiceobj, 'client_pkid', '');
				$cp->cashier_pkid = xarr($invoiceobj, 'cashier_pkid');
				$cp->cashier_login = xarr($invoiceobj, 'cashier_login');
				$cp->type = xarr($payment, 'type', 1);
				$cp->pay_type = $payment_pay_type;
				$cp->moneyPacket_pkid = $payment_moneypacket_pkid;
				$cp->moneyPacket_group_pkid = $payment_moneypacket_group_pkid;
				$cp->moneyPacket_company_pkid = $payment_moneypacket_company_pkid;
				$cp->vseobuch_period_pkid = $payment_vseobuch_period_pkid;
				/*$cp->amount = xarr($payment, 'amount', array(
					'value' => 0,
					'currency' => 'KZT',
					'pay_type' => $payment_pay_type,
				));*/
				$cp->amount_value = xarrj($payment, 'amount.value', 0);
				$cp->amount_currency = xarrj($payment, 'amount.currency', 'KZT');
				if($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
				{
					if($payment_client_login != '')
					{
						if($payment_moneypacket_pkid)
						{
							// списание со счета покупателя
							$payment_pay = IOCore::callAction(
								'upi.model.moneyPackets.writeoffMoney',
								array(
									'pkid' => $payment_moneypacket_pkid,
									'money' => xarr($cp, 'amount_value', 0),
									'description' => 'Оплата заказа № '.xarr($invoiceobj, 'invoice_number', '???').' в сервисе BMC Trade',
									'status' => 4, // успшно завершен
								)
							);
							if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
							{
								$payment_errors[] = array(
									'type' => 'moneypacket_delInBalance',
									'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
									'error_str' => xarr($payment_pay, 'error_str', ''),
								);
							}
							else
							{
								$payment_history = IOCore::callAction(
									'com.model.cabinet.buyhistory.add',
									array(
										'user_pkid' => $payment_client_pkid,
										'user_login' => $payment_client_login,
										'userMoneyPacket_pkid' => $payment_moneypacket_pkid,
										'name' => 'Оплата заказа № '.xarr($invoiceobj, 'invoice_number', '???').' в сервисе BMC Trade',
										'type' => 2, // списание
										'price' => xarr($cp, 'amount_value', 0),
										'count' => 1,
									)
								);
								
								$cp->create();
								if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'payment_moneypacket_create',
										'error_code' => xarr($cp, 'error_code', EIO_FALSE),
										'error_str' => xarr($cp, 'error_str', ''),
									);
								}
							}
						}
						else
						{
							// списание с баланса аккаунта покупателя
							$payment_pay = IOCore::callAction(
								'com.model.user.delInBalance',
								array(
									'user_login' => $payment_client_login,
									'value' => xarr($cp, 'amount_value', 0),
								)
							);
							if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
							{
								$payment_errors[] = array(
									'type' => 'balance_delInBalance',
									'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
									'error_str' => xarr($payment_pay, 'error_str', ''),
								);
							}
							else
							{
								$payment_history = IOCore::callAction(
									'com.model.cabinet.buyhistory.add',
									array(
										'user_pkid' => $payment_client_pkid,
										'user_login' => $payment_client_login,
										'name' => 'Оплата заказа № '.xarr($invoiceobj, 'invoice_number', '???').' в сервисе BMC Trade',
										'type' => 2, // списание
										'price' => xarr($cp, 'amount_value', 0),
										'count' => 1,
									)
								);
								
								$cp->create();
								if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'payment_balance_create',
										'error_code' => xarr($cp, 'error_code', EIO_FALSE),
										'error_str' => xarr($cp, 'error_str', ''),
									);
								}
							}
						}
					}
				}
				else
				{
					$cp->create();
					if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
					{
						$payment_errors[] = array(
							'type' => 'payment_create',
							'error_code' => xarr($cp, 'error_code', EIO_FALSE),
							'error_str' => xarr($cp, 'error_str', ''),
						);
					}
				}
			}
			$result->payment_errors = $payment_errors;
			
			if(count($payments) > 0
			and count($payment_errors) <= 0)
			{
				$invoiceobj->isPayed = true;
				$invoiceobj->dateSale = time();
				// сумма за которую были куплены товары
				$invoiceobj->amount_paid = array(
					'value' => floatval(xarr(xarr($invoiceobj, 'amount', array()), 'value', 0)) + floatval(xarr(xarr($invoiceobj, 'amount_delivery', array()), 'value', 0)),
					'currency' =>  'KZT',
					'pay_type' => 0,
				);
				// сумма наличных
				$invoiceobj->amount_cash = $invoiceobj->amount_paid;
				$invoiceobj->update();
				if(xarr($invoiceobj, 'error_code', EIO_FALSE) != EIO_OK)
				{
					$result->error_code = xarr($invoiceobj, 'error_code', EIO_FALSE);
					$result->error_str = xarr($invoiceobj, 'error_str', '');
					goto __exit;
				}
				foreach(xarr($invoiceobj, 'products', array()) as $key => $obj)
				{
					$cproduct_tid = xarr($obj, 'tid');
					$cproduct_offer_number = xarr($obj, 'offer_number');
					$cproduct_size_pkid = xarr($obj, 'size_pkid');
					$cproduct_color_pkid = xarr($obj, 'color_pkid');
					$cproduct_gender_pkid = xarr($obj, 'gender_pkid');
					
					// уменьшение количества товаров в предложениях
					$rcproductoffer = IOCore::call(
						'app.class.offers.dbsearch2',
						array(
							'filter' => array(
								'company_pkid' => xarr($invoiceobj, 'company_pkid'),
								'tid' => $cproduct_tid,
								'offer_number' => $cproduct_offer_number,
								'isDeleted' => false,
							),
							'limit' => 1,
						)
					);
					$rescproductoffer = xarr($rcproductoffer, 'res', array());
					$cproduct_offer = array_shift($rescproductoffer);
					if($cproduct_offer)
					{
						$cproduct_offer_parameters = xarr($cproduct_offer, 'parameters', array());
						foreach($cproduct_offer_parameters as &$cpo_param)
						{
							$cpo_param_size_pkid = xarr($cpo_param, 'size_pkid');
							$cpo_param_color_pkid = xarr($cpo_param, 'color_pkid');
							$cpo_param_gender_pkid = xarr($cpo_param, 'gender_pkid');
							if($cpo_param_size_pkid == $cproduct_size_pkid
							and $cpo_param_color_pkid == $cproduct_color_pkid
							and $cpo_param_gender_pkid == $cproduct_gender_pkid)
							{
								$cpo_param['count'] = (intval(xarr($cpo_param, 'count', 0)) > 0) ? intval(xarr($cpo_param, 'count', 1)) - 1 : 0;
							}
						}
						$cproduct_offer->parameters = $cproduct_offer_parameters;
						$cproduct_offer->orders++; // увеличиваем количество заказов (покупок) предложений
						$cproduct_offer->update();
					}
				}
			}
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
