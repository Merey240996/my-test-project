							goto __exit;
						}
						
						$payments_check_str = ($payment_pay_type||0).($payment_moneypacket_pkid||0);
						if(in_array($payments_check_str, $payments_check))
						{
							$result->error_code = EIO_USER - 17;
							$result->error_str = 'Нельзя добавлять новые платежи с баланса аккаунта либо одного и того же счета несколько раз';
							goto __exit;
						}
						$payments_check[] = $payments_check_str;
						
						if($payment_moneypacket_pkid)
						{
							// проверка счета покупателя на наличие средств
							$rmp = IOCore::call(
								'upi.class.moneyPackets.dbsearch2',
								array(
									'filter' => array(
										'pkid' => $payment_moneypacket_pkid,
										'>balance' => 0,
										'isActive' => true,
										'isDeleted' => false,
									),
									'limit' => 1,
									'out' => 'array',
								)
							);
							$resmp = xarr($rmp, 'res', array());
							$mp = array_shift($resmp);
							if($mp)
							{
								$mp_balance = floatval(xarr($mp, 'balance', 0));
								if($mp_balance < $payment_amount)
								{
									$result->error_code = EIO_USER - 14;
									$result->error_str = 'В одном из платежей, c использованием счетов аккаунта покупателя недостаточно средств для выполнения платежа';
									goto __exit;
								}
							}
						}
						else
						{
							$ub = IOCore::callAction(
								'com.model.user.getBalance',
								array(
									'user_login' => $payment_client_login,
								)
							);
							$ub_balance = floatval(xarr($ub, 'balance', 0));
							if($ub_balance < $payment_amount)
							{
								$result->error_code = EIO_USER - 15;
								$result->error_str = 'В одном из платежей, c использованием баланса аккаунта покупателя недостаточно средств для выполнения платежа';
								goto __exit;
							}
						}
					}
				}
				
				$payment_errors = array();
				// добавление платежей
				foreach($payments as $payment)
				{
					$payment_pay_type = intval(xarr($payment, 'pay_type', 0));
					$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
					$payment_moneypacket_group_pkid = xarr($payment, 'moneypacket_group_pkid');
					$payment_moneypacket_company_pkid = xarr($payment, 'moneypacket_company_pkid');
					$payment_vseobuch_period_pkid = xarr($payment, 'vseobuch_period_pkid');
					
					$cp = IOCore::Instance('app.class.invoicesPayments');
					$cp->company_pkid = $ioSession->user->getCompanyID();
					$cp->invoice_pkid = xarr($c, 'pkid');
					$cp->invoice_number = xarr($c, 'invoice_number');
					$cp->warehouse_pkid = $warehouse_pkid;
					$cp->client_pkid = xarr($c, 'client_pkid', '');
					$cp->client_cardnum = xarr($c, 'client_cardnum', '');
					$cp->cashier_pkid = $ioSession->user->id;
					$cp->cashier_login = $ioSession->user->login;
					$cp->type = xarr($payment, 'type', 0);
					$cp->pay_type = $payment_pay_type;
					$cp->moneyPacket_pkid = $payment_moneypacket_pkid;
					$cp->moneyPacket_group_pkid = $payment_moneypacket_group_pkid;
					$cp->moneyPacket_company_pkid = $payment_moneypacket_company_pkid;
					$cp->vseobuch_period_pkid = $payment_vseobuch_period_pkid;
					/*$cp->amount = xarr($payment, 'amount', array(
						'value' => 0,
						'currency' => 'KZT',
						'pay_type' => $payment_pay_type,
					));*/
					$cp->amount_value = xarrj($payment, 'amount.value', 0);
					$cp->amount_currency = xarrj($payment, 'amount.currency', 'KZT');
					if($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
					{
						$payment_client_login = '';
						$payment_client_pkid = null;
						if(strpos($client_pkid, 'user_') === 0)
						{
							$payment_client_login = substr($client_pkid, 5);
							$rpayment_client = IOCore::call(
								'com.class.user.findByLogin',
								array(
									'login' => $payment_client_login,
								)
							);
							$payment_client = array_shift($rpayment_client);
							$payment_client_pkid = xarr($payment_client, 'id');
						}
						if($payment_client_login != '')
						{
							if($payment_moneypacket_pkid)
							{
								// списание со счета покупателя
								$payment_pay = IOCore::callAction(
									'upi.model.moneyPackets.writeoffMoney',
									array(
										'pkid' => $payment_moneypacket_pkid,
										'money' => xarr($cp, 'amount_value', 0),
										'description' => 'Предоплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
										'status' => 4, // успшно завершен
									)
								);
								if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'moneypacket_delInBalance',
										'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
										'error_str' => xarr($payment_pay, 'error_str', ''),
									);
								}
								else
								{
									$payment_history = IOCore::callAction(
										'com.model.cabinet.buyhistory.add',
										array(
											'user_pkid' => $payment_client_pkid,
											'user_login' => $payment_client_login,
											'userMoneyPacket_pkid' => $payment_moneypacket_pkid,
											'name' => 'Предоплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
											'type' => 2, // списание
											'price' => xarr($cp, 'amount_value', 0),
											'count' => 1,
										)
									);
									
									$cp->create();
									if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
									{
										$payment_errors[] = array(
											'type' => 'payment_moneypacket_create',
											'error_code' => xarr($cp, 'error_code', EIO_FALSE),
											'error_str' => xarr($cp, 'error_str', ''),
										);
									}
								}
							}
							else
							{
								// списание с баланса аккаунта покупателя
								$payment_pay = IOCore::callAction(
									'com.model.user.delInBalance',
									array(
										'user_login' => $payment_client_login,
										'value' => xarr($cp, 'amount_value', 0),
									)
								);
								if(xarr($payment_pay, 'error_code', EIO_FALSE) != EIO_OK)
								{
									$payment_errors[] = array(
										'type' => 'balance_delInBalance',
										'error_code' => xarr($payment_pay, 'error_code', EIO_FALSE),
										'error_str' => xarr($payment_pay, 'error_str', ''),
									);
								}
								else
								{
									$payment_history = IOCore::callAction(
										'com.model.cabinet.buyhistory.add',
										array(
											'user_pkid' => $payment_client_pkid,
											'user_login' => $payment_client_login,
											'name' => 'Предоплата заказа № '.xarr($c, 'invoice_number', '???').' в сервисе BMC Trade',
											'type' => 2, // списание
											'price' => xarr($cp, 'amount_value', 0),
											'count' => 1,
										)
									);
									
									$cp->create();
									if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
									{
										$payment_errors[] = array(
											'type' => 'payment_balance_create',
											'error_code' => xarr($cp, 'error_code', EIO_FALSE),
											'error_str' => xarr($cp, 'error_str', ''),
										);
									}
								}
							}
						}
					}
					else
					{
						$cp->create();
						if(xarr($cp, 'error_code', EIO_FALSE) != EIO_OK)
						{
							$payment_errors[] = array(
								'type' => 'payment_create',
								'error_code' => xarr($cp, 'error_code', EIO_FALSE),
								'error_str' => xarr($cp, 'error_str', ''),
							);
						}
					}
				}
				$result->payment_errors = $payment_errors;
			}
			
			$c->create();
			if(xarr($c, 'error_code', EIO_FALSE) != EIO_OK)
			{
				$result->error_code = xarr($c, 'error_code', EIO_FALSE);
				$result->error_str = xarr($c, 'error_str', '');
				goto __exit;
			}
			
			$result->pkid = xarr($c, 'pkid');
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
		// изменение заказа
		public static function doEditOrder($result, $params)
		{
			global $ioSession, $ioProjects;
			
			$pkid = xarr($params, 'pkid');
			$event = xarr($params, 'event', 'edit');
			$warehouse_pkid = xarr($params, 'warehouse_pkid');
			$status = xarr($params, 'status', 0);
			$consultant_pkid = xarr($params, 'consultant_pkid');
			$consultant_login = xarr($params, 'consultant_login');
			$referer_pkid = xarr($params, 'referer_pkid');
			$referer_login = xarr($params, 'referer_login');
			$client_pkid = xarr($params, 'client_pkid');
			$client_cardnum = xarr($params, 'client_cardnum');
			$delivery_method = xarr($params, 'delivery_method', 0);
			$delivery_info = xarr($params, 'delivery_info');
			$delivery_time = xarr($params, 'delivery_time');
			$tracknumber = xarr($params, 'tracknumber');
			$currency = xarr($params, 'currency');
			$amount = xarr($params, 'amount');
			$amount_delivery = xarr($params, 'amount_delivery');
			$amount_cash = xarr($params, 'amount_cash');
			$amount_paid = xarr($params, 'amount_paid');
			$amount_odd = xarr($params, 'amount_odd');
			$products = xarr($params, 'products', array());
			$payments = xarr($params, 'payments', array());
			
			if($referer_login == '') $referer_login = null;
			
			$rinvoice = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'company_pkid' => $ioSession->user->getCompanyID(),
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$resinvoice = xarr($rinvoice, 'res', array());
			$invoiceobj = array_shift($resinvoice);
			if($invoiceobj == null)
			{
				$result->error_code = EIO_OBJECT_NOTFOUND;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			if(xarr($invoiceobj, 'status', 0) == -1)
			{
				$result->error_code = EIO_USER - 14;
				$result->error_str = 'Инвойс отменен';
				goto __exit;
			}
			
			if(count($payments) > 0)
			{
				if(!$ioSession->user->permission('bmc.trade2.invoice.sale'))
				{
					$result->error_code = EIO_USER - 1;
					$result->error_str = 'Вы не имеете полномочий продать товар';
					goto __exit;
				}
			}
			
			$rinvoicePayments = IOCore::call(
				'app.class.invoicesPayments.dbsearch2',
				array(
					'filter' => array(
						'invoice_pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1000,
					'out' => 'array',
				)
			);
			$invoicePayments = xarr($rinvoicePayments, 'res', array());
			$invoicePayments_count = xarr($rinvoicePayments, 'count', 0);
			
			if(in_array($event, array('edit-cancel')))
			{
				$amount_cash_pre = 0;
				foreach($invoicePayments as $payment)
				{
					$payment_amount = floatval(xarr($payment, 'amount_value', 0));
					$amount_cash_pre += $payment_amount;
				}
				foreach($payments as $payment)
				{
					$payment_amount = floatval(xarr($payment, 'amount_value', 0));
					$amount_cash_pre += $payment_amount;
				}
				if($amount_cash_pre > 0)
				{
					$result->error_code = EIO_USER - 20;
					$result->error_str = 'Нельзя отменить заказ так как не вся внесенная сумма возвращена клиенту. Осталось вернуть '.abs($amount_cash_pre);
					goto __exit;
				}
				elseif($amount_cash_pre < 0)
				{
					$result->error_code = EIO_USER - 21;
					$result->error_str = 'Нельзя отменить заказ так как по нему числится долг перед клиентом на сумму '.abs($amount_cash_pre);
					goto __exit;
				}
			}
			if(in_array($event, array('edit', 'edit-cancel', 'edit-sale', 'edit-sale-delivery')))
			{
				if(!$ioSession->user->permission('bmc.trade2.invoice.sale'))
				{
					$result->error_code = EIO_USER - 1;
					$result->error_str = 'Вы не имеете полномочий продать товар';
					goto __exit;
				}
				
				if(xarr($invoiceobj, 'isPayed', false))
				{
					$result->error_code = EIO_USER - 15;
					$result->error_str = 'Продажа уже оформлена';
					goto __exit;
				}
				
				if(!valid_money($amount))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма предложения';
					goto __exit;
				}
				if(!valid_money($amount_delivery))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма доставки';
					goto __exit;
				}
				if(!valid_money($amount_paid))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Сумма продажи';
					goto __exit;
				}
				if(!valid_money($amount_cash))
				{
					$result->error_code = EIO_VALIDATION_FIELD;
					$result->error_str = 'Всего наличными';
					goto __exit;
				}
			}
			if(in_array($event, array('edit-sale-delivery', 'edit-delivery')))
			{
				if(xarr($invoiceobj, 'status', 0) == 12)
				{
					$result->error_code = EIO_USER - 15;
					$result->error_str = 'Продажа и доставка уже оформлена';
					goto __exit;
				}
				if(!$ioSession->user->permission('bmc.trade2.invoice.delivery'))
				{
					$result->error_code = EIO_USER - 2;
					$result->error_str = 'Вы не имеете полномочий оформить доставку';
					goto __exit;
				}
			}
			
			if($consultant_pkid == null or $consultant_pkid == '')
			{
				$consultant_pkid = $ioSession->user->id;
			}
			if($consultant_login == null or $consultant_login == '')
			{
				$consultant_login = $ioSession->user->login;
			}
			
			if(xarr($invoiceobj, 'type') == null)
			{
				$invoiceobj->type = 2; // заказ
			}
			$invoiceobj->status = $status;
			$invoiceobj->delivery_info = $delivery_info;
			$invoiceobj->delivery_time = $delivery_time;
			$invoiceobj->delivery_method = $delivery_method;
			$invoiceobj->tracknumber = $tracknumber;
			
			$invoiceobj->consultant_pkid = $consultant_pkid;
			$invoiceobj->consultant_login = $consultant_login;
			
			$invoiceobj->referer_pkid = $referer_pkid;
			$invoiceobj->referer_login = $referer_login;
			
			$client_isCompany = false;
			$client_company_pkid = null;
			
			if($ioSession->user->permission('bmc.trade2.invoice.manage'))
			{
				if(!xarr($invoiceobj, 'isPayed', false)
				and in_array(xarr($invoiceobj, 'status'), array(0, 1, 2, 3, 4, 5, 6, 7)))
				{
					if(strpos($client_pkid, 'crm_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$crm_client_pkid = intval(substr($client_pkid, 4));
						if($crm_client_pkid != 0)
						{
							$invoiceobj->client_pkid = $client_pkid;
						}
					}
					elseif(strpos($client_pkid, 'user_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$user_client_pkid = substr($client_pkid, 5);
						if($user_client_pkid != '')
						{
							$invoiceobj->client_pkid = $client_pkid;
						}
					}
					elseif(strpos($client_pkid, 'company_') === 0)
					{
						$invoiceobj->client_pkid = null;
						$company_client_pkid = substr($client_pkid, 8);
						if($company_client_pkid != '')
						{
							$invoiceobj->client_pkid = $client_pkid;
							$client_isCompany = true;
							$client_company_pkid = $company_client_pkid;
						}
					}
					else
					{
						$invoiceobj->client_pkid = $client_pkid;
					}
					
					$invoiceobj->client_cardnum = $client_cardnum;
					
					$invoiceobj->warehouse_pkid = $warehouse_pkid;
				}
			}
			
			if(in_array(xarr($invoiceobj, 'status'), array(0, 1, 2, 3, 4, 5, 6, 7)))
			{
				if($ioSession->user->permission('bmc.trade2.invoice.items.add'))
				{
					$invoiceobj->products = $products;
				}
				if(!xarr($invoiceobj, 'isPayed', false))
				{
					// общая сумма товаров, которая вычисляется по предложениям (без учета доставки и общей скидки)
					$amount_value = xarr($amount, 'value');
					$invoiceobj->amount = $amount;
					
					// стоимость доставки (скидка на доставку не действует)
					$amount_delivery_value = xarr($amount_delivery, 'value');
					$invoiceobj->amount_delivery = $amount_delivery;
					
					// сумма инвойса (за которую были проданы товары (со скидкой, если есть) + доставка + общая скидка)
					$amount_paid_value = xarr($amount_paid, 'value');
					$invoiceobj->amount_paid = $amount_paid;
					
					// сумма наличных (сколько денег дал клиент. например товар стоит 85, клиент дал 100, тогда в этом поле будет 100)
					$amount_cash_value = xarr($amount_cash, 'value');
					$invoiceobj->amount_cash = $amount_cash;
					
					// раcсчитываем сумму скидки
					$discount = ($amount_value + $amount_delivery_value) - $amount_paid_value; 
					$invoiceobj->discount = array(
						'value' => $discount,
						'currency' => xarr($amount_cash, 'currency'),
						'pay_type' => null,
					);
					
					if(in_array($event, array('edit', 'edit-cancel', 'edit-sale', 'edit-sale-delivery', 'edit-delivery')))
					{
						// проверка платежей
						$payments_check = array();
						foreach($payments as $payment)
						{
							$payment_type = xarr($payment, 'pay_type');
							$payment_pay_type = xarr($payment, 'pay_type');
							$payment_moneypacket_pkid = xarr($payment, 'moneypacket_pkid');
							$payment_amount = xarr(xarr($payment, 'amount', array()), 'value', 0);
							
							if($payment_pay_type == null)
							{
								$result->error_code = EIO_USER - 18;
								$result->error_str = 'Один из платежей имеет неизвестный тип';
								goto __exit;
							}
							elseif($payment_pay_type == PAY_TYPE_ACCOUNT_BALANCE)
							{
								$payment_client_login = '';
								if(strpos($client_pkid, 'user_') === 0)
								{
									$payment_client_login = substr($client_pkid, 5);
								}
								if($payment_client_login == '')
								{
									$result->error_code = EIO_USER - 18;
									$result->error_str = 'Платежи с использованием счетов либо баланса аккаунта возможны только для зарегистрированных клиентов';
									goto __exit;
								}
								if($payment_type == -1)
								{
									// если возврат
									if($payment_moneypacket_pkid)
									{
										// проверка счета покупателя на наличие активности
										$rmp = IOCore::call(
											'upi.class.moneyPackets.dbsearch2',
											array(
												'filter' => array(
													'pkid' => $payment_moneypacket_pkid,
													'isActive' => true,
													'isDeleted' => false,
												),
												'limit' => 1,
												'out' => 'array',
											)
										);
										$resmp = xarr($rmp, 'res', array());
										$mp = array_shift($resmp);
										if(!$mp)
										{
											$result->error_code = EIO_USER - 22;
											$result->error_str = 'В одном из платежей используется счет, который в данный момент деактивирован';
											goto __exit;
										}
									}
								}
								else
								{
									// если предоплата/оплата
									$payments_check_str = ($payment_pay_type||0).($payment_moneypacket_pkid||0);
									if(in_array($payments_check_str, $payments_check))
									{
										$result->error_code = EIO_USER - 19;
										$result->error_str = 'Нельзя добавлять новые платежи с баланса аккаунта либо одного и того же счета несколько раз';
										goto __exit;
									}
									$payments_check[] = $payments_check_str;
									
									if($payment_moneypacket_pkid)
									{
										// проверка счетов покупателя на наличие средств
										$rmp = IOCore::call(
											'upi.class.moneyPackets.dbsearch2',
											array(
												'filter' => array(
