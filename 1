				function changeSizeType(params){
					var obj = params.obj, flagedit = false;
					if(typeof params.sizetype != 'undefined'){
						flagedit = true;
						var typeid = params.sizetype;
						$(obj).find('option').each(function(){
							if($(this).val() == typeid){
								$(this).attr('selected', 'selected');
							} else {
								$(this).removeAttr('selected');
							}
						});
						$(obj).val(typeid);
					} else {
						var typeid = $(obj).val();
					}
					if(typeid != '0'){
						if(flagedit){
							$(obj).parent().find('.invoice-product-size :selected').html('Выберите');
						}
						if(typeid != ''){
							$(obj).parent().find('.invoice-product-size').removeAttr('disabled');
						} else {
							$(obj).parent().find('.invoice-product-size').attr('disabled', 'disabled').val('');
						}
						$(obj).parent().find('.invoice-product-size').html('');
						$(obj).parent().find('.invoice-product-size').append(
							'<option value="" selected="selected" disabled="disabled">Выберите</option>'
						);
