							function calcvalues(dialog){
								var ret = [];
								
								var goods_count = dialog.getModalBody().find('.invoice-products-count').val()||0;
								ret['goods_count'] = goods_count;
								
								var selected_goods_count = dialog.getModalBody().find('.invoice-products .invoice-product-row .panel.bg-success').length||0;
								ret['selected_goods_count'] = selected_goods_count;
								
								var amount = 0; // сумма инвойса
								//var discount2 = 0; // скидка для выбранных товаров
								dialog.getModalBody().find('.invoice-products .invoice-product-row .panel.bg-success').each(function(i, el){
									if($(el).find('.qr_code_serial_number').val() != ''){
										amount += Math.floor(parseFloat($.trim($(el).find('.invoice-product-cost-per-unit').val().replace(/\s+/g, '')))); // стоимость товара с учетом скидки товара
										//discount2 += Math.floor(parseFloat($.trim($(el).find('.invoice-product-discount2').val().replace(/\s+/g, ''))));
									}
								});
								ret['amount'] = amount;
								
								ret['currency'] = 'KZT';
								
								var discount = Math.floor(parseFloat(dialog.getModalBody().find('.invoice-discount').val())); // скидка инвойса-продажи на все товары
								discount = isNaN(discount) ? 0 : discount;
								ret['discount'] = discount;
								
								var payments = getFormEditReturnInvoicePayments();
								var amount_cash = 0; // всего наличными
								$.each(payments, function(i, el){
									amount_cash += el.amount.value;
								});
								ret['amount_cash'] = amount_cash;
								
								var amount_full = amount;
								ret['amount_full'] = amount_full;
								
								var amount_paid = amount - discount;
								ret['amount_paid'] = amount_paid;
								
								var amount_pay = amount_paid;
								ret['amount_pay'] = amount_pay;
								
								var amount_odd = amount_cash - amount_pay;
								ret['amount_odd'] = amount_odd;
								
								return ret;
							}
							
							// изменение инвойса
							function editReturnInvoice(event, dialog){
								event = event||'edit';
								dialog = dialog||null;
								if(dialog == null) return;
								
								var $btnEdit = dialog.getButton('edit-btn');
								var $btnEditReturn = dialog.getButton('edit-return-btn');
								var $btnCancel = dialog.getButton('cancel-btn');
								
								var goods = getFormEditReturnInvoiceGoods();
								
								if(goods.length <= 0){
									var n = noty({
										text: 'Выберите возвращаемые товары',
										type: 'warning',
										layout: 'bottomRight',
										timeout: 3000,
									});
									return false;
								}
								
								var payments = getFormEditReturnInvoicePayments();
								
								var warehouse_pkid = dialog.getModalBody().find('.invoice-warehouse :selected').val();
								
								var client_pkid = dialog.getModalBody().find('.invoice-client').val()||'';
								var client_cardnum = dialog.getModalBody().find('.invoice-client-cardnum').val()||'';
								
								// сумма продажи
								var amount = parseFloat($.trim(dialog.getModalBody().find('.invoice-amount').val()).replace(/\s+/g, ''))||0;
								
								var discount = parseFloat($.trim(dialog.getModalBody().find('.invoice-amount-discount2').val()).replace(/\s+/g, ''))||0;
								
								var amount_cash = 0; // всего наличными
								$.each(payments, function(i, el){
									amount_cash += el.amount.value;
								});
								
								var amount_paid = amount - discount;
								
								var amount_odd = amount_cash - amount_paid;
								
								var params = {
									pkid: invoice_pkid,
									event: event,
									warehouse_pkid: warehouse_pkid,
									client_pkid: client_pkid,
									client_cardnum: client_cardnum,
									currency: 'KZT',
									amount: {
										value: amount,
										currency: 'KZT',
									},
									amount_delivery: {
										value: 0,
										currency: 'KZT',
									},
									discount: {
										value: discount,
										currency: 'KZT',
									},
									amount_paid: {
										value: amount_paid,
										currency: 'KZT',
									},
									amount_cash: {
										value: amount_cash,
										currency: 'KZT',
									},
									amount_odd: amount_odd,
									products: goods,
									payments: payments,
								};
								
								if(event == 'edit'){
									if($btnEdit) $btnEdit.spin();
								} else if(event == 'edit-return'){
									if($btnEditReturn) $btnEditReturn.spin();
								}
								if($btnEdit) $btnEdit.disable();
								if($btnEditReturn) $btnEditReturn.disable();
								$btnCancel.disable();
								
								// обработка запроса
								ioCallEntity({
									entity: 'bmc.trade2.model.invoices2.editReturn',
									resultType: 'json',
									params: params,
									success: function(data, tag){
										//console.log(data);
										var obj;try{obj = $.parseJSON(data);}catch(ex){obj = null;}
										if(obj != null && typeof(obj.res) != 'undefined' && obj.res != null && obj.res.error_code == '1'){
											var n = noty({
												text: 'Возврат успешно сохранен',
												type: 'success',
												layout: 'bottomRight',
												timeout: 2000,
											});
											
											// перезагрузка списка
											invoicesSearch();
											
											if(event == 'edit'){
												if($btnEdit) $btnEdit.stopSpin();
											} else if(event == 'edit-return'){
												if($btnEditReturn) $btnEditReturn.stopSpin();
											}
											if($btnEdit) $btnEdit.enable();
											if($btnEditReturn) $btnEditReturn.enable();
											$btnCancel.enable();
											
											if(event == 'edit-return'){
												if(confirm('Сформировать товарный чек данного возврата для распечатки?')){
													var href = '/entity/app.model.invoices2.getReceipt';
													href = urlGetAdd(href, 'account', ioParams['user.account']);
													href = urlGetAdd(href, 'pkid', invoice_pkid);
													//console.log(href);
													window.open(href, '_blank');
												}
											}
											
											dialog.close();
										} else {
											var n = noty({
												text: 'Не удалось сохранить возврат. Попробуйте еще раз.'+(obj != null && obj.res != null && obj.res.error_str != '' ? ' Полный текст ошибки: '+obj.res.error_str : ''),
												type: 'warning',
												layout: 'bottomRight',
												timeout: 4000,
											});
											
											if(event == 'edit'){
												if($btnEdit) $btnEdit.stopSpin();
											} else if(event == 'edit-return'){
												if($btnEditReturn) $btnEditReturn.stopSpin();
											}
											if($btnEdit) $btnEdit.enable();
											if($btnEditReturn) $btnEditReturn.enable();
											$btnCancel.enable();
										}
									}
								});
							}
							
