													// подсчет цен
													function calcvalues(dialog){
														var ret = [];
														
														var goods_count = dialog.getModalBody().find('.invoice-products-count').val()||0;
														ret['goods_count'] = goods_count;
														
														var selected_goods_count = dialog.getModalBody().find('.invoice-products .invoice-product-row .panel.bg-success').length||0;
														ret['selected_goods_count'] = selected_goods_count;
														
														var amount = 0; // сумма инвойса
														//var discount2 = 0; // скидка для выбранных товаров
														dialog.getModalBody().find('.invoice-products .invoice-product-row .panel.bg-success').each(function(i, el){
															if($(el).find('.qr_code_serial_number').val() != ''){
																amount += Math.floor(parseFloat($.trim($(el).find('.invoice-product-cost-per-unit').val().replace(/\s+/g, '')))); // стоимость товара с учетом скидки товара
																//discount2 += Math.floor(parseFloat($.trim($(el).find('.invoice-product-discount2').val().replace(/\s+/g, ''))));
															}
														});
														ret['amount'] = amount;
														
														ret['currency'] = 'KZT';
														
														var discount = Math.floor(parseFloat(dialog.getModalBody().find('.invoice-discount').val())); // скидка инвойса-продажи на все товары
														discount = isNaN(discount) ? 0 : discount;
														ret['discount'] = discount;
														
														if(invoicedata.ugmtimeAdd < (Date.parse('2021-11-08') / 1000)){
															var discount_one = discount / goods_count; // скидка для 1 товара
															ret['discount_one'] = discount_one;
															
															var products_discount2 = [];
															for(let i = 0; i < countObj(invoicedata.products||[]); i++){
																var t_discount_one = Math.round(discount_one);
																if(i == countObj(invoicedata.products||[]) - 1){
																	var t_discount = Math.round(discount_one) * countObj(invoicedata.products||[]);
																	if(t_discount > discount){
																		t_discount_one -= Math.abs(discount - t_discount);
																	} else if(t_discount < discount){
																		t_discount_one += discount - t_discount;
																	}
																}
																products_discount2.push(t_discount_one);
															}
															products_discount2.splice(0, invoice_products_returned_count);
															var discount2 = 0;
															for(let i = 0; i < selected_goods_count; i++){
																discount2 += products_discount2[i];
															}
															ret['discount2'] = discount2;
														} else {
															let products_discount2 = [];
															let t_inv_products_amount = [];
															for(let product of invoicedata.products||[]){
																let product_amount_value = (product.amount||{}).value||0;
																let product_discount_value = parseFloat(product.discount||0);
																
																let product_amount_calc = Math.round(product_amount_value - ((product_amount_value / 100) * product_discount_value));
																t_inv_products_amount.push(product_amount_calc);
															}
															let discount_percent = (discount / (invoicedata.amount||{}).value||0) * 100;
															
															let t_sum_discounts = 0;
															let cnt1 = 0;
															for(let amnt of t_inv_products_amount){
																let a_discount_percent = Math.round((amnt / 100) * discount_percent);
																t_sum_discounts += a_discount_percent;
																if(cnt1 == t_inv_products_amount.length - 1){
																	if(t_sum_discounts > discount){
																		a_discount_percent -= Math.abs(discount - t_sum_discounts);
																	} else if(t_sum_discounts < discount){
																		a_discount_percent += discount - t_sum_discounts;
																	}
																}
																products_discount2.push(a_discount_percent);
																cnt1++;
															}
															for(let i = 0; i < invoice_products_returned_pos.length - 1; i++){
																let j = invoice_products_returned_pos[i];
																products_discount2.splice(j, 1);
															}
															//ret['products_discount2'] = products_discount2;
															
															var discount2 = 0;
															dialog.getModalBody().find('.invoice-products .invoice-product-row .panel').each(function(i, el){
																if($(el).hasClass('bg-success')){
																	discount2 += products_discount2[i];
																}
															});
															ret['discount2'] = discount2;
														}
														
														var payments = getFormAddReturnInvoicePayments();
														var amount_cash = 0; // всего наличными
														$.each(payments, function(i, el){
															amount_cash += el.amount.value;
														});
														ret['amount_cash'] = amount_cash;
														
														var amount_full = amount;
														ret['amount_full'] = amount_full;
														
														var amount_paid = amount - discount2;
														ret['amount_paid'] = amount_paid;
														
														var amount_pay = amount_paid;
														ret['amount_pay'] = amount_pay;
														
														var amount_odd = amount_cash - amount_pay;
														ret['amount_odd'] = amount_odd;
														
														return ret;
													}
													
