{% set settings = ioCallAction('app.model.settings.getData', {}).data.0 %}
{% if not settings %}
	{% set settings = {
		enableInvoiceReturnDaysLimit: false,
	} %}
{% endif %}

{% set invoices_limit = 25 %}

{% set deliverymethodslist = ioCallAction(
	'app.model.deliveryMethods.getData', {
		filter: {
			company_pkid: user.accounts[user.account].company_pkid,
			isDeleted: false,
		},
		order: {
			type: 'asc',
		},
		limit: 100000,
	}
).data %}
{% set deliverymethodsoptions = [] %}
{% set deliverymethods_g = {} %}
{% for deliverymethod in deliverymethodslist %}
	{% set deliverymethodsoptions = xadd(deliverymethodsoptions, deliverymethod.pkid, deliverymethod.name~' ('~deliverymethod.amount_value|default(0)~' KZT'~(deliverymethod.method == 'fixedgoodscount' or deliverymethod.method == 'fixedweight' ? ' за '~deliverymethod.step~(deliverymethod.method == 'fixedgoodscount' ? ' шт' : (deliverymethod.method == 'fixedweight' ? ' кг')))~')') %}
	{% set deliverymethods_g = xadd(deliverymethods_g, deliverymethod.pkid, deliverymethod) %}
{% endfor %}
{#v_dump(deliverymethodsoptions)#}

{% set warehouseslist = ioCallAction(
	'app.model.warehouses.getData', {
		company_pkid: user.accounts[user.account].company_pkid,
		filter: {
			type: 1,
		},
		limit: 100000,
	}
).data %}
{% set warehousesoptions = [] %}
{% set warehouses_g = {} %}
{% for warehouse in warehouseslist %}
	{% set warehousesoptions = xadd(warehousesoptions, warehouse.pkid, warehouse.name) %}
	{% set warehouses_g = xadd(warehouses_g, warehouse.pkid, warehouse) %}
{% endfor %}
{#v_dump(warehousesoptions)#}

{% set sizeTypes = ioCallAction(
	'bmc.trade2.model.sizesTypes.getData', {
		limit: 10000,
	}
).data %}
{% set t_sizes = ioCallAction(
	'bmc.trade2.model.sizes.getData', {
		limit: 10000,
	}
).data %}
{% set sizes = [] %}
{% for size in t_sizes %}
	{% set sizes = xadd(sizes, size.pkid, size) %}
{% endfor %}
{% set t_colors = ioCallAction(
	'app.model.colors.getData', {
		order: xadd({}, 'name_'~currentlang, 'asc'),
		limit: 10000,
	}
).data %}
{% set colors = [] %}
{% for color in t_colors %}
	{% set colors = xadd(colors, color.pkid, color) %}
{% endfor %}


{% set checkServiceCrm = ioCallAction(
	'com.model.company.company2.checkServiceByApiName', {
		api_name: 'bmc.crm.client_base',
	}
).checkService|default(false) %}


