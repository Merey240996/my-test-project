							// подсчет цен
							function calcvalues(dialog){
								var ret = [];
								
								var goods_count = dialog.getModalBody().find('.order-products .order-product-row').length||0;
								ret['goods_count'] = goods_count;
								dialog.getModalBody().find('.order-products-overadd-warning').css('display', goods_count > 30 ? '' : 'none');
								
								var priced_goods_count = 0;
								var accepted_goods_count = 0;
								if(goods_count > 0){
									dialog.getModalBody().find('.order-products .order-product-row').each(function(i, el){
										var offer_number = $(el).find('.offer_number').val()||'';
										if(offer_number != ''){
											priced_goods_count++;
										}
										
										var qr_code_creator_number = $(el).find('.qr_code_creator_number').val()||'';
										var qr_code_serial_number = $(el).find('.qr_code_serial_number').val()||'';
										if(qr_code_creator_number != '' && qr_code_serial_number != ''){
											accepted_goods_count++;
										}
									});
								}
								ret['priced_goods_count'] = priced_goods_count;
								ret['accepted_goods_count'] = accepted_goods_count;
								
								var amount = 0; // сумма инвойса
								dialog.getModalBody().find('.order-products .order-product-row').each(function(i, el){
									if($(el).find('.offer_number').val() != ''){
										amount += Math.ceil(parseFloat($.trim($(el).find('.order-product-cost-per-unit').val().replace(/\s+/g, '')))); // стоимость товара с учетом скидки
									}
								});
								ret['amount'] = amount;
								
								// подсчет стоимости доставки
								var amount_delivery = 0;
								var delivery_type = 'fixed';
								if(goods_count > 0){
									var delivery_type = dialog.getModalBody().find('.order-delivery-method :selected').attr('data-type')||'fixed';
									var delivery_amount = parseInt(dialog.getModalBody().find('.order-delivery-method :selected').attr('data-amount'))||0;
									if(!in_array(delivery_type, ['fixed', 'fixedgoodscount', 'fixedweight'])){
										delivery_type = 'fixed';
									}
									if(delivery_type == 'fixed'){
										amount_delivery = delivery_amount;
									} else if(delivery_type == 'fixedgoodscount'){
										var delivery_goodscount = parseInt(dialog.getModalBody().find('.order-delivery-method :selected').attr('data-step'))||1;
										var t_goods_count = goods_count;
										while(t_goods_count > 0){
											t_goods_count -= delivery_goodscount;
											amount_delivery += delivery_amount;
										}
									} else if(delivery_type == 'fixedweight'){
										var delivery_weight = parseFloat(dialog.getModalBody().find('.order-delivery-method :selected').attr('data-step'))||1;
										var goods_weight = 0; // вес продуктов инвойса
										dialog.getModalBody().find('.order-products .order-product-row').each(function(i, el){
											if($(el).find('.qr_code_serial_number').val() != ''){
												goods_weight += parseFloat($.trim($(el).find('.order-product-weight').val()))||0;
											}
										});
										if(goods_weight > 0){
											var t_goods_weight = goods_weight;
											while(t_goods_weight > 0){
												t_goods_weight -= delivery_weight;
												amount_delivery += delivery_amount;
											}
										} else {
											amount_delivery = delivery_amount;
										}
									}
								}
								ret['delivery_type'] = delivery_type;
								ret['amount_delivery'] = amount_delivery;
								
								var currency = dialog.getModalBody().find('.order-currency :selected').val(); // валюта
								ret['currency'] = currency;
								
								var discount = Math.ceil(parseFloat(dialog.getModalBody().find('.order-discount').val())); // скидка
								discount = isNaN(discount) ? 0 : discount;
								
								var discount_type = dialog.getModalBody().find('.order-discount-type :selected').val(); // тип скидки (процент, значение)
								ret['discount_type'] = discount_type;
								
								var payments = getFormEditOrderPayments(true);
								var amount_cash = 0; // всего наличными
								$.each(payments, function(i, el){
									amount_cash += el.amount.value;
								});
								ret['amount_cash'] = amount_cash;
								
								var amount_full = amount + amount_delivery;
								ret['amount_full'] = amount_full;
								
								var discount2 = discount;
								var amount_paid = 0;
								if(discount_type == 'percent'){
									if(discount > 100) discount = discount2 = 100;
									amount_paid = (amount - Math.floor((amount / 100) * discount)) + amount_delivery;
									discount2 = Math.floor((amount / 100) * discount);
								} else if(discount_type == 'value'){
									if(discount > amount_full){
										discount = discount2 = amount_full;
									}
									if(amount_cash > 0 && discount > amount_full - amount_cash){
										discount = discount2 = amount_full - amount_cash;
									}
									amount_paid = (amount - discount) + amount_delivery;
								}
								
								var amount_pay = amount_paid;
								var amount_odd = Math.ceil(amount_cash - amount_pay);
								
								ret['amount_paid'] = amount_paid;
								ret['amount_pay'] = amount_pay;
								ret['amount_odd'] = amount_odd;
								ret['discount'] = discount;
								ret['discount2'] = discount2;
								
								return ret;
							}
							
