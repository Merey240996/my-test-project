<script>
{% set pageInvoicesID = random(999999) %}
jsApplication.pageLoad(function(){
	{% set variable = 'var_'~random(999999) %}
	var {{variable}} = 0;
	var param = '';
	var load = [];
	//load = load.concat(ioGetModuleUrls({module: 'jquery-ui', push: 1}));
	//load = load.concat(ioGetModuleUrls({module: 'jquery-ui-flick', push: 1}));
	//load = load.concat(ioGetModuleUrls({module: 'jquery-blockUI', push: 1}));
	//load = load.concat(ioGetModuleUrls({module: 'bootstrap-tour', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'chosen', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'noty-packaged', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'uploadPreview', push: 1}));
	//load = load.concat(ioGetModuleUrls({module: 'jquery-dragsort', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'jquery-inputmask', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'autosize', push: 1}));
	//load = load.concat(ioGetModuleUrls({module: 'typeahead', version: '0.10.2', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'bootstrap3-typeahead', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'bootstrap-datepicker', push: 1}));
	load = load.concat(ioGetModuleUrls({module: 'sweetalert', push: 1}));
	
	if(jsApplication.busy && load.length > 0){jsApplication.busy(true); {{variable}} = 1;}
	if(load.length > 0){
		yepnope({
			load: load,
			complete: function(){
				if(jsApplication.busy && {{variable}}) jsApplication.busy(false);
				//onBootstrapEditable();
				setTimeout('pageInvoicesReady{{pageInvoicesID}}()', 10);
			},
		});
	} else {
		if(jsApplication.busy && {{variable}}) jsApplication.busy(false);
		setTimeout('pageInvoicesReady{{pageInvoicesID}}()', 10);
	}
});
function pageInvoicesReady{{pageInvoicesID}}(){
	var settings = {{settings|json_encode|raw}};
	var invoices_struct = {{invoices_struct|json_encode|raw}};
	var enum_boolean = {{ioEnum.boolean|json_encode|raw}};
	var enum_invoicesPayments_types = {{ioEnum.invoicesPayments_types|json_encode|raw}};
	var enum_invoicesDocuments_statuses = {{ioEnum.invoicesDocuments_statuses|json_encode|raw}};
	var enum_invoices_types = {{ioEnum.invoices_types|json_encode|raw}};
	var enum_invoices_statuses = {{ioEnum.invoices_statuses|json_encode|raw}};
	var enum_currencies = {{ioEnum.currencies|json_encode|raw}};
	var enum_pay_types = {{ioEnum.pay_types|json_encode|raw}};
	var enum_genders = {{ioEnum.genders|json_encode|raw}};
	var deliverymethodsoptions = {{deliverymethodsoptions|json_encode|raw}};
	var deliverymethods_g = {{deliverymethods_g|json_encode|raw}};
	var warehousesoptions = {{warehousesoptions|json_encode|raw}};
	var enum_offers_types = {{ioEnum.offers_type|json_encode|raw}};
	var warehouses_g = {{warehouses_g|json_encode|raw}};
	var colors = {{colors|json_encode|raw}};
	var sizes = {{sizes|json_encode|raw}};
	var sizeTypes = {{sizeTypes|json_encode|raw}};
	
	// лимит, сортировка
	var invoices_text = '', invoices_sort = {}, invoices_filter = {}, invoices_limit = {{invoices_limit}}, invoices_page = 0, invoices_pages_count = 0;
	
	// поиск
	$(document).on('keyup', '.invoices-search', function(e){
		var $objb = $(this);
		if(e.keyCode === 13){
			invoices_text = $objb.val();
			invoices_page = 0;
			
			invoicesSearch();
		}
	});
	$(document).on('click', '.invoices-search-btn', function(){
		invoices_text = $('.invoices-search').val();
		invoices_page = 0;
		
		invoicesSearch();
	});
	
	// получение статистики
	function loadStatMP(){
		delete invoices_filter['%pkid'];
		delete invoices_filter['%text'];
		if(invoices_text != ''){
			if(invoices_text.substr(0, 5) == 'pkid:'){
				invoices_filter['%pkid'] = invoices_text.substr(5, invoices_text.length);
			} else {
				invoices_filter['%text'] = invoices_text;
			}
		}
		
		$('.invoices-stat').html('<i class="fa fa-spinner fa-spin"></i> {{translate['trade.invoices.stat.loading']}}');
		
		ioCallEntity({
			entity: 'bmc.trade2.model.invoices2.getStat',
			resultType: 'json',
			params: {
				filter: invoices_filter,
			},
			success: function(data){
				var obj;try{obj = $.parseJSON(data);}catch(ex){obj = null;}
				if(obj != null && typeof(obj.res) != 'undefined' && obj.res != null && obj.res.error_code == '1'){
					var invoices_count = obj.res.invoices_count;
					var invoices_sum = obj.res.invoices_sum;
					var invoices_sredn_sum = obj.res.invoices_sredn_sum;
					var clients_sum = obj.res.clients_sum;
					
					$('.invoices-stat').html('{{translate['trade.invoices.stat.text1']}}: '+number_format(invoices_count, 0, '.', ' ')+', {{translate['trade.invoices.stat.text2']}}: '+format_money({value: invoices_sum||0, currency: 'KZT'})+', {{translate['trade.invoices.stat.text3']}}: '+format_money({value: invoices_sredn_sum||0, currency: 'KZT'})+', {{translate['trade.invoices.stat.text4']}}: '+number_format(clients_sum, 0, '.', ' '));
				} else {
					var n = noty({
						text: 'Не удалось получить статистику инвойсов. Попробуйте обновить список.'+(obj != null && obj.res != null && obj.res.error_str != '' ? ' Полный текст ошибки: '+obj.res.error_str : ''),
						type: 'warning',
						layout: 'bottomRight',
						timeout: 4000,
					});
				}
			},
			error: function(tag, jqXHR, textStatus, errorThrown){
				var n = noty({
					text: 'Не удалось получить статистику инвойсов. Попробуйте обновить страницу.',
					type: 'warning',
					layout: 'bottomRight',
					timeout: 3000,
				});
			},
		});
	}
	
	// поиск
	function invoicesSearch(){
		// отображаем панель загрузки
		$('.invoices .panel-loading').css('display', 'block');
		// убираем стандартную иконку, ставим иконку загрузки
		$('.invoices-search-btn i')
			.removeClass('icon-search')
			.addClass('fa fa-spinner fa-spin');
		
		// обрабатываем входные параметры
		var invoices_start = invoices_page > 0 ? invoices_limit * invoices_page : invoices_page;
		
		var sort_cnt = 0;
		$.each(invoices_sort, function(i, el){sort_cnt++});
		if(sort_cnt <= 0){
			invoices_sort = {};
			invoices_sort['ugmtimeAdd'] = 'desc';
			invoices_sort['pkid'] = 'desc';
		}
		
		delete invoices_filter['%pkid'];
		delete invoices_filter['%text'];
		if(invoices_text != ''){
			if(invoices_text.substr(0, 5) == 'pkid:'){
				invoices_filter['%pkid'] = invoices_text.substr(5, invoices_text.length);
			} else {
				invoices_filter['%text'] = invoices_text;
			}
		}
		
		loadStatMP();
		
		// обработка запроса
		ioCallEntity({
			entity: 'app.model.invoices2.getDataMore',
			resultType: 'json',
			params: {
				filter: invoices_filter,
				order: invoices_sort,
				limit: invoices_limit,
				start: invoices_start,
				company: true,
				getPaymentsCount: true,
			},
			success: function(data, tag){
				//console.log(data);
				var obj;try{obj = $.parseJSON(data);}catch(ex){obj = null;}
				if(obj != null && typeof(obj.res) != 'undefined' && obj.res != null && obj.res.error_code == '1'){
					var invoices_count = 0;
					var invoices_ret_count = parseInt(obj.res.count);
					$.each(obj.res.data, function(i, el){
						invoices_count++;
					});
					var invoices_html = '';
					if(invoices_count > 0){
						var invoices_html = ''+
						'<table class="table table-bordered table-hover m-b-none">'+
							'<thead>'+
								'<tr class="text-small">'+
									'<th width="20" style="text-align: center; vertical-align: middle;">'+/*'тип (продажа или возврат)'*/'</th>'+
									'<th width="60" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.number']}}</th>'+
									'<th width="15%" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.warehouse']}}</th>'+
									'<th style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.client']}}</th>'+
									'<th width="70" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.status']}}</th>'+
									'<th width="60" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.isPayed']}}</th>'+
									'<th width="60" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.goodscount']}}</th>'+
									'<th width="15%" style="text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.amounts']}}</th>'+
									'<th width="250" style="min-width: 250px; text-align: center; vertical-align: middle;">{{translate['trade.invoices.table.operations']}}</th>'+
								'</tr>'+
							'</thead>'+
							'<tbody>';
						$.each(obj.res.data, function(i, el){
							invoices_html += ''+
							'<tr class="invoice-row invoice-'+el.pkid+'">'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-type">'+
									'<div title="'+
										(enum_invoices_types[el.type]||'-')+
										'<br/>'+
										'<br/>'+
										'Создано:'+
										'<br/>'+
										(new Date(el.gmtimeAdd)).toString('dd.MM.yyyy HH:mm')+
										'<br/>'+
										'('+el.creator_login+')'+
										(isExists(el.dateSale) ?
											(el.dateSale ?
												'<br/>'+
												'<br/>'+
												(enum_invoices_types[el.type]||'-')+
												'<br/>'+
												ioDate('dd.mm.yyyy HH:MM', el.dateSale, '{{user.timezone|json_encode|raw}}')+
												'<br/>'+
												'('+el.cashier_login+')'
											:'')
										:'')+
										(isExists(el.dateDelivery) ?
											(el.dateDelivery ?
												'<br/>'+
												'<br/>'+
												'Доставка:'+
												'<br/>'+
												ioDate('dd.mm.yyyy HH:MM', el.dateDelivery, '{{user.timezone|json_encode|raw}}')
											:'')
										:'')+
										(isExists(el.referer_login) ?
											(el.referer_login ?
												'<br/>'+
												'<br/>'+
												'Реферер:'+
												'<br/>'+
												el.referer_login
											:'')
										:'')+
										(isExists(el.consultant_login) ?
											(el.consultant_login ?
												'<br/>'+
												'<br/>'+
												'Консультант:'+
												'<br/>'+
												el.consultant_login
											:'')
										:'')+
										'" data-html="true" data-toggle="tooltip" data-placement="right">'+
										'<i class="fa fa-'+(el.type == 0 ? 'dollar' : (el.type == 1 ? 'reply' : 'shopping-cart'))+'"></i>'+
									'</div>'+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-number">'+
									(el.invoice_number||'-')+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-warehouse">'+
									(warehousesoptions[el.warehouse_pkid]||'-')+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-client">'+
									(el.client||'-')+
									(el.client_cardnum ?
										(el.client ? ', ' : '')+
										'карта: '+el.client_cardnum
									:'')+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-status">'+
									(enum_invoices_statuses[el.status]||'-')+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-isPayed">'+
									(enum_boolean[el.isPayed ? 1 : 0]||'нет')+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-products-count">'+
									(el.products_count||0)+
								'</td>'+
								'<td style="vertical-align: middle; text-align: center;" class="invoice-amounts">'+
									format_money(el.amount_paid||{value: 0})+
								'</td>'+
								'<td style="vertical-align: middle;">'+
									'<div class="pull-right" style="margin: 0 -10px 0 0;">'+
										'<div class="btn-group">'+
											'<div class="btn btn-small btn-white invoice-documents-btn" data-invoice-pkid="'+el.pkid+'" data-invoice-number="'+el.invoice_number+'" style="padding-left: 10px; padding-right: 10px;" data-toggle="tooltip" data-placement="left" title="Документы">'+
												'<i class="fa fa-folder-open"></i>'+
											'</div>'+
										'</div>'+
										(el.payments_count > 0 ?
											'<div class="btn-group">'+
												'<a href="'+urlGetAdd('/cabinet/invoices/payments', 'invoice_pkid', el.pkid, 'account', '{{user.account}}', 'lang', '{{currentlang}}')+'" class="btn btn-small btn-white invoice-payments-btn" style="padding-left: 8px; padding-right: 8px;" data-toggle="tooltip" data-placement="left" title="{{translate['trade.invoices.table.btn.invoicespayments']}}">'+
