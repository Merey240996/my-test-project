			var warehouse_pkid = dialog.getModalBody().find('.invoice-warehouse :selected').val();
			var status = dialog.getModalBody().find('.invoice-status :selected').val();
			
			var client_pkid = dialog.getModalBody().find('.invoice-client').val()||'';
			var client_cardnum = dialog.getModalBody().find('.invoice-client-cardnum').val()||'';
			
			var delivery_method = dialog.getModalBody().find('.invoice-delivery-method :selected').val();
			var delivery_info = $.trim(dialog.getModalBody().find('.invoice-delivery-info').val());
			var tracknumber = $.trim(dialog.getModalBody().find('.invoice-tracknumber').val());
			
			// сумма инвойса
			var amount = parseFloat($.trim(dialog.getModalBody().find('.invoice-amount').val()).replace(/\s+/g, ''))||0;
			
			// стоимость доставки
			var amount_delivery = parseFloat($.trim(dialog.getModalBody().find('.invoice-amount-delivery').val()).replace(/\s+/g, ''));
			
			// скидка
			var discount = dialog.getModalBody().find('.invoice-discount').val()||0;
			discount = isNaN(discount) ? 0 : discount;
			// скидка (тип)
			var discount_type = dialog.getModalBody().find('.invoice-discount-type :selected').val();
			
			var amount_cash = 0; // всего наличными
			$.each(payments, function(i, el){
				amount_cash += el.amount.value;
			});
			
			var amount_paid = 0;
			if(discount_type == 'percent'){
				if(discount > 100) discount = 100;
				amount_paid = (amount + amount_delivery) - (((amount + amount_delivery) / 100) * discount);
			} else if(discount_type == 'value'){
				var amount_full = amount + amount_delivery;
				if(discount > amount_full) discount = amount_full;
				amount_paid = (amount + amount_delivery) - discount;
			}
			
			var amount_odd = amount_cash - amount_paid;
			
			// валюта
			var currency = dialog.getModalBody().find('.invoice-currency :selected').val();
			
			var params = {
				event: event,
				consultant_pkid,
