								'<input type="text" class="span12 date-picker text-center date-sale-ot" placeholder="{{(time() - 60 * 60 * 24 * 30)|date('Y-m-d')}}" value="{{(time() - 60 * 60 * 24 * 30)|date('Y-m-d')}}" />'+
							'</div>'+
							'<div class="span4 text-center">'+
								'<input type="text" class="span12 date-picker text-center date-sale-do" placeholder="{{'now'|format_date('Y-m-d')}}" value="{{'now'|format_date('Y-m-d')}}" />'+
							'</div>'+
							'<div class="span4 text-center">'+
								'<div class="btn btn-block btn-small btn-info report-by-cash-search-btn">'+
									'Показать'+
								'</div>'+
							'</div>'+
						'</div>'+
					'</div>'+
				'</div>'+
				'<div class="row-fluid">'+
					'<div class="span12 result-cont">'+
						'<div class="line line-dashed"></div>'+
						'<div class="text-center">'+
							'Выберите дату и нажмите кнопку "Показать"'+
						'</div>'+
					'</div>'+
				'</div>'
			),
			buttons: [
				{
					id: 'cancel-btn',
					label: 'Назад',
					cssClass: 'btn-small btn-white',
					action: function(dialog, event){
						dialog.close();
					},
				}
			],
			onshown: function(dialog){
				dialog.getModalBody().find('input.date-picker').datepicker({
					format: 'yyyy-mm-dd',
					language: 'ru',
					autoclose: true,
				});
				
				// показ отчета по кассам
				dialog.getModalBody().find('.report-by-cash-search-btn').off('click');
				dialog.getModalBody().find('.report-by-cash-search-btn').on('click', function(){
					var date_sale_ot = dialog.getModalBody().find('.date-sale-ot').val();
					var date_sale_do = dialog.getModalBody().find('.date-sale-do').val();
					if(date_sale_ot != ''
					&& date_sale_do != ''){
						dialog.getModalBody().find('.result-cont').html(
							'<div class="line line-dashed"></div>'+
							'<div class="text-center">'+
								'<i class="fa fa-spinner fa-spin"></i> Обработка запроса...'+
							'</div>'
						);
						
						// обработка запроса
						ioCallEntity({
							entity: 'bmc.trade2.model.invoices2.getReportByCash',
							resultType: 'json',
							params: {
								date_ot: date_sale_ot,
								date_do: date_sale_do,
							},
							success: function(data, tag){
								//console.log(data);
								var obj;try{obj = $.parseJSON(data);}catch(ex){obj = null;}
								if(obj != null && typeof(obj.res) != 'undefined' && obj.res != null && obj.res.error_code == '1'){
									var data = obj.res.data;
									
									if(countObj(data) > 0){
										var report_html = '';
										
										var Total = {};
										Total.sale_product_count = 0;
										Total.return_product_count = 0;
										
										var outMoney = function(cur){
											var res = '';
											var br = '';
											for(var currency in cur){
												if(cur.hasOwnProperty(currency)){
													var elem = cur[currency];
													var cl = '';
													if(elem < 0) cl = 'money_negative';
													else if(elem > 0) cl = 'money_positive';
													res += br+'<span class="'+cl+'">'+number_format(elem, 2, '.', ' ')+' '+currency+'</span>';
													br = '<br/>';
												}
											}
											return res;
										}
										var TotalAddMoney = function(field, cur){
											if(!isExists(Total[field])) Total[field] = {};
											for(var currency in cur){
												if(cur.hasOwnProperty(currency)){
													var value = cur[currency];
													if(!isExists(Total[field][currency])) Total[field][currency] = value;
													else Total[field][currency] += value;
												}
											}
										}
										
										var position = 1;
										for(var i in data){
											if(data.hasOwnProperty(i)){
												var e = data[i];
												
												var warehouse = 'Не указан';
												if(isExists(warehouses_g[e.warehouse_pkid])) warehouse = warehouses_g[e.warehouse_pkid].name;
												
												var tr = (
													'<tr>'+
														//'<td>'+position+'</td>'+
														'<td>'+warehouse+'</td>'+
														'<td>'+e.cashier_login+'</td>'
												);
												
												// считаем деньги сумму продажи
												var cur = {};
												for(var j in e.sale_amount_paid){
													if(e.sale_amount_paid.hasOwnProperty(j)){
														var elem = e.sale_amount_paid[j];
														if(isExists(cur[elem.currency])) cur[elem.currency] += parseInt(elem.value);
														else cur[elem.currency] = parseInt(elem.value);
													}
												}
												tr += '<td style="text-align: right;">'+outMoney(cur)+'</td>';
												TotalAddMoney('sale_amount_paid', cur);
												
												// считаем деньги сумму возврата
												var cur = {};
												for(var j in e.return_amount_paid){
													if(e.return_amount_paid.hasOwnProperty(j)){
														var elem = e.return_amount_paid[j];
														if(isExists(cur[elem.currency])) cur[elem.currency] += -parseInt(elem.value);
														else cur[elem.currency] = -parseInt(elem.value);
													}
												}
												tr += '<td style="text-align: right;">'+outMoney(cur)+'</td>';
												TotalAddMoney('return_amount_paid', cur);
												
												// считаем деньги касса
												var cur = {};
												for(var j in e.sale_amount_cash){
													if(e.sale_amount_cash.hasOwnProperty(j)){
														var elem = e.sale_amount_cash[j];
														if(isExists(cur[elem.currency])) cur[elem.currency] += parseInt(elem.value);
														else cur[elem.currency] = parseInt(elem.value);
													}
												}
												for(var j in e.return_amount_cash){
													if(e.return_amount_cash.hasOwnProperty(j)){
														var elem = e.return_amount_cash[j];
														if(isExists(cur[elem.currency])) cur[elem.currency] += parseInt(elem.value);
														else cur[elem.currency] = parseInt(elem.value);
													}
												}
												tr += '<td style="text-align: right;">'+outMoney(cur)+'</td>';
												TotalAddMoney('return_amount_cash', cur);
												
												tr += (
														'<td style="text-align: center;">'+e.sale_product_count+'</td>'+
														'<td style="text-align: center;">'+e.return_product_count+'</td>'+
														'<td style="text-align: center;">'+e.sale_count+'</td>'+
														'<td style="text-align: center;">'+e.return_count+'</td>'+
													'</tr>'
												);
												
												if(!isExists(Total['sale_product_count'])) Total['sale_product_count'] = parseInt(e.sale_product_count);
												else Total['sale_product_count'] += parseInt(e.sale_product_count);
												if(!isExists(Total['return_product_count'])) Total['return_product_count'] = parseInt(e.return_product_count);
												else Total['return_product_count'] += parseInt(e.return_product_count);
												
												if(!isExists(Total['sale_count'])) Total['sale_count'] = parseInt(e.sale_count);
												else Total['sale_count'] += parseInt(e.sale_count);
												if(!isExists(Total['return_count'])) Total['return_count'] = parseInt(e.return_count);
												else Total['return_count'] += parseInt(e.return_count);
												
												report_html += tr;
												
												position++;
											}
										}
										
										// Total
										report_html += (
											'<tr>'+
												//'<td style="text-align: right;" colspan="3"><b>Итого:</b></td>'+
												'<td style="text-align: right;" colspan="2"><b>Итого:</b></td>'+
												'<td style="text-align: right;">'+outMoney(Total.sale_amount_paid)+'</td>'+
												'<td style="text-align: right;">'+outMoney(Total.return_amount_paid)+'</td>'+
												'<td style="text-align: right;">'+outMoney(Total.return_amount_cash)+'</td>'+
												'<td style="text-align: center;">'+Total['sale_product_count']+'</td>'+
												'<td style="text-align: center;">'+Total['return_product_count']+'</td>'+
												'<td style="text-align: center;">'+Total['sale_count']+'</td>'+
												'<td style="text-align: center;">'+Total['return_count']+'</td>'+
											'</tr>'
										);
										
										dialog.getModalBody().find('.result-cont').html(
											'<table class="table report-by-cash-table">'+
												'<tr>'+
													//'<td></td>'+
													'<td class="text-small" style="text-align: center;">Точка продажи</td>'+
													'<td class="text-small" style="text-align: center;" width="10%">Кассир</td>'+
													'<td class="text-small" style="text-align: center;" width="15%">Сумма продажи</td>'+
													'<td class="text-small" style="text-align: center;" width="15%">Сумма возврата</td>'+
													'<td class="text-small" style="text-align: center;" width="15%">Касса</td>'+
													'<td class="text-small" style="text-align: center;" width="10%">Проданных товаров</td>'+
													'<td class="text-small" style="text-align: center;" width="10%">Возвращенных товаров</td>'+
													'<td class="text-small" style="text-align: center;" width="10%">Количество продаж</td>'+
													'<td class="text-small" style="text-align: center;" width="10%">Количество возвратов</td>'+
												'</tr>'+
												report_html+
											'</table>'
										);
									} else {
										dialog.getModalBody().find('.result-cont').html(
											'<div class="line line-dashed"></div>'+
											'<div class="text-center">'+
												'На указанную дату нет данных о продажах и возвратах'+
											'</div>'
										);
									}
								} else {
									var n = noty({
										text: 'Не удалось отобразить отчет по кассам. Попробуйте еще раз.'+(obj != null && obj.res != null && obj.res.error_str != '' ? ' Полный текст ошибки: '+obj.res.error_str : ''),
										type: 'warning',
										layout: 'bottomRight',
										timeout: 4000,
									});
								}
							}
						});
					}
				});
			},
		});
	});
}
</script>
