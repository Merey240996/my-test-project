						} else if(obj.res.error_code == -1000015){
							var n = noty({
								text: 'В одном из платежей, c использованием баланса аккаунта покупателя недостаточно средств для выполнения платежа',
								type: 'warning',
								layout: 'bottomRight',
								timeout: 3000,
							});
						} else if(obj.res.error_code == -1000016){
							var n = noty({
								text: 'Платежи с использованием счетов либо баланса аккаунта возможны только для зарегистрированных клиентов',
								type: 'warning',
								layout: 'bottomRight',
								timeout: 3000,
							});
						} else if(obj.res.error_code == -1000017){
