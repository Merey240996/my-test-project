					function setvalues(){
						var ret = calcvalues(dialog);
						
						// стоимость доставки
						dialog.getModalBody().find('.invoice-amount-delivery').val(ret['amount_delivery']);
						
						// сумма инвойса
						dialog.getModalBody().find('.invoice-amount').val(number_format(ret['amount'], 0, '.', ' '));
						
						// корректировка скидки
						dialog.getModalBody().find('.invoice-discount').val(ret['discount']);
						
						if(ret['discount_type'] == 'percent'){
							dialog.getModalBody().find('.invoice-discount-currency').html('%');
						} else if(ret['discount_type'] == 'value'){
							dialog.getModalBody().find('.invoice-discount-currency').html(ret['currency']);
						}
						
						dialog.getModalBody().find('.invoice-discount2').val(number_format(ret['discount2'], 0, '.', ' ')); // сумма скидки
						
						//dialog.getModalBody().find('.invoice-amount-paid').val(ret['amount_paid'].toFixed(2)); // сумма продажи
						//dialog.getModalBody().find('.invoice-amount-pay').val(ret['amount_pay'].toFixed(2)); // итого к оплате
						//dialog.getModalBody().find('.invoice-amount-odd').val(ret['amount_odd'].toFixed(2)); // нужно внести
						//dialog.getModalBody().find('.invoice-discount2').val(ret['discount2'].toFixed(2)); // сумма скидки
						dialog.getModalBody().find('.invoice-amount-paid').val(number_format(ret['amount_paid'], 0, '.', ' ')); // сумма продажи
						dialog.getModalBody().find('.invoice-amount-pay').val(number_format(ret['amount_pay'], 0, '.', ' ')); // итого к оплате
						dialog.getModalBody().find('.invoice-amount-odd').val(number_format(Math.abs(ret['amount_odd']), 0, '.', ' ')); // нужно внести
						
						if(ret['amount_odd'] < 0){
							dialog.getModalBody().find('.invoice-amount-odd').css('background', '#fcc');
						} else {
							dialog.getModalBody().find('.invoice-amount-odd').css('background', '#fe8');
						}
						if(ret['goods_count'] > 0){
							if($btnAdd) $btnAdd.enable();
						} else {
							if($btnAdd) $btnAdd.disable();
						}
					}
					setvalues();
				},
			});
