		public static function event($event = '', $params = array())
		{
			global $ioData, $ioSession, $ioProjects;
			
			$action = xarr($params, 'action', array());
			$struct = xarr($params, 'struct', array());
			$object = xarr($params, 'object', array());
			$olddata = xarr($params, 'olddata', array());
			$form = xarr($params, 'form', array());
			$p = xarr($params, 'params', array());
			
			$company_pkid = xarr($params, 'company_pkid');
			if($company_pkid == null)
			{
				$company_pkid = xarr($p, 'company_pkid', $ioSession->user->getCompanyID());
			}
			
			if($event == 'init')
			{
				// Check if console
				$is_cli = (php_sapi_name() == 'cli');
				if($is_cli) return EIO_OK;
				
				if($ioSession->user->permission('bmc.trade2.access')
				and $ioSession->user->permission('bmc.trade2.invoice'))
				{
					if(in_array($action, array(
						'actionShowNiceList',
						'actionShowNiceFilter',
						'actionShowNiceFilterField',
						'actionNiceData',
						'actionGetData',
						'actionGetFields',
						'actionShowEdit',
						'actionEdit',
						'actionEditDo',
						'actionGetConsultantStat',
					)))
					{
						return EIO_OK;
					}
					
					if(in_array($action, array(
						'actionAdd',
						'actionAddDo',
						'actionSetConsultant',
						'actionAddConsultant',
						'actionEditConsultant',
						'actionDelete',
						'actionDeleteConsultant',
						'actionDeleteDo',
						'actionEditField',
						'actionShowAdd',
						'actionShowDelete',
					)))
					{
						if($ioSession->user->permission('bmc.trade2.invoice.manage'))
						{
							return EIO_OK;
						}
					}
					
					if(in_array($action, array(
						'actionGetReport',
						'actionGetReportByCash',
						'actionShowGetReportByCash',
					)))
					{
						//if($ioSession->user->permission('bmc.trade2.getReport'))
						//{
							return EIO_OK;
						//}
					}
				}
				if(!$ioSession->user->isGuest())
				{
					if(in_array($action, array(
						'actionAddFromBasket',
						'actionAddBuyer',
						'actionDeleteClient',
						'actionGetData2',
						'actionGetData2More',
						'actionGetData3',
						'actionSetHide',
						//'actionGetRefererStat',
					)))
					{
						return EIO_OK;
					}
				}
				if(in_array($action, array(
					'actionAddTerminal',
					'actionEditTerminal',
					'actionCancelTerminal',
					'actionGetData3',
					'actionSetType',
				)))
				{
					return EIO_OK;
				}
				return EIO_NOPERMISSIONS;
			}
			
			/*
				invoice type:
				0 => 'Создан покупателем',
				1 => 'Акцептован покупателем',
				2 => 'Акцептован продавцом',
				3 => 'Оплачен покупателем',
				4 => 'Доставлен покупателю',
				11 => 'Возврат создан',
				12 => 'Возврат совершен',
			*/
			elseif($event == 'add_pre' or $event == 'edit_pre')
			{
				if($event == 'add_pre')
				{
					$form_event = xarr($p, 'form_event');
					$object->company_pkid = $ioSession->user->getCompanyID();
					$object->creator_pkid = $ioSession->user->id;
					$object->creator_login = $ioSession->user->login;
					$object->type = 0;
					$object->status = 0;
				}
				
				$do_sale = false;
				$do_delivery = false;
				
				// изменяем значения status (ранее type)
				$form_event = xarr($p, 'form_event');
				if(xarr($object, 'type') == null)
				{
					$object->type = 0;
				}
				if(xarr($object, 'status') == null)
				{
					$object->status = 0;
				}
				
				if($ioSession->user->permission('bmc.trade2.invoice.manage'))
				{
					if(!xarr($object, 'isPayed', false) and in_array(xarr($object, 'status'), array(0, 1, 2, 3, 4, 5, 6)))
					{
						$form_event = xarr($p, 'form_event');
						$client_pkid = xarr($p, 'client_pkid');
						if(strpos($client_pkid, 'crm_') === 0)
						{
							$object->client_pkid = null;
							$crm_client_pkid = intval(substr($client_pkid, 4));
							if($crm_client_pkid != 0)
							{
								$object->client_pkid = $client_pkid;
							}
						}
						elseif(strpos($client_pkid, 'user_') === 0)
						{
							$object->client_pkid = null;
							$user_client_pkid = intval(substr($client_pkid, 5));
							if($user_client_pkid != 0)
							{
								$object->client_pkid = $client_pkid;
							}
						}
						
						$warehouse_pkid = xarr($p, 'warehouse_pkid');
						$object->warehouse_pkid = $warehouse_pkid;
					}
				}
				if(in_array(xarr($object, 'status'), array(0, 1, 2, 3, 4, 5, 6, 7)))
				{
					if($ioSession->user->permission('bmc.trade2.invoice.items.add'))
					{
						$products = xarr($p, 'products');
						$object->products = $products;
					}
					if(!xarr($object, 'isPayed', false))
					{
						if($ioSession->user->permission('bmc.trade2.invoice.sale'))
						{
							$currency = xarr($p, 'currency');
							
							// общая сумма товаров, которая вычисляется по предложениям (без учета доставки, общей скидки и аванса)
							$amount = xarr($p, 'amount');
							$amount_value = xarr($amount, 'value');
							$object->amount = $amount;
							
							// стоимость доставки (скидка на доставку не действует)
							$amount_delivery = xarr($p, 'amount_delivery');
							$amount_delivery_value = xarr($amount_delivery, 'value');
							$object->amount_delivery = $amount_delivery;
							
							// сумма внесенного аванса (предоплата)
							/*$prepayment = xarr($p, 'prepayment');
							$prepayment_value = xarr($prepayment, 'value');
							$object->prepayment = $prepayment;*/
							
							// сумма инвойса (за которую были куплены товары + доставка + скидка + аванс)
							$amount_paid = xarr($p, 'amount_paid'); // сумма продажи
							$amount_paid_value = xarr($amount_paid, 'value');
							$object->amount_paid = $amount_paid;
							
							// сумма наличных (сколько денег дал клиент. например товар стоит 85, клиент дал 100, тогда в этом поле будет 100)
							$amount_cash = xarr($p, 'amount_cash'); // сумма наличными
							$amount_cash_value = xarr($amount_cash, 'value');
							$object->amount_cash = $amount_cash;
							
							if($amount_paid_value == 'NaN') $amount_paid_value = $amount_value + $amount_delivery_value;
							
							// раcсчитываем скидку
							$discount = ($amount_value + $amount_delivery_value) - $amount_paid_value; 
							$object->discount = array(
								'currency' => xarr($amount_cash, 'currency'),
								'value' => $discount,
								'pay_type' => null,
							);
						}
					}
				}
				
				if($form_event == 'form_accept_and_close')
				{
					$object->status = 2;
					
					// уведомление клиента по телеграму
					/*if(strpos(xarr($object, 'client_pkid', ''), 'user_') === 0)
					{
						$client_user_login = substr(xarr($object, 'client_pkid', ''), 5);
						$sendTelegram = IOCore::callAction(
