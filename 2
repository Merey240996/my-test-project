						{
							$sendEmail = IOCore::callAction(
								'com.notice.model.notices.sendOnlyEmail',
								array(
									'type' => 0, // тип уведомления (0: по умолчанию, 1: информация, 2: предупреждение, 3: ошибка)
									'cat' => 0, // 0=bell, 1=billhorn, 2=coin1, 3=coin2, 4=webinar, 5=webinar2
