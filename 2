									'Ваш интернет-заказ № "'.xarr($object, 'invoice_number', '???').'" сменил статус на "Акцептован продавцом".'."\n".
									'Заказ теперь можно оплачивать.'."\n".
									'https:'.xarr($ioProjects, 'com').'/profile/goods/orders'."\n\n".
									'Спасибо.',
								),
							)
						);
