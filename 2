		// for estol, terminal, tablo
		// создание инвойса через терминал
		public static function doAddTerminal($result, $params)
		{
			$pay_type = intval(xarr($params, 'pay_type', 1));
			$cashier = xarr($params, 'cashier', false);
			$user_pkid = xarr($params, 'user_pkid');
			$user_login = xarr($params, 'user_login');
			$company_pkid = xarr($params, 'company_pkid');
			$t_products = xarr($params, 'products', array());
			
			if($user_pkid == null or $user_pkid == '')
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Не указан user_pkid';
				goto __exit;
			}
			if($user_login == null or $user_login == '')
			{
				$result->error_code = EIO_USER - 2;
				$result->error_str = 'Не указан user_login';
				goto __exit;
			}
			if($company_pkid == null or $company_pkid == '')
			{
				$result->error_code = EIO_USER - 3;
				$result->error_str = 'Не указан pkid компании';
				goto __exit;
			}
			if($pay_type == null or $pay_type == '' or ($pay_type != 1 and $pay_type != 2))
			{
				$result->error_code = EIO_USER - 4;
				$result->error_str = 'Не указан либо некорректно указан pay_type';
				goto __exit;
			}
			
			$amount = 0;
			$products = array();
			$products_tids = array();
			foreach($t_products as $product)
			{
				$product_tid = xarr($product, 'tid');
				$product_offernum = xarr($product, 'offernum');
				
				$rproductoffer = IOCore::call(
					'app.class.offers.dbsearch2',
					array(
						'filter' => array(
							'tid' => $product_tid,
							'offer_number' => $product_offernum,
							'type' => 2, // розничное
						),
						'limit' => 1,
						'out' => 'array',
					)
				);
				$resproductoffer = xarr($rproductoffer, 'res', array());
				$productoffer = array_shift($resproductoffer);
				$productofferparams = xarr($productoffer, 'parameters', array());
				$productoffer_cost_per_unit = null;
				foreach($productofferparams as $param)
				{
					$param_color_pkid = xarr($param, 'color_pkid');
					$param_size_pkid = xarr($param, 'size_pkid');
					if($param_color_pkid == 0 and $param_size_pkid == 0)
					{
						$productoffer_cost_per_unit = xarr($param, 'cost_per_unit');
						break;
					}
				}
				
				$products[] = array_merge(
					$product, array(
						//'tid' => 'GKZ1C207', // акцептованнный ИНТ товара
						'size_pkid' => 0,
						'color_pkid' => 0,
						'gender_pkid' => 0,
						'amount' => $productoffer_cost_per_unit, // цена за единицу
						
						'discount' => 0, // скидка в процентах
						'isDeleted' => false, // был ли возврат товара?
						
						'offer_name' => xarr($productoffer, 'name', ''),
						'offer_number' => $product_offernum,
						
						// если не null то товары были акцептованы
						'qr_code_creator_number' => null, // создатель QR кода (номер)
						'qr_code_serial_number' => null, // серийный номер продукта
						'qr_code_type' => null, // серийный номер продукта
						
						// значения устанавливаются в момент продажи
						//'qr_code_count_si' => 1, // количество товара в СИ
						//'qr_code_si' => 1, // ед. измерения
					)
				);
				if(!in_array($product_tid, $products_tids))
				{
					$products_tids[] = $product_tid;
				}
				
				// считаем сумму
				$amount += xarr($productoffer_cost_per_unit, 'value', 0);
			}
			unset($t_products);
			//$amount += $amount_delivery;
			
			// проверка на наличие баланса если выбран расчет через баланс
			if($pay_type == 2)
			{
				$balance = IOCore::callAction(
					'com.model.user.getBalance',
					array(
						'user_pkid' => $user_pkid,
					)
				);
				$balance = xarr($balance, 'balance', 0);
				
				if($balance < $amount)
				{
					$result->error_code = EIO_USER - 5;
					$result->error_str = 'Недостаточно средств на балансе аккаунта';
					goto __exit;
				}
			}
			
			$c = IOCore::Instance('app.class.invoices');
			$c->assign_arr(
				array(
					'company_pkid' => $company_pkid,
					'client_phone' => '',
					'creator_pkid' => $user_pkid,
					'creator_login' => $user_login,
					'products' => $products,
					
					// клиент user_<login> - логин пользователя; company_<pkid> - pkid компании; crm_<pkid> - pkid записи из CRM; text_<ФИО> - незарегистрированный пользователь;
					'client_pkid' => 'user_'.$user_login,
					
					// статус инвойса (ранее "тип", хз почему)
					// 0-создан, 1-акцептован клиентом, 2-акцептован продавцом, 3-оплачен, 4-доставлен, 5-комплектуется, 6-доставляется
					// тип инвойса (ioEnum.invoices_types)
					'type' => 0, // продажа
					
					// статус инвойса
					'status' => 2,
					
					// оплачен ли инвойс
					'isPayed' => ($cashier ? true : (($pay_type == 2) ? true : false)),
					'dateSale' => ($cashier ? time() : (($pay_type == 2) ? time() : null)),
					
					// массив из акцептованных ИНТ товаров
					'products_tids' => $products_tids,
					
					// количество продуктов
					'products_count' => count($products),
					
					// общая сумма товаров, которая вычисляется по предложениям
					'amount' => array(
						'value' => $amount,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),
					
					// информация о доставке
					'delivery_info' => array(),
					
					// стоимость доставки
					'amount_delivery' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),
					
					// сумма за которую были куплены товары
					'amount_paid' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),
					// сумма наличных
					'amount_cash' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),
					// сумма скидки
					'discount' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),
					// сумма аванса
					/*'prepayment' => array(
						'value' => 0,
						'currency' =>  'KZT',
						'pay_type' => 1,
					),*/
					
					// дата продажи
					//'dateSale' => iogetdbtimeutc_rfc822(time()),
				)
			);
			$c->create();
			if(xarr($c, 'error_code', EIO_FALSE) != EIO_OK)
			{
				$result->error_code = xarr($c, 'error_code', EIO_FALSE);
				$result->error_str = xarr($c, 'error_str', '');
				goto __exit;
			}
			
			if($pay_type == 2)
			{
				$transactPay = IOCore::callAction(
					'com.model.cabinet.buyorders.addPay',
					array(
						'type' => 2, // 1: пополнение, 2: списание
						'uslugs' => array(
							array(
								'name' => 'Оплата заказа №'.xarr($c, 'invoice_number').' в школьной столовой',
								'count' => 1,
								'price' => $amount,
							),
						),
						'place' => 'Баланс аккаунта',
						'user_pkid' => $user_pkid,
						'user_login' => $user_login,
					)
				);
				if(xarr($transactPay, 'error_code', EIO_FALSE) != EIO_OK)
				{
					$c->isPayed = false;
					$c->dateSale = null;
					$c->update();
					
					$result->error_code = xarr($transactPay, 'error_code', EIO_FALSE);
					$result->error_str = xarr($transactPay, 'error_str', '');
					goto __exit;
				}
			}
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
