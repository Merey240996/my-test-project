				if($product_discount != null and $product_discount != '')
				{
					$fullcost += ($product_cost_per_unit - (($product_cost_per_unit / 100) * $product_discount));
				}
				else
				{
					$fullcost += $product_cost_per_unit;
				}
			}
			$c->amount = array(
				'currency' => 'KZT',
				'value' => $fullcost,
				'pay_type' => null,
			);
			$c->create();
			
			$result->pkid = xarr($c, 'pkid');
			
			$result->error_code = xarr($c, 'error_code');
			$result->error_str = xarr($c, 'error_str');
			
			__exit:
			return $result;
		}
		
		// скрытие заказа клиентом
		public static function doSetHide($result, $params)
		{
			global $ioSession;
			
			$pkid = xarr($params, 'pkid');
			
			if($pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid инвойса';
				goto __exit;
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'client_pkid' => 'user_'.$ioSession->user->login,
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$obj = array_shift($res);
			if($obj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			
			$obj->isHide = true;
			$obj->update();
			
			$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
			$result->error_str = xarr($obj, 'error_str', '');
			
			__exit:
			return $result;
		}
	}
