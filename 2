		public static function doGetData2($result, $params)
		{
			$result->res = null;
			$result->cursor = null;
			
			$p = call_user_func_array(array(get_called_class(), 'params'), array($params));
			$class = xarr($p, 'class', '');
			
			$order = xarr($params, 'order', array(
				'ugmtimeAdd' => 'desc',
			));
			$filter = xarr($params, 'filter');
			$start = intval(xarr($params, 'start', xarr($p, 'start', 0)));
			$limit = intval(xarr($params, 'limit', xarr($p, 'limit', self::$__defaultLimit)));
			$curout = xarr($params, 'cursor', 0);
			if($limit <= 0 or $limit > self::$__maxLimit)
			{
				$limit = self::$__maxLimit;
			}
			
			$res = IOCore::call(
				$class.'.dbsearch2',
				array(
					'out' => 'array',
					'filter' => $filter,
					'limit' => $limit,
					'start' => $start,
					'order' => $order,
					'cursor' => $curout,
					//'explain' => 1,
				),
				null,
				array(
					'params' => $params,
				)
			);
			
			if($curout == 0)
			{
				$result->res = xarr($res, 'res', array());
			}
			else
			{
				$result->cursor = xarr($res, 'cursor');
			}
			
			$result->limit = $limit;
			$result->start = $start;
			$result->filter = $filter;
			$result->order = $order;
			$result->count = xarr($res, 'count', 0);
			$result->error_code = xarr($res, 'error_code');
			$result->error_str = xarr($res, 'error_str');
			$result->db_time = xarr($res, 'time');
			$result->explain = xarr($res, 'explain');
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
		public static function doGetData2More($result, $params)
		{
			global $ioEnum;
			
			$getPayments = xarr($params, 'getPayments', false); // получать историю платежей к инвойсам?
			$getDocuments = xarr($params, 'getDocuments', false); // получать документы инвойсов?
			
			$result = self::doGetData2($result, $params);
			
			$data = xarr($result, 'res', array());
			unset($result->res);
			
			// собираем pkid цветов и размеров, предложений, методов доставки, точек самовывоза
			$offers_numbers = array();
			$colors_pkids = array();
			$sizes_pkids = array();
			$sizetypes_pkids = array();
			$delivery_methods = array();
			$delivery_warehouses_pkids = array();
			foreach($data as $item)
			{
				$products = xarr($item, 'products', array());
				foreach($products as $product)
				{
					$color_pkid = xarr($product, 'color_pkid');
					if($color_pkid != null
					and $color_pkid != 0
					and !in_array($color_pkid, $colors_pkids))
					{
						$colors_pkids[] = $color_pkid;
					}
					
					$size_pkid = xarr($product, 'size_pkid');
					if($size_pkid != null
					and $size_pkid != 0
					and !in_array($size_pkid, $sizes_pkids))
					{
						$sizes_pkids[] = $size_pkid;
					}
					
					$offer_number = xarr($product, 'offer_number');
					if($offer_number != null and !in_array($offer_number, $offers_numbers))
					{
						$offers_numbers[] = $offer_number;
					}
				}
				
				$warehouse_pkid = xarr($item, 'warehouse_pkid');
				if($warehouse_pkid != null and !in_array($warehouse_pkid, $delivery_warehouses_pkids))
				{
					$delivery_warehouses_pkids[] = $warehouse_pkid;
				}
				
				$delivery_method = xarr($item, 'delivery_method');
				if($delivery_method != null and !in_array($delivery_method, $delivery_methods))
				{
					$delivery_methods[] = $delivery_method;
				}
			}
			
			// получение цветов
			$rcolors = IOCore::call(
				'app.class.colors.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $colors_pkids,
						'isDeleted' => false,
					),
					'limit' => count($colors_pkids),
					'out' => 'array',
				)
			);
			$rescolors = xarr($rcolors, 'res', array());
			$colors = array();
			foreach($rescolors as $color)
			{
				$color_pkid = xarr($color, 'pkid');
				$colors[$color_pkid] = $color;
			}
			unset($rescolors);
			
			// получение размеров
			$rsizes = IOCore::call(
				'app.class.sizes.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $sizes_pkids,
						'isDeleted' => false,
					),
					'limit' => count($sizes_pkids),
					'out' => 'array',
				)
			);
			$ressizes = xarr($rsizes, 'res', array());
			$sizes = array();
			foreach($ressizes as $size)
			{
				$size_pkid = xarr($size, 'pkid');
				$sizes[$size_pkid] = $size;
				
				$size_type_pkid = xarr($size, 'size_type');
				if($size_type_pkid != null)
				{
					if(!in_array($size_type_pkid, $sizetypes_pkids))
