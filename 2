		// изменение статуса инвойса через комплектовщика или терминал
		public static function doSetType($result, $params)
		{
			global $ioSession;
			
			$pkid = xarr($params, 'pkid');
			$type = xarr($params, 'type');
			
			if($pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid';
				goto __exit;
			}
			if(!in_array($type, array(6, 5, 4, 3)))
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Некорректный тип инвойса';
				goto __exit;
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$obj = array_shift($res);
			if($obj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			
			if($type == 3)
			{
				$obj->cashier_pkid = $ioSession->user->id;
				$obj->cashier_login = $ioSession->user->login;
			}
			if($type == 6)
			{
				$obj->picker_pkid = $ioSession->user->id;
				$obj->picker_login = $ioSession->user->login;
			}
			$obj->type = $type;
			$obj->update();
			
			$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
			$result->error_str = xarr($obj, 'error_str', '');
			
			__exit:
			return $result;
		}
		
