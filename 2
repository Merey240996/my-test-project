				if($form_event == 'form_sale_and_close')
				{
					if(xarr($object, 'isPayed', false))
					{
						$object->error_str = 'Продажа уже оформлена';
						return EIO_UNKNOWN;
					}
					// можно продавать пользователю
					if($ioSession->user->permission('bmc.trade2.invoice.sale'))
					{
						if(!xarr($object, 'isPayed', false))
						{
							if(xarr($object, 'status', 0) < 2)
							{
								$object->status = 2;
