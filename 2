		// изменение консультанта инвойса
		public static function doSetConsultant($result, $params)
		{
			global $ioSession;
			
			$pkid = xarr($params, 'pkid');
			$consultant_pkid = xarr($params, 'consultant_pkid', $ioSession->user->id);
			$consultant_login = xarr($params, 'consultant_login', $ioSession->user->login);
			
			if($pkid == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Не указан pkid инвойса';
				goto __exit;
			}
			
			$r = IOCore::call(
				'app.class.invoices.dbsearch2',
				array(
					'filter' => array(
						'pkid' => $pkid,
						'isDeleted' => false,
					),
					'limit' => 1,
				)
			);
			$res = xarr($r, 'res', array());
			$obj = array_shift($res);
			if($obj == null)
			{
				$result->error_code = EIO_NOTFOUND_OBJECT;
				$result->error_str = 'Инвойс не найден';
				goto __exit;
			}
			if(xarr($obj, 'company_pkid') != $ioSession->user->getCompanyID())
			{
				$result->error_code = EIO_USER - 1;
				$result->error_str = 'Вы не можете изменить консультанта инвойса чужой компании';
				goto __exit;
			}
			//if(xarr($obj, 'type') > 2)
			if(xarr($obj, 'status') > 7 or xarr($obj, 'isPayed', false))
			{
				$result->error_code = EIO_USER - 2;
				$result->error_str = 'Вы не можете изменить консультанта инвойса, так как уже была оформлена продажа либо доставка';
				goto __exit;
			}
			if(xarr($obj, 'consultant_pkid') != $consultant_pkid
			or xarr($obj, 'consultant_login') != $consultant_login)
			{
				// сохранение изменений
				$obj->consultant_pkid = $consultant_pkid;
				$obj->consultant_login = $consultant_login;
				$obj->update();
				$result->error_code = xarr($obj, 'error_code', EIO_FALSE);
				$result->error_str = xarr($obj, 'error_str', '');
				goto __exit;
			}
			
			$result->pkid = $pkid;
			
			$result->error_code = EIO_OK;
			__exit:
			return $result;
		}
		
