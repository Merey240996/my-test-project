	// Поиск проданного/оформленного инвойса по номеру для оформления
	// возврата — зеркало showSelectInvoice()/invoiceReturnShowAdd() из
	// invoices.html: ищем среди продаж (0) и заказов (2), затем сразу
	// дотягиваем полный состав (products/payments) через doDetails.
	async findInvoiceForReturn(invoiceNumber) {
		const list = await this.getInvoices({ invoice_number: invoiceNumber, type: [0, 2] }, 0, 1, '');
		if (list.error_code !== 1 || !list.items || !list.items.length) {
			return list;
		}
		return this.getInvoiceDetails(list.items[0].pkid);
	}

