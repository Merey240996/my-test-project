	// ---- Client custom field files (поля типа "Изображение"/"Файл" в CustomerModal) ----

	// Бинарный файл нельзя передать через params (это JSON) — шлём через
	// form: FormData, ioCallAction сам определяет multipart/form-data по нему.
	// clientPkid может быть 0/null, если клиент ещё не создан — файл всё равно
	// заливается и привязывается к клиенту позже через сохранение customFields.
	async uploadClientFieldFile(companyPkid, clientPkid, fieldPkid, file, onUploadProgress) {
		const formData = new FormData();
		formData.append('file', file);

		const response = await lib.ioCallAction({
			entity: 'crm.api.clientFieldValues.uploadFile',
			// form отвечает за сам файл (бинарь нельзя передать через params — это JSON),
			// а обычные скаляры по-прежнему идут через params, как и во всех остальных вызовах
			params: {
				company_pkid: companyPkid,
				client_pkid: clientPkid || 0,
				field_pkid: fieldPkid,
			},
			form: formData,
			onUploadProgress,
		});
		return response; // { error_code, error_str, fileName, filePath, url }
	}

