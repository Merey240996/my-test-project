	/**
	 * Set app lang
	 */
	setLang(lang) {
		// Установка для i18n
		this.i18n.global.locale = lang;
		
		// Установка для Day.js (глобально)
		dayjs.locale(lang); 
	
		// Остальное
		axios.defaults.headers.common["Accept-Language"] = lang;
		document.querySelector("html").setAttribute("lang", lang);
		return lang;
	}
	
