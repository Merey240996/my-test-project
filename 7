		kanbanColumns: {
			get() {
				return this.stages.map(s => ({
					id: 'stage_' + s.pkid,
					label: s.name,
					lead_stage_pkid: s.pkid,
					color: '#94a3b8',
				}));
			},
			set(newColumns) {
				this.reorderKanbanColumns(newColumns);
			},
		},
		filteredRows() {
			return this.table ? this.table.getRowModel().rows : [];
		},
		qualifiedStats() {
			if (this.statsData?.qualified) {
				return {
					count: Number(this.statsData.qualified.count) || 0,
					sum: Number(this.statsData.qualified.sum) || 0,
				};
			}
			return { count: 0, sum: 0 };
		},
		inProgressStats() {
			if (this.statsData?.inProgress) return this.statsData.inProgress;
			return { count: 0, sum: 0 };
		},
		lostStats() {
			return this.statsData?.lost ?? { count: 0, sum: 0 };
		},
		topSource() {
			if (this.statsData?.topSource) {
				return {
					label: this.sourceLabel(this.statsData.topSource.source),
					pct: this.statsData.topSource.pct,
				};
			}
			return { label: '—', pct: 0 };
		},
		currentSourceStats() {
			const dist = this.statsData?.sourceDistribution ?? {};
			const total = Object.values(dist).reduce((a, c) => a + c, 0) || 1;
			const palette = ['#6366f1', '#0ea5e9', '#f59e0b', '#94a3b8', '#10b981', '#ef4444'];
			return Object.entries(dist).map(([value, count], i) => ({
				label: this.sourceLabel(Number(value)),
				value: Math.round((count / total) * 100),
				hex: palette[i % palette.length],
			}));
		},
		currentFunnelStages() {
			const dist = this.statsData?.funnelStages ?? {};
			const total = Object.values(dist).reduce((a, c) => a + c, 0) || 1;
			return this.stages.map(s => {
				const count = dist[s.pkid] || 0;
				return { label: s.name, count, pct: Math.round((count / total) * 100), color: '#3b82f6' };
			});
		},
		currentStallFactors() {
			if (this.statsData?.topStall) {
				return [{
					label: this.sourceLabel(this.statsData.topStall.source),
					pct: this.statsData.topStall.pct,
					count: this.statsData.topStall.count,
				}];
			}
			return [{ label: 'Нет данных', pct: 0, count: 0 }];
		},
		leadStructure() {
			return [
				{ label: 'Квалифицирован', color: '#10b981', sum: this.qualifiedStats.sum },
				{ label: 'Новый', color: '#3b82f6', sum: this.statsData?.byStatusSum?.[0] ?? 0 },
				{ label: 'Отказ', color: '#ef4444', sum: this.lostStats.sum },
			];
		},
		avgLead() {
			return this.statsData?.avgAmount ?? 0;
		},
		conversionRate() {
			const total = this.statsData?.totalCount ?? this.totalLeads;
			return total ? Math.round((this.qualifiedStats.count / total) * 100) : 0;
		},
		donutSeries() {
			const series = this.leadStructure.map(s => Number(s.sum) || 0);
			return series.some(v => v > 0) ? series : [1];
		},
		donutChartOptions() {
			const hasData = this.leadStructure.some(s => s.sum > 0);
			return {
				chart: { type: 'donut', toolbar: { show: false } },
				labels: hasData ? this.leadStructure.map(s => s.label) : ['Нет данных'],
				colors: hasData ? this.leadStructure.map(s => s.color) : ['#e2e8f0'],
				plotOptions: { pie: { donut: { size: '70%' }, expandOnClick: false } },
				dataLabels: { enabled: false },
				legend: { show: false },
				stroke: { width: 0 },
				tooltip: {
					enabled: hasData,
					y: { formatter: (v) => v.toLocaleString('ru-RU') + ' ₸' },
				},
			};
		},
		monthlySeries() {
			const monthly = this.statsData?.monthlyDynamics ?? { values: [] };
			return [{ name: 'Лиды', data: monthly.values }];
		},
		monthlyChartOptions() {
			const monthly = this.statsData?.monthlyDynamics ?? { categories: [] };
			return {
				chart: { type: 'bar', toolbar: { show: false }, animations: { enabled: true, easing: 'easeinout', speed: 500 } },
				xaxis: { categories: monthly.categories },
				colors: ['#10b981'],
				plotOptions: { bar: { borderRadius: 6, columnWidth: '50%' } },
				dataLabels: { enabled: false },
				grid: { borderColor: '#f1f5f9' },
				yaxis: { labels: { formatter: (v) => Math.round(v) + ' шт.' } },
				tooltip: { y: { formatter: (v) => v + ' лидов' } },
			};
		},
	},

	watch: {
		globalFilter(val) {
			this.pagination.pageIndex = 0;
			this.debouncedLoadLeads();
		},
		activeView(newVal) {
			if (newVal === 'kanban' && this.leadsData.length === 0) {
				this.loadLeads();
			}
		},
	},

	created() {
		// console.log(this.appSettings.ioEnum['lead_statuses']);
		const self = this;
		this.table = useVueTable({
			get data() { return self.leadsData; },
			columns,
			enableRowSelection: true,
			manualPagination: true,
			manualFiltering: true,
			get pageCount() {
				return Math.ceil(self.totalLeads / self.pagination.pageSize) || 1;
			},
			state: {
				get globalFilter() { return self.globalFilter; },
				get columnFilters() { return self.columnFilters; },
				get sorting() { return self.sorting; },
				get pagination() { return self.pagination; },
				get rowSelection() { return self.rowSelection; },
			},
			onRowSelectionChange: (updater) => {
				self.rowSelection = typeof updater === 'function' ? updater(self.rowSelection) : updater;
			},
			onGlobalFilterChange: (updater) => {
				self.globalFilter = typeof updater === 'function' ? updater(self.globalFilter) : updater;
			},
			onColumnFiltersChange: (updater) => {
				self.columnFilters = typeof updater === 'function' ? updater(self.columnFilters) : updater;
				self.pagination.pageIndex = 0;
				self.loadLeads();
			},
			onSortingChange: (updater) => {
				self.sorting = typeof updater === 'function' ? updater(self.sorting) : updater;
				self.loadLeads();
			},
			onPaginationChange: (updater) => {
				self.pagination = typeof updater === 'function' ? updater(self.pagination) : updater;
				self.loadLeads();
			},
			getCoreRowModel: getCoreRowModel(),
			getFilteredRowModel: getFilteredRowModel(),
			getSortedRowModel: getSortedRowModel(),
			getFacetedRowModel: getFacetedRowModel(),
			getFacetedUniqueValues: getFacetedUniqueValues(),
			getPaginationRowModel: getPaginationRowModel(),
			meta: {
				deleteRow: (row) => { this.openDeleteOne(row.original); },
				deleteRows: (rows) => { this.openDeleteMany(rows); },
			},
		});
	},

	async mounted() {
		await this.loadFunnels();
		await Promise.all([
			this.loadEnums(),
			this.loadStages(),
			this.loadLeads(),
			this.loadStats(), 
			this.loadManagers(), 
			this.loadCanDelete(),
		]);

		const leadId = this.$route.query.leadId;
		if (leadId) {
			await this.openLeadById(Number(leadId));
		}

		this.resizeObserver = new ResizeObserver((entries) => {
			for (const entry of entries) {
				if (entry.target === this.$refs.theadRef) {
					this.theadHeight = entry.contentRect.height;
				}
			}
		});
		if (this.$refs.theadRef) {
			this.resizeObserver.observe(this.$refs.theadRef);
		}

		this.pageLoading = false;
	},

	beforeUnmount() {
		if (this.resizeObserver) {
			this.resizeObserver.disconnect();
		}
	},

	methods: {
		async openCreateLead() {
			if (this.isCreatingLead) return;
			this.isCreatingLead = true;
			try {
				await this.$refs.leadModal.open();
			} finally {
				this.isCreatingLead = false;
			}
		},

		// Подписи статусов/источников лида — с бэка (crm.api.enum.leadStatusLabels
		// / crm.api.enum.leadSourceLabels). Статичны на время сессии, грузим
		// один раз при монтировании страницы.
		async loadEnums() {
			try {
				const [statusData, sourceData, entityTypesData] = await Promise.all([
					this.mfModel.getLeadStatusLabels(),
					this.mfModel.getLeadSourceLabels(),
					this.mfModel.getEntityTypes(),
				]);
				if (statusData.error_code === 1) {
					this.statusLabels = statusData.statusLabels || {};
				}
				if (sourceData.error_code === 1) {
					this.sourceLabels = sourceData.sourceLabels || {};
				}
				if (entityTypesData.error_code === 1) {
					this.entityTypes = {
						lead: entityTypesData.lead,
						deal: entityTypesData.deal,
						order: entityTypesData.order,
						client: entityTypesData.client,
					};
				}
			} catch (e) {
				console.error(e);
			}
		},

		async loadCanDelete() {
			try {
				const data = await this.mfModel.canDeleteLead(this.companyPkid);
				this.canDelete = data.error_code === 1 && !!data.canDelete;
			} catch (e) {
				console.error(e);
				this.canDelete = false;
			}
		},
		
		openDeleteOne(lead) {
			this.pendingDeleteIds = [lead.id];
			this.$refs.deleteConfirmModal.open();
		},

		openDeleteMany(rows) {
			const ids = rows.map(r => r.original.id);
			if (!ids.length) {
				this.$noty.warning('Не выбрано ни одной записи', { layout: 'bottomRight', timeout: 3000 });
				return;
			}
			this.pendingDeleteIds = ids;
			this.$refs.deleteConfirmModal.open(ids.length);
		},

		async onDeleteConfirm({ done, finish }) {
			const ids = this.pendingDeleteIds;
			try {
				const results = await Promise.all(ids.map(id => this.mfModel.deleteLead(id)));
				const failed = results.filter(r => r.error_code !== 1).length;

				await this.loadLeads();
				this.rowSelection = {};

				if (failed > 0) {
					this.$noty.warning(`Удалено ${ids.length - failed} из ${ids.length}, часть лидов не удалилась`, { layout: 'bottomRight', timeout: 4000 });
				} else {
					this.$noty.success(ids.length > 1 ? 'Выбранные лиды удалены' : 'Лид удалён', { layout: 'bottomRight', timeout: 3000 });
				}

				finish();
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done();
			}
		},
		async openLeadById(leadId) {
			if (!leadId) return;
			try {
				const data = await this.mfModel.getLeadByPkid(leadId);
				if (data.error_code === 1 && data.item) {
					if (data.item.funnel_pkid && data.item.funnel_pkid !== this.activeFunnel) {
						this.activeFunnel = data.item.funnel_pkid;
						await Promise.all([this.loadStages(), this.loadLeads(), this.loadStats()]);
					}
					this.openDrawer(this.mapLeadFromApi(data.item));
				} else {
					this.$noty.error(data.error_str || 'Лид не найден', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		buildServerFilter() {
			const filter = {
				company_pkid: this.companyPkid,
				funnel_pkid: this.funnelPkid,
			};
			for (const cf of this.columnFilters) {
				if (cf.value === undefined || cf.value === null) continue;
				filter[cf.id] = cf.value;
			}
			return filter;
		},

		async loadStats() {
			const data = await this.mfModel.getLeadStats({
				company_pkid: this.companyPkid,
				funnel_pkid: this.funnelPkid,
			});
			if (data.error_code === 1) {
				this.statsData = data; // сохраняем весь ответ
			}
		},


		async loadFunnels() {
			try {
				const data = await this.mfModel.getFunnels({ company_pkid: this.companyPkid });
				if (data.error_code === 1) {
					this.funnels = data.items || [];
					if (!this.activeFunnel && this.funnels.length) {
						this.activeFunnel = this.funnels[0].pkid;
					}
				} else {
					this.$noty.error(data.error_str || 'Ошибка загрузки воронок', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		async loadStages() {
			try {
				const data = await this.mfModel.getLeadStages({
					company_pkid: this.companyPkid,
					funnel_pkid: this.funnelPkid,
				});
				if (data.error_code === 1) {
					this.stages = data.items || [];
				} else {
					this.$noty.error(data.error_str || 'Ошибка загрузки этапов', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		async loadLeads() {
			const filter = this.buildServerFilter();
			try {
				const data = await this.mfModel.getLeads(
					this.buildServerFilter(),
					this.pagination.pageIndex * this.pagination.pageSize,
					this.pagination.pageSize,
					this.globalFilter,
				);
				if (data.error_code === 1) {
					this.totalLeads = data.total || 0;
					this.leadsData = (data.items || []).map(this.mapLeadFromApi);
					if (this.activeView === 'list' && !this.selectedLead && this.leadsData.length) {
						this.selectedLead = this.leadsData[0];
					}
				} else {
					this.$noty.error(data.error_str || 'Ошибка загрузки лидов', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		mapLeadFromApi(l) {
			return {
				id: l.pkid,
				lead_stage_pkid: l.lead_stage_pkid,
				status: Number(l.status),
				source: Number(l.source),
				amount: Number(l.potentialAmount) || 0,
				manager: l.responsible_user,
				manager_name: l.responsible_user_name || '',
				client_pkid: l.client_pkid,
				convertedDealPkid: l.convertedDealPkid || null,
				name: l.name || `Лид #${l.pkid}`,
				description: l.description || '',
				refusalReason: l.refusalReason || '',
				stage: l.stage_name || '—',
				company: '',
				phone: '',
				email: '',
				date: l.gmtimeAdd ? this.formatDate(l.gmtimeAdd) : '',
			};
		},

		formatDate(gmtimeStr) {
			// gmtimeStr вида "2026-07-15 10:23:00" (UTC из БД)
			const d = new Date(gmtimeStr.replace(' ', 'T') + 'Z');
			if (isNaN(d.getTime())) return '';
			return new Intl.DateTimeFormat('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' }).format(d);
		},

		debouncedLoadLeads() {
			clearTimeout(this._searchDebounceTimer);
			this._searchDebounceTimer = setTimeout(() => { this.loadLeads(); }, 400);
		},

		onFunnelChange() {
			this.selectedLead = null;
			this.pagination.pageIndex = 0;
			this.globalFilter = '';
			this.columnFilters = [];

			Promise.all([
				this.loadStages(),
				this.loadLeads(),
				this.loadStats(),
				this.loadManagers(), // ← тоже сюда, чтобы менеджеры всегда были свежими под новую воронку
			]).then(() => {
				// Пересоздаём фасетные фильтры только теперь, когда все options уже актуальны
				this.filterKey++;

				if (this.activeView === 'list' && this.leadsData.length > 0) {
					this.selectedLead = this.leadsData[0];
				}
			});

			// const funnel = this.funnels.find(f => f.pkid === this.activeFunnel);
			// this.$noty.info(`Переключено на "${funnel?.name ?? ''}"`, { layout: 'bottomRight', timeout: 2000 });
		},

		openDrawer(lead) {
			this.selectedLead = { ...lead };
			this.isDrawerOpen = true;
			this.loadSelectedLeadClient(lead.client_pkid);
			this.loadEntityTasks(lead.id);
		},

		async loadEntityTasks(leadId) {
			this.entityTasks = [];
			try {
				const data = await this.mfModel.getTasks(
					{ company_pkid: this.companyPkid, linkedEntityType: this.entityTypes.lead, linkedEntityPkid: leadId },
					0, 50, ''
				);
				if (data.error_code === 1) {
					this.entityTasks = data.items || [];
				}
			} catch (e) {
				console.error(e);
			}
		},
		async loadSelectedLeadClient(clientPkid) {
			if (!clientPkid) return;
			try {
				const data = await this.mfModel.getClientByPkid(clientPkid);
				if (data.error_code === 1 && data.item) {
					// проверяем, что пока грузили клиента, drawer не переключили на другой лид
					if (this.selectedLead && this.selectedLead.client_pkid === clientPkid) {
						this.selectedLead = {
							...this.selectedLead,
							email: data.item.email || '',
							phone: data.item.phone || '',
							company: data.item.company || '',
							contact_pkid: data.item.contact_pkid || null,
						};
					}
				}
			} catch (e) {
				console.error(e);
			}
		},

		getStatusClass(status) {
			switch (Number(status)) {
				case 0: return 'bg-blue-50 text-blue-600 border-blue-200';
				case 1: return 'bg-purple-50 text-purple-600 border-purple-200';
				case 2: return 'bg-emerald-50 text-emerald-600 border-emerald-200';
				case 3: return 'bg-red-50 text-red-600 border-red-200';
				default: return 'bg-gray-100 text-gray-600 border-gray-200';
			}
		},

		formatCurrency(val) {
			return new Intl.NumberFormat('ru-RU').format(val) + ' ₸';
		},

		resetFilters() {
			this.globalFilter = '';
			this.columnFilters = [];
			this.pagination.pageIndex = 0;
			this.filterKey++;
			this.loadLeads();
			// this.$noty.success('Сброс фильтров. Отображены все системные лиды.', { layout: 'bottomRight', timeout: 3000 });
		},

		async createLead(newLead, { done, finish } = {}) {
			try {
				const data = await this.mfModel.createLead({
					company_pkid: this.companyPkid,
					funnel_pkid: this.funnelPkid,
					...newLead,
				});
				if (data.error_code === 1) {
					this.$noty.success('Новый лид успешно добавлен', { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					await this.loadLeads();
				} else {
					this.$noty.error(data.error_str || 'Ошибка создания лида', { layout: 'bottomRight', timeout: 3000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done?.();
			}
		},

		editLead(lead) {
			this.$refs.leadModal.openForEdit(lead);
		},

		async updateLead(updatedData, { done, finish } = {}) {
			try {
				const data = await this.mfModel.updateLead(updatedData.id, {
					name: updatedData.name,
					description: updatedData.description,
					responsible_user: updatedData.responsible_user,
					potentialAmount: updatedData.potentialAmount,
					lead_stage_pkid: updatedData.lead_stage_pkid,
					source: updatedData.source,
					status: updatedData.status,
					refusalReason: updatedData.refusalReason,
				});
				if (data.error_code === 1) {
					this.$noty.success('Данные лида обновлены', { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					await this.loadLeads();
				} else {
					this.$noty.error(data.error_str || 'Ошибка обновления лида', { layout: 'bottomRight', timeout: 3000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				done?.();
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		async doDelete(leadId) {
			try {
				const data = await this.mfModel.deleteLead(leadId);
				if (data.error_code === 1) {
					await this.loadLeads();
					this.$noty.success('Лид удалён', { layout: 'bottomRight', timeout: 3000 });
				} else {
					this.$noty.error(data.error_str || 'Ошибка удаления лида', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		async onKanbanUpdate(newItems) {
			const prevById = new Map(this.leadsData.map(l => [l.id, l]));
			const moved = [];

			newItems.forEach(item => {
				const prev = prevById.get(item.id);
				if (prev && prev.lead_stage_pkid !== item.lead_stage_pkid) {
					moved.push({ id: item.id, from: prev.lead_stage_pkid, to: item.lead_stage_pkid });
				}
			});

			this.leadsData = newItems;

			for (const m of moved) {
				try {
					const data = await this.mfModel.moveLead(m.id, m.to);
					if (data.error_code !== 1) {
						throw new Error(data.error_str || 'Move failed');
					}
				} catch (e) {
					console.error(e);
					this.$noty.error('Не удалось сохранить перемещение лида, откат', { layout: 'bottomRight', timeout: 3000 });
					await this.loadLeads();
				}
			}
		},

		// Открыть модалку создания этапа.
		// insertIndex: позиция в массиве this.stages, куда нужно вставить новый этап
		// (0 — в начало, this.stages.length/undefined — в конец, N — между this.stages[N-1] и this.stages[N]).
		openStageModal(insertIndex) {
			const hasIndex = typeof insertIndex === 'number';
			let contextText = '';
			if (hasIndex && this.stages.length) {
				if (insertIndex <= 0) {
					contextText = `Этап будет добавлен перед «${this.stages[0].name}»`;
				} else if (insertIndex >= this.stages.length) {
					contextText = `Этап будет добавлен после «${this.stages[this.stages.length - 1].name}»`;
				} else {
					contextText = `Этап будет добавлен между «${this.stages[insertIndex - 1].name}» и «${this.stages[insertIndex].name}»`;
				}
			}
			this.$refs.stageModal.open(hasIndex ? insertIndex : null, contextText);
		},

		async onStageCreate(stageData, { done, finish } = {}) {
			try {
				const data = await this.mfModel.createLeadStage({
					company_pkid: this.companyPkid,
					funnel_pkid: this.funnelPkid,
					name: stageData.label,
					sortOrder: this.stages.length,
				});
				if (data.error_code === 1) {
					const newPkid = data.pkid;
					this.$noty.success(`Этап "${stageData.label}" добавлен`, { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					await this.loadStages();

					const insertIndex = stageData.insertIndex;
					if (newPkid && typeof insertIndex === 'number' && insertIndex < this.stages.length - 1) {
						// Этап создался в конце — переставляем его на нужную позицию относительно другого этапа
						const pkids = this.stages.map(s => s.pkid).filter(pkid => pkid !== newPkid);
						pkids.splice(insertIndex, 0, newPkid);
						await this.persistStagesOrder(pkids);
					}
				} else {
					this.$noty.error(data.error_str || 'Ошибка создания этапа', { layout: 'bottomRight', timeout: 3000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done?.();
			}
		},

		// col — объект колонки канбана: { id, label, lead_stage_pkid, ... }
		onDeleteStageRequest(col) {
			if (!col || !col.lead_stage_pkid) return;

			if (this.stages.length <= 1) {
				this.$noty.warning('Нельзя удалить последний оставшийся этап', { layout: 'bottomRight', timeout: 3000 });
				return;
			}

			const leadsInStage = this.leadsData.filter(l => l.lead_stage_pkid === col.lead_stage_pkid).length;
			if (leadsInStage > 0) {
				this.$noty.warning(`В этапе "${col.label}" есть лиды (${leadsInStage}). Сначала перенесите их на другой этап.`, { layout: 'bottomRight', timeout: 4000 });
				return;
			}

			this.stageToDelete = col;
			this.$refs.deleteStageModal.open(1, {
				title: 'Удалить этап?',
				message: `Вы уверены, что хотите удалить этап «${col.label}»?`,
			});
		},

		async onDeleteStageConfirm({ done, finish }) {
			const stage = this.stageToDelete;
			if (!stage) { done(); return; }

			try {
				const data = await this.mfModel.deleteLeadStage(stage.lead_stage_pkid);
				if (data.error_code === 1) {
					await this.loadStages();
					this.$noty.success(`Этап "${stage.label}" удалён`, { layout: 'bottomRight', timeout: 3000 });
					this.stageToDelete = null;
					finish();
				} else {
					this.$noty.error(data.error_str || 'Ошибка удаления этапа', { layout: 'bottomRight', timeout: 3000 });
					done();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done();
			}
		},

		async advanceLead(lead) {
			const messages = {
				1: `Лид "${lead.name}" подтверждён и передан в работу.`,
				2: `Лид "${lead.name}" квалифицирован и передан в воронку сделок BMC CRM.`,
			};

			try {
				const data = await this.mfModel.advanceLead(lead.id);
				if (data.error_code === 1) {
					await this.loadLeads();
					this.selectedLead = { ...this.selectedLead, status: data.status, convertedDealPkid: data.convertedDealPkid ?? this.selectedLead.convertedDealPkid };
					this.$noty.success(messages[data.status] || 'Статус лида обновлён', { layout: 'bottomRight', timeout: 3000 });
				} else {
					this.$noty.error(data.error_str || 'Ошибка обновления статуса', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		sourceLabel(sourceId) {
			return this.sourceLabels[sourceId] || '—';
		},

		statusLabel(statusId) {
			return this.statusLabels[statusId] || '—';
		},

		managerLabel(managerId) {
			if (!managerId) return '—';
			const found = this.serverFilterValues.managers.find(m => m.value === managerId);
			return found ? found.label : `Пользователь #${managerId}`;
		},

		async reorderKanbanColumns(newColumns) {
			const pkids = newColumns.map(c => c.lead_stage_pkid);
			await this.persistStagesOrder(pkids);
		},

		// Применяет порядок pkids локально (оптимистично) и сохраняет на бэке,
		// с откатом при ошибке. Используется и при drag&drop колонок, и при
		// создании этапа "относительно другого этапа".
		async persistStagesOrder(pkids) {
			const prevStages = this.stages;

			const stageByPkid = new Map(this.stages.map(s => [s.pkid, s]));
			this.stages = pkids.map(pkid => stageByPkid.get(pkid)).filter(Boolean);

			try {
				const data = await this.mfModel.reorderLeadStages(pkids);
				if (data.error_code !== 1) {
					throw new Error(data.error_str || 'Reorder failed');
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Не удалось сохранить порядок этапов, откат', { layout: 'bottomRight', timeout: 3000 });
				this.stages = prevStages;
			}
		},
		getFacetedOptions(columnId, serverOptions) {
			// собираем значения, которые реально есть в данных
			const dataValues = new Set(this.leadsData.map(l => l[columnId]));
			
			// добавляем все серверные значения, которых нет в данных
			const result = serverOptions.map(opt => ({
				...opt,
				// помечаем, есть ли значение в данных (для галочки в фильтре)
				_inData: dataValues.has(opt.value),
			}));
			
			return result;
		},

		async loadManagers() {
			const data = await this.mfModel.getUsersByRole(this.companyPkid, 3);
			if (data.error_code === 1) {
				this.serverFilterValues.managers = (data.items || []).map(u => ({
					value: u.pkid,
					label: u.name || u.login || `Пользователь #${u.pkid}`,
					count: 0,
				}));
			}
		},

		rejectLead(lead) {
			this.$refs.rejectModal.open(lead);
		},

		async onRejectConfirm({ lead, reason, done, finish }) {
			try {
				const data = await this.mfModel.rejectLead(lead.id, reason);
				if (data.error_code === 1) {
					await this.loadLeads();
					this.selectedLead = { ...this.selectedLead, status: 3, refusalReason: reason };
					this.$noty.success(`Лид "${lead.name}" отклонён.`, { layout: 'bottomRight', timeout: 3000 });
					finish(); // закрываем модалку только при успехе
				} else {
					this.$noty.error(data.error_str || 'Ошибка обновления статуса', { layout: 'bottomRight', timeout: 3000 });
					done(); // оставляем модалку открытой с уже введённым текстом
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done();
			}
		},

		handleDrawerClose() {
			this.closeDrawer();
		},

		closeDrawer() {
			if (this.$refs.rejectModal?.show) return; // не закрываем дровер под открытой модалкой отказа
			this.isDrawerOpen = false;
		},

		async toggleTaskStatus(task) {
			const newStatus = Number(task.status) === 1 ? 0 : 1;
			try {
				const data = await this.mfModel.toggleTaskStatus(task.pkid, newStatus);
				if (data.error_code === 1) {
					task.status = newStatus;
					this.$noty.success(
						newStatus === 1 ? `Задача "${task.name}" выполнена!` : `Задача "${task.name}" возвращена в работу.`,
						{ layout: 'bottomRight', timeout: 3000 }
					);
				} else {
					this.$noty.error(data.error_str || 'Не удалось обновить статус', { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		openTaskModalForEntity() {
			if (!this.selectedLead) return;
			this.$refs.taskModal.open({
				linkedEntityType: this.entityTypes.lead,
				linkedEntityPkid: this.selectedLead.id,
			});
		},

		async createTask(newTask, { done, finish } = {}) {
			try {
				const data = await this.mfModel.createTask({ company_pkid: this.companyPkid, ...newTask });
				if (data.error_code === 1) {
					this.$noty.success('Задача успешно добавлена', { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					if (this.selectedLead) {
						this.loadEntityDetails(this.selectedLead.id);
					}
				} else {
					this.$noty.error(data.error_str || 'Ошибка создания задачи', { layout: 'bottomRight', timeout: 3000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
				done?.();
			}
		},
	},
};
</script>
