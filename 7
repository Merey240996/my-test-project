												</div>
											</template>

											<template v-else>
												<div>
													<label class="form-label">Название компании <span class="text-red-500">*</span></label>
													<Input v-model="newClient.company" placeholder="ТОО «Название»" :disabled="isLocked" />
												</div>
												<div class="grid grid-cols-2 gap-2">
													<div>
														<label class="form-label">Email</label>
														<Input v-model="newClient.email" type="email" placeholder="mail@example.kz" :disabled="isLocked" />
													</div>
													<div>
														<label class="form-label">Телефон</label>
														<Input v-model="newClient.phone" placeholder="+7 700 000 00 00" :disabled="isLocked" />
													</div>
												</div>
											</template>
										</div>
									</template>
								</div>
								<!-- ============ /КЛИЕНТ ============ -->
								<div>
									<label class="form-label">Название лида</label>
									<Input v-model="newLead.name" type="text" placeholder="Например: Заявка с сайта — ТОО Ромашка" :disabled="isLocked" />
								</div>

								<div>
									<label class="form-label">Описание</label>
