												</Select>
											</div>

											<div class="flex items-center gap-2">
												<Checkbox :checked="newClient.isRegistered" :disabled="isLocked" @mousedown="toggleRegistered" />
												<span class="text-sm text-slate-700 cursor-pointer select-none" @click="toggleRegistered">
													Клиент зарегистрирован на платформе
												</span>
											</div>

											<template v-if="newClient.isRegistered">
												<div>
													<label class="form-label">Логин пользователя <span class="text-red-500">*</span></label>
													<Input
														v-model="newClient.user"
														:disabled="isLocked"
														@input="onLoginInput"
														@blur="lookupUserByLogin"
													/>
													<div v-if="userLookup.status === 'loading'" class="mt-1 text-xs text-slate-400">
														Проверяем пользователя...
													</div>
													<div v-else-if="userLookup.status === 'notfound'" class="mt-1 text-xs text-red-500">
														{{ userLookup.error }}
													</div>
													<div v-else-if="userLookup.status === 'found'" class="mt-1 text-xs text-green-500">
														Пользователь найден на платформе
													</div>
												</div>

												<div v-if="foundUser" class="grid grid-cols-2 gap-3 p-2 rounded-lg bg-white border border-slate-100 text-xs text-slate-500">
													<div><span class="text-slate-400">Компания:</span> {{ foundUser.company || '—' }}</div>
													<div><span class="text-slate-400">Email:</span> {{ foundUser.email || '—' }}</div>
