										class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent resize-none disabled:bg-slate-100 disabled:text-slate-400"
									></textarea>
								</div>

								<div class="grid grid-cols-2 gap-4">
									<div>
										<label class="form-label">Сумма (₸)</label>
										<Input v-model.number="newLead.potentialAmount" type="number" class="w-full" :disabled="isLocked" />
									</div>
									<div>
										<label class="form-label">Источник</label>
										<Select v-model.number="newLead.source" class="w-full" :disabled="isLocked">
											<option v-for="opt in sources" :key="opt.value" :value="opt.value">
												{{ opt.label }}
											</option>
										</Select>
									</div>
								</div>

								<div class="grid grid-cols-2 gap-4">
									<div>
										<label class="form-label">Этап</label>
										<Select v-model.number="newLead.lead_stage_pkid" class="w-full" :disabled="isLocked">
											<option v-for="stage in stages" :key="stage.pkid" :value="stage.pkid">
												{{ stage.name }}
											</option>
										</Select>
									</div>
									<div>
										<label class="form-label">Статус</label>
										<Select v-model.number="newLead.status" class="w-full" :disabled="isLocked">
											<option v-for="opt in availableStatusOptions" :key="opt.value" :value="opt.value">
												{{ opt.label }}
											</option>
										</Select>
										<div v-if="isEditing && !canRollback" class="mt-1 text-xs text-slate-400">
											Откат статуса назад доступен только администратору.
										</div>
									</div>
								</div>

								<div v-if="newLead.status === 3">
