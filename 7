</style>

<script>
import Button from 'io7/components/tailux/ui/Button.vue';
import Spinner from 'io7/components/tailux/loading/Spinner.vue';
import Select from 'io7/components/tailux/ui/form/Select.vue';
import Input from 'io7/components/tailux/ui/form/Input.vue';
import Checkbox from 'io7/components/tailux/ui/form/Checkbox.vue';
import {
	TransitionRoot,
	TransitionChild,
	Dialog,
	DialogPanel,
	DialogTitle,
} from '@headlessui/vue';

const emptyNewClient = () => ({
	base_pkid: 0,
	isRegistered: false,
	user: '',
	user_pkid: null,
	company: '',
	email: '',
	phone: '',
});

// Финальные статусы лида, после которых редактирование блокируется
const LOCKED_STATUSES = [2, 3]; // 2 = Конвертирован, 3 = Отклонён

// statusRollback раньше был захардкожен здесь и вручную держался в
// синхроне с LeadApi::STATUS_ROLLBACK. Теперь это единственный источник
// правды — App\Api\EnumApi на бэке (crm.api.enum.leadStatusRollback), а
// сюда попадает через mfModel.getLeadStatusRollback() (см. loadEnums).
// Используется только для фильтрации опций в Select (UX); окончательное
// решение всё равно принимает бэкенд в doSave.

export default {
	name: 'LeadModal',
	components: { TransitionRoot, TransitionChild, Dialog, DialogPanel, DialogTitle, Button, Select, Input, Checkbox, Spinner },
	emits: ['create', 'update'],
	props: {
		statuses: { type: Array, default: () => [] },
		sources: { type: Array, default: () => [] },
		stages: { type: Array, default: () => [] },
		managers: { type: Array, default: () => [] },
		companyPkid: { type: Number, default: 0 },
	},
	data() {
		return {
			show: false,
			isEditing: false,
			editingId: null,
			newLead: this.emptyLead(),
			isSubmitting: false,

			// Статус лида на момент открытия модалки на редактирование.
			// Используется для блокировки формы у уже "финализированных" лидов —
			// не путать с newLead.status, который меняется прямо в форме.
			originalStatus: null,

			// Может ли текущий пользователь откатывать статус лида назад
			// (role_pkid = 1, см. LeadApi::userCanRollbackLeadStatus). Пока не
			// загружено — считаем false (безопасный дефолт), чтобы Select не
			// мигал полным списком статусов до ответа сервера.
			canRollback: false,

			// Статусные константы с бэка (см. loadEnums). Пока не загружены —
			// пустой объект, availableStatusOptions в этом случае ничего не
			// фильтрует (безопасный дефолт, как и раньше для canRollback).
			statusRollback: {},

			// ---- клиент: кросс-базовый поиск (единая идентичность, contact_pkid) ----
			// clientBases нужен только для сценария "клиента нет ни в одной базе" —
			// туда нужно выбрать, в какую базу его добавить при создании.
			clientBases: [],
			selectedClient: null, // { pkid (client_pkid), base_pkid, base_name, company, email, phone, contact_pkid }

			clientSearch: '',
			clientResults: [],
			clientResultsTotal: 0,
			clientSearchLoading: false,
			clientSearchLoadingMore: false,
			crossOpen: false,
			_clientSearchTimer: null,
			_clientSearchRequestId: 0,

			clientNotInAnyBase: false,
			newClient: emptyNewClient(),
			foundUser: null,
			userLookup: { status: 'idle', error: '' }, // idle | loading | found | notfound
			loginLookupTimer: null,
			lookupPromise: null,
		};
	},
	computed: {
		// Форма заблокирована, если редактируем уже отклонённый/конвертированный лид.
		// При создании нового лида (isEditing === false) блокировки нет никогда.
		isLocked() {
			return this.isEditing && LOCKED_STATUSES.includes(this.originalStatus);
		},

		// При создании лида — все статусы. При редактировании администратором —
		// тоже все (админу разрешён и откат). Обычному менеджеру, редактирующему
		// существующий лид, скрываем статус, откат в который запрещён бэкендом —
		// иначе Select предложит выбор, который doSave всё равно отклонит.
		availableStatusOptions() {
			if (!this.isEditing || this.canRollback) {
				return this.statuses;
			}
			const forbidden = this.statusRollback[this.originalStatus];
			if (forbidden === undefined) {
				return this.statuses;
			}
			return this.statuses.filter(opt => opt.value !== forbidden);
		},

		// Смену привязанного клиента разрешаем только при создании лида.
		// У уже существующего лида переприкрепление клиента ломает историю:
		// если лид уже конвертирован (convertedDealPkid заполнен), сделка была
		// создана с client_pkid лида на момент конвертации и продолжает жить
		// своей жизнью — смена клиента у лида задним числом рассинхронизирует
		// лид и его сделку. Это отдельный флаг от isLocked (тот блокирует форму
		// целиком по финальному статусу) — клиента нельзя менять независимо
		// от статуса, как только лид уже существует.
		clientLocked() {
			return this.isEditing;
		},
	},

	methods: {
		emptyLead() {
			return {
				client_pkid: null,
				lead_stage_pkid: this.stages[0]?.pkid ?? null,
				responsible_user: 0,
				name: '',
				description: '',
				potentialAmount: 5000,
				source: this.sources[0]?.value ?? null,
				status: this.statuses[0]?.value ?? 0,
				refusalReason: '',
			};
		},

		async loadClientBases() {
			try {
				const data = await this.mfModel.getClientBases({
					company_pkid: this.companyPkid,
				});
				if (data.error_code === 1) {
					this.clientBases = data.items || [];
				}
			} catch (e) {
				console.error(e);
			}
		},

		async loadCanRollback() {
			try {
				const data = await this.mfModel.canRollbackLead(this.companyPkid);
				this.canRollback = data.error_code === 1 && !!data.canRollback;
			} catch (e) {
				console.error(e);
				this.canRollback = false;
			}
		},

		// Подтягиваем statusRollback с бэка (crm.api.enum.leadStatusRollback).
		// Список статичный на время сессии, поэтому грузим один раз при
		// первом открытии модалки и кэшируем.
		async loadEnums() {
			if (Object.keys(this.statusRollback).length) return;
			try {
				const data = await this.mfModel.getLeadStatusRollback();
				if (data.error_code === 1) {
					this.statusRollback = data.statusRollback || {};
				}
			} catch (e) {
				console.error(e);
			}
		},

		async open() {
			this.isEditing = false;
			this.editingId = null;
			this.originalStatus = null;
			this.canRollback = false;
			this.newLead = this.emptyLead();
			this.resetClientPicker();
			await this.loadClientBases();
			await this.loadEnums();
			this.show = true;
		},

		async openForEdit(lead) {
			this.isEditing = true;
			this.editingId = lead.id;
			this.originalStatus = lead.status;
			this.canRollback = false;
			await this.loadEnums();
			this.newLead = {
				client_pkid: lead.client_pkid,
				lead_stage_pkid: lead.lead_stage_pkid,
				responsible_user: lead.manager,
				name: lead.name || '',
				description: lead.description || '',
				potentialAmount: lead.amount,
				source: Number(lead.source),
				status: lead.status,
				refusalReason: lead.refusalReason || '',
			};
			this.resetClientPicker();
			await this.loadClientBases();
			await this.loadCanRollback();

			if (lead.client_pkid) {
				try {
					const data = await this.mfModel.getClientByPkid(lead.client_pkid);
					if (data.error_code === 1 && data.item) {
						const base = this.clientBases.find(b => Number(b.pkid) === Number(data.item.base_pkid));
						this.selectedClient = {
							...data.item,
							base_name: base ? base.name : null,
						};
					}
				} catch (e) {
					console.error(e);
				}
			}

			this.show = true;
		},

		resetClientPicker() {
			this.selectedClient = null;
			this.clientSearch = '';
			this.clientResults = [];
			this.clientResultsTotal = 0;
			this.crossOpen = false;
			this._clientSearchRequestId++;
			clearTimeout(this._clientSearchTimer);
			this.clientNotInAnyBase = false;
			this.newClient = emptyNewClient();
			this.foundUser = null;
			this.userLookup = { status: 'idle', error: '' };
		},

		close() {
			this.show = false;
			this.isEditing = false;
			this.editingId = null;
			this.originalStatus = null;
			this.newLead = this.emptyLead();
			this.resetClientPicker();
		},

		toggleClientNotInAnyBase() {
			if (this.isLocked || this.clientLocked) return;
			this.clientNotInAnyBase = !this.clientNotInAnyBase;
			this.crossOpen = false;
			this.clientSearch = '';
			this.clientResults = [];
			if (!this.clientNotInAnyBase) {
				this.newClient = emptyNewClient();
				this.foundUser = null;
				this.userLookup = { status: 'idle', error: '' };
			}
		},

		// ---- кросс-базовый поиск существующего клиента (по contact_pkid) ----
		debouncedSearchClients() {
			this.crossOpen = true;
			clearTimeout(this._clientSearchTimer);

			const term = this.clientSearch.trim();
			if (term.length < 2) {
				this.clientResults = [];
				this.clientResultsTotal = 0;
				this.clientSearchLoading = false;
				return;
			}
			this._clientSearchTimer = setTimeout(() => this.doSearchClients(term), 350);
		},

		async doSearchClients(term, options = {}) {
			term = (term ?? this.clientSearch).trim();
			if (term.length < 2) return;

			const append = !!options.append;
			// Guard от гонки ответов, аналогично кросс-поиску в списке баз клиентов.
			const requestId = ++this._clientSearchRequestId;

			if (append) {
				this.clientSearchLoadingMore = true;
			} else {
				this.clientSearchLoading = true;
				this.clientResults = [];
			}
			try {
				const data = await this.mfModel.searchContactsAcrossBases({
					company_pkid: this.companyPkid,
					search: term,
					start: append ? this.clientResults.length : 0,
					limit: 20,
				});

				if (requestId !== this._clientSearchRequestId) return;

				if (data.error_code === 1) {
					this.clientResults = append ? [...this.clientResults, ...(data.items || [])] : (data.items || []);
					this.clientResultsTotal = data.total || 0;
				} else if (!append) {
					this.clientResults = [];
					this.clientResultsTotal = 0;
				}
			} catch (e) {
				if (requestId !== this._clientSearchRequestId) return;
				console.error(e);
				if (!append) {
					this.clientResults = [];
					this.clientResultsTotal = 0;
				}
			} finally {
				if (requestId === this._clientSearchRequestId) {
					this.clientSearchLoading = false;
					this.clientSearchLoadingMore = false;
				}
			}
		},

		loadMoreClients() {
			const term = this.clientSearch.trim();
			if (term.length < 2 || this.clientSearchLoadingMore) return;
			this.doSearchClients(term, { append: true });
		},

		onSearchFocus() {
			if (this.clientSearch.trim().length >= 2) {
				this.crossOpen = true;
			}
		},
		onSearchBlur() {
			// Небольшая задержка + @mousedown.prevent на бейджах базы ниже:
			// клик по результату не должен "проглатываться" закрытием дропдауна
			// раньше, чем сработает выбор.
			setTimeout(() => {
				this.crossOpen = false;
			}, 150);
		},

		selectClientMatch(item, match) {
			this.selectedClient = {
				pkid: match.client_pkid,
				base_pkid: match.base_pkid,
				base_name: match.base_name,
				company: match.company,
				email: match.email,
				phone: match.phone,
				contact_pkid: item.contact_pkid,
			};
			this.newLead.client_pkid = match.client_pkid;
			this.crossOpen = false;
			this.clientSearch = '';
			this.clientResults = [];
		},
		clearClient() {
			if (this.isLocked || this.clientLocked) return;
			this.selectedClient = null;
			this.newLead.client_pkid = null;
		},

		// ---- регистрация на платформе (1-в-1 логика ClientModal) ----
		toggleRegistered() {
			if (this.isLocked || this.clientLocked) return;
			this.newClient.isRegistered = !this.newClient.isRegistered;
			if (!this.newClient.isRegistered) {
				this.newClient.user_pkid = null;
				this.foundUser = null;
				this.userLookup = { status: 'idle', error: '' };
			} else {
				this.newClient.company = '';
				this.newClient.email = '';
				this.newClient.phone = '';
			}
		},
		onLoginInput() {
			this.foundUser = null;
			this.newClient.user_pkid = null;
			this.userLookup = { status: 'idle', error: '' };
			this.lookupPromise = null;

			clearTimeout(this.loginLookupTimer);
			const login = this.newClient.user.trim();
			if (!login) return;

			this.loginLookupTimer = setTimeout(() => this.lookupUserByLogin(), 500);
		},
		lookupUserByLogin() {
			const login = this.newClient.user.trim();
			if (!login) return Promise.resolve();

			if (this.lookupPromise && this.userLookup.status === 'loading') {
				return this.lookupPromise;
			}

			this.userLookup = { status: 'loading', error: '' };

			const promise = (async () => {
				try {
					const data = await this.mfModel.findUserByLogin(login);
					if (data.error_code === 1 && data.user) {
						this.foundUser = data.user;
						this.newClient.user_pkid = data.user.pkid;
						this.newClient.company = data.user.company || '';
						this.newClient.email = data.user.email || '';
						this.newClient.phone = data.user.phone || '';
						this.userLookup = { status: 'found', error: '' };
					} else {
						this.foundUser = null;
						this.newClient.user_pkid = null;
						this.userLookup = { status: 'notfound', error: data.error_str || 'Пользователь не найден' };
					}
				} catch (e) {
					console.error(e);
					this.foundUser = null;
					this.newClient.user_pkid = null;
					this.userLookup = { status: 'notfound', error: 'Ошибка сети' };
				}
			})();

			this.lookupPromise = promise;
			return promise;
		},

		// создать клиента в выбранной базе и получить его pkid для лида
		async resolveOrCreateClient() {
			if (this.selectedClient) {
				return this.selectedClient.pkid;
			}

			if (!this.clientNotInAnyBase) {
				return null;
			}

			if (!this.newClient.base_pkid || this.newClient.base_pkid === 0) {
				this.$noty.warning('Выберите базу для добавления клиента.', { layout: 'bottomRight', timeout: 3000 });
				return null;
			}

			if (this.newClient.isRegistered) {
				const login = this.newClient.user.trim();
				if (!login) {
					this.$noty.warning('Укажите логин пользователя.', { layout: 'bottomRight', timeout: 3000 });
					return null;
				}
				clearTimeout(this.loginLookupTimer);
				await this.lookupUserByLogin();
				if (!this.newClient.user_pkid || this.userLookup.status !== 'found') {
					this.$noty.warning('Укажите корректный логин зарегистрированного пользователя.', { layout: 'bottomRight', timeout: 3000 });
					return null;
				}
			} else if (!this.newClient.company.trim()) {
				this.$noty.warning('Укажите название компании клиента.', { layout: 'bottomRight', timeout: 3000 });
				return null;
			}

			try {
				const data = await this.mfModel.createClient({
					company_pkid: this.companyPkid,
					base_pkid: this.newClient.base_pkid,
					company: this.newClient.company,
					email: this.newClient.email,
					phone: this.newClient.phone,
					user_pkid: this.newClient.isRegistered ? this.newClient.user_pkid : null,
				});
				if (data.error_code === 1) {
					return data.pkid;
				}
				this.$noty.error(data.error_str || 'Ошибка создания клиента', { layout: 'bottomRight', timeout: 3000 });
				return null;
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети при создании клиента', { layout: 'bottomRight', timeout: 3000 });
				return null;
			}
		},

		async submit() {
			if (this.isSubmitting || this.isLocked) return;

			if (!this.selectedClient && !this.clientNotInAnyBase) {
				this.$noty.warning('Выберите клиента через поиск или отметьте «Клиента нет ни в одной базе».', { layout: 'bottomRight', timeout: 3000 });
				return;
			}

			// Новая проверка
			// Автоматическое распределение лидов:
			// responsible_user === 0 означает, что ответственный будет назначен
			// на сервере по очереди среди менеджеров компании.
			// Поэтому на фронтенде проверять обязательный выбор ответственного не нужно.
			/*if (!this.newLead.responsible_user || this.newLead.responsible_user === 0) {
				this.$noty.warning('Выберите ответственного.', { layout: 'bottomRight', timeout: 3000 });
				return;
			}*/

			if (this.newLead.status === 3 && !this.newLead.refusalReason.trim()) {
				this.$noty.warning('Укажите причину отказа.', { layout: 'bottomRight', timeout: 3000 });
				return;
			}

			this.isSubmitting = true;
			try {
				const client_pkid = await this.resolveOrCreateClient();
				if (!client_pkid) { this.isSubmitting = false; return; }

				const payload = { ...this.newLead, client_pkid };
				if (payload.status !== 3) {
					payload.refusalReason = null;
				}

				const callbacks = {
					done: () => { this.isSubmitting = false; },
					finish: () => { this.isSubmitting = false; this.close(); },
				};

				if (this.isEditing) {
					this.$emit('update', { id: this.editingId, ...payload }, callbacks);
				} else {
					this.$emit('create', payload, callbacks);
				}
			} catch (e) {
				this.isSubmitting = false;
			}
		},
	},
};
</script>
