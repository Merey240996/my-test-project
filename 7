									<div v-if="selectedClient" class="flex items-center justify-between border border-emerald-300 bg-emerald-50 rounded-lg px-4 py-2">
										<div class="text-sm">
											<span class="font-bold text-slate-800">{{ selectedClient.company || selectedClient.user_login || '—' }}</span>
											<span class="text-slate-500 ml-2">{{ selectedClient.email || selectedClient.phone }}</span>
											<span class="text-slate-400 ml-2 text-xs">({{ selectedClient.base_name || ('база #' + selectedClient.base_pkid) }})</span>
										</div>
										<Button v-if="!clientLocked" unstyled class="text-xs text-slate-500 hover:text-red-500" :disabled="isLocked" @click="clearClient">
											Изменить
										</Button>
									</div>

									<template v-else>
										<!-- Кросс-базовый поиск существующего клиента -->
										<div v-if="!clientNotInAnyBase" class="relative">
											<label class="form-label">Поиск клиента по всем базам</label>
											<Input
												v-model="clientSearch"
