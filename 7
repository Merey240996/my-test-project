								<div>
									<label class="form-label">Ответственный</label>
									<Select v-model.number="newLead.responsible_user" class="w-full" :disabled="isLocked">
										<option :value="0">Автоматически назначить</option>
										<option v-for="m in managers" :key="m.value" :value="m.value">
