											>
												<div v-if="clientSearchLoading" class="p-3 text-center text-xs text-slate-400">Поиск...</div>
												<template v-else>
													<div v-if="!clientResults.length" class="p-3 text-center text-xs text-slate-400">Ничего не найдено</div>
													<div
