										</div>

										<!-- Переключатель "клиента нет ни в одной базе" -->
										<div class="flex items-center gap-2 pt-1">
											<Checkbox :checked="clientNotInAnyBase" :disabled="isLocked" @mousedown="toggleClientNotInAnyBase" />
											<span class="text-sm text-slate-700 cursor-pointer select-none" @click="toggleClientNotInAnyBase">
												Клиента нет ни в одной базе
											</span>
										</div>

										<!-- Полная аналогия ClientModal: выбор базы для создания + регистрация на платформе / ручной ввод -->
										<div v-if="clientNotInAnyBase" class="border border-slate-200 rounded-lg p-3 space-y-3 bg-slate-50">
											<div>
