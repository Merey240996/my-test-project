	watch: {
		'filters.search'(val) {
			this.globalFilter = val;
			clearTimeout(this._searchDebounce);
			this._searchDebounce = setTimeout(() => {
				this.pagination.pageIndex = 0;
				this.loadInvoices();
			}, 400);
		},
	},

	async created() {
		const self = this;

		// Подтягиваем те же enum/справочники, что invoices.html грузит через
		// ioEnum.invoices_types / ioEnum.invoices_statuses и *.getData для
		// warehouses/deliveryMethods — нужны, чтобы FacetedFilter показывал
		// человеко-читаемые лейблы, а не сырые коды/pkid.
		this.loadReferenceData();

		this.table = useVueTable({
			get data() { return self.invoicesData; },
			columns,
			enableRowSelection: true,
			// Фильтрация/пагинация теперь серверные (см. loadInvoices/buildServerFilter),
			// как в CustomersList.vue — filterFn'ы на колонках нужны только для API
			// TanStack Table, реальная фильтрация происходит через trade-запрос.
			manualFiltering: true,
			manualPagination: true,
			get pageCount() {
				return Math.ceil(self.totalInvoices / self.pagination.pageSize) || 1;
			},
			filterFns: { fuzzy: fuzzyFilter },
			state: {
				get globalFilter()  { return self.globalFilter; },
				get columnFilters() { return self.columnFilters; },
				get sorting()       { return self.sorting; },
				get pagination()    { return self.pagination; },
				get rowSelection()  { return self.rowSelection; },
			},
			onRowSelectionChange: (updater) => {
				self.rowSelection = typeof updater === 'function' ? updater(self.rowSelection) : updater;
			},
			onGlobalFilterChange: (updater) => {
				self.globalFilter = typeof updater === 'function' ? updater(self.globalFilter) : updater;
			},
			onColumnFiltersChange: (updater) => {
				self.columnFilters = typeof updater === 'function' ? updater(self.columnFilters) : updater;
				self.pagination.pageIndex = 0;
				self.loadInvoices();
			},
			onSortingChange: (updater) => {
				self.sorting = typeof updater === 'function' ? updater(self.sorting) : updater;
				self.loadInvoices();
			},
			onPaginationChange: (updater) => {
				self.pagination = typeof updater === 'function' ? updater(self.pagination) : updater;
				self.loadInvoices();
			},
			globalFilterFn: fuzzyFilter,
			getCoreRowModel: getCoreRowModel(),
			getFilteredRowModel: getFilteredRowModel(),
			getSortedRowModel: getSortedRowModel(),
			getFacetedRowModel: getFacetedRowModel(),
			getFacetedUniqueValues: getFacetedUniqueValues(),
			getPaginationRowModel: getPaginationRowModel(),
			// FilterSelector читает/пишет список активных полей через table.options.meta,
			// см. шаблон (template v-for="filterKey in toolbarFilters") — 1:1 с CustomersList.vue.
			meta: {
				setToolbarFilters: (filters) => { self.toolbarFilters = filters; },
				getToolbarFilters: () => self.toolbarFilters,
			},
		});

		this.selectedInvoice = null;
		this.loadInvoices();
	},

	mounted() {
		this.resizeObserver = new ResizeObserver((entries) => {
			for (const entry of entries) {
				if (entry.target === this.$refs.theadRef) {
					this.theadHeight = entry.contentRect.height;
				}
			}
		});
		if (this.$refs.theadRef) {
			this.resizeObserver.observe(this.$refs.theadRef);
		}
	},

	beforeUnmount() {
		if (this.resizeObserver) {
			this.resizeObserver.disconnect();
		}
	},

	methods: {
		// getFilterOptions/filterLabel/isDateFilterField/isRangeFilterField/rangeButtonText —
		// обвязка для FilterSelector/DateFilter/RangeFilter/FacetedFilter, 1:1 по структуре
		// с CustomersList.vue, но источник опций для select-полей — уже готовые
		// typeOptions/statusOptions/isPayedOptions/warehouseOptions/deliveryMethodOptions
		// (в CustomersList опции считались из уже загруженных строк, тут они из справочников).
		getFilterOptions(key) {
			switch (key) {
				case 'type': return this.typeOptions;
				case 'status': return this.statusOptions;
				case 'isPayed': return this.isPayedOptions;
				case 'warehouse_pkid': return this.warehouseOptions;
				case 'delivery_method': return this.deliveryMethodOptions;
				default: return [];
			}
		},

		filterLabel(key) {
			return INVOICE_FILTER_FIELDS[key]?.label || key;
		},

		isDateFilterField(key) {
			return INVOICE_FILTER_FIELDS[key]?.type === 'date';
		},

		isRangeFilterField(key) {
			return INVOICE_FILTER_FIELDS[key]?.type === 'number';
		},

		rangeButtonText(key) {
			return ({ min, max }) =>
				`${min ? 'От ' + min : ''}` +
				`${min && max ? ' — ' : ''}` +
				`${max ? 'До ' + max : ''}`;
		},

		// Справочники для лейблов FacetedFilter — те же источники, что и в
		// invoices.html (ioEnum.invoices_types/statuses, warehouses.getData,
		// deliveryMethods.getData). Если каких-то методов ещё нет на фронте —
		// фильтр просто останется пустым списком опций, без падения страницы.
		// Статусы — с бэка, по тому же паттерну, что statusLabels в
		// Leads.vue/Orders.vue/Deals.vue (crm.api.enum.invoiceStatusLabels ->
		// EnumApi::INVOICE_STATUS_LABELS, зеркало $ioEnum['invoices_statuses']
		// из trade). Тип инвойса (продажа/возврат/заказ) в EnumApi не заведён —
		// это не статус, а поле 'type' из invoices_struct, коды видны прямо в
		// invoices.html (el.type == 0 ? 'dollar' : (1 ? 'reply' : 'shopping-cart')),
		// поэтому оставлен как локальная константа в data().
		async loadReferenceData() {
			try {
				const statusData = await this.mfModel.getInvoiceStatusLabels();
				if (statusData.error_code === 1) {
					this.statusOptions = Object.entries(statusData.statusLabels || {}).map(([value, label]) => ({
						label,
						value: Number(value),
					}));
				}
			} catch (e) {
				console.error('Не удалось загрузить invoiceStatusLabels', e);
			}

			try {
				const offerTypeData = await this.mfModel.getOfferTypeLabels();
				if (offerTypeData.error_code === 1) {
					this.offerTypeOptions = Object.entries(offerTypeData.offerTypeLabels || {}).map(([value, label]) => ({
						label,
						value: Number(value),
					}));
				}
			} catch (e) {
				console.error('Не удалось загрузить offerTypeLabels', e);
			}

			try {
				if (this.mfModel.getWarehouses) {
					const wh = await this.mfModel.getWarehouses(this.companyPkid);
					this.warehouseOptions = (wh?.items || wh?.data || []).map((w) => ({
						label: w.name,
						value: w.pkid,
					}));
				}
			} catch (e) {
				console.error('Не удалось загрузить список складов', e);
			}

			try {
				if (this.mfModel.getDeliveryMethods) {
					const dm = await this.mfModel.getDeliveryMethods(this.companyPkid);
					const dmItems = dm?.items || dm?.data || [];
					this.deliveryMethodOptions = dmItems.map((m) => ({ label: m.name, value: m.pkid }));
					this.deliveryMethodsRaw = dmItems;
				}
			} catch (e) {
				console.error('Не удалось загрузить способы доставки', e);
			}
		},

		// Переводит columnFilters (то, что накопил FilterSelector/FacetedFilter/RangeFilter/
		// DateFilter) в trade-формат filter'а с операторами перед именем поля — тот же
		// формат, что уже понимает InvoiceApi::buildFilter (ltrim по '=!%<>~').
		// ВАЖНО: op-словарь ('gt'/'gte'/'lt'/'lte'/'between'/'before'/'after'/'equals'/
		// 'empty'/'notEmpty') — предположение по аналогии с rangeFilterFn/dateFilterFn
		// в CustomersList.vue, т.к. исходники RangeFilter.vue/DateFilter.vue не смотрел;
		// если они эмитят другую форму — поправить здесь.
		columnFiltersToServerFilter() {
			const filter = {};
			this.columnFilters.forEach(({ id, value }) => {
				if (!value) return;
				const meta = INVOICE_FILTER_FIELDS[id];
				if (!meta) return;

				if (meta.type === 'select') {
					const { op, values } = value;
					if (op === 'empty') { filter['=' + id] = null; return; }
					if (op === 'notEmpty') { filter['!' + id] = null; return; }
					if (!values?.length) return;
					filter[(op === 'notEquals' ? '!' : '=') + id] = values.length === 1 ? values[0] : values;
				} else if (meta.type === 'number') {
					const { op, min, max } = value;
					if (op === 'between') {
						if (min !== '' && min != null) filter['>' + id] = min;
						if (max !== '' && max != null) filter['<' + id] = max;
					} else if (op === 'gt' || op === 'gte') {
						filter['>' + id] = min;
					} else if (op === 'lt' || op === 'lte') {
						filter['<' + id] = min;
					} else if (op === 'equals') {
						filter['=' + id] = min;
					}
				} else if (meta.type === 'date') {
					const { op, value: v, from, to } = value;
					if (op === 'between') {
						if (from) filter['>' + id] = from;
						if (to) filter['<' + id] = to;
					} else if (op === 'before') {
						filter['<' + id] = v;
					} else if (op === 'after') {
						filter['>' + id] = v;
					} else if (op === 'equals') {
						filter['=' + id] = v;
					}
				}
			});
			return filter;
		},

		// Собирает серверный filter для InvoiceApi::doSearch/buildFilter: company_pkid +
		// select/number/date из columnFilters (columnFiltersToServerFilter()). Текст из
		// filters.search сюда НЕ входит — он уходит отдельным параметром 'search' в
		// loadInvoices() (trade сам разбирает %text/pkid: — см. invoices.html). Класть его
		// же дополнительно в filter['%picker_login'] и т.п. нельзя: buildFilter в
		// InvoiceApi.php комбинирует все ключи через AND, и запись одновременно
		// потребовала бы совпадения текста *и* в %text-совпадении, *и* во всех этих полях
		// сразу — результат почти всегда пустой. Пока в InvoiceApi/trade не появится
		// нормальный OR по списку текстовых полей, единый инпут физически может быть
		// только один канал поиска — используем встроенный %text/pkid:.
		buildServerFilter() {
			const filter = { company_pkid: this.companyPkid };
			Object.assign(filter, this.columnFiltersToServerFilter());
			return filter;
		},

		// Реальный вызов на бэк App\Api\InvoiceApi::doSearch
		// (см. mfModel.getInvoices -> entity crm.api.invoice.search).
		async loadInvoices() {
			this.isLoading = true;
			try {
				const data = await this.mfModel.getInvoices(
					this.buildServerFilter(),
					this.pagination.pageIndex * this.pagination.pageSize,
					this.pagination.pageSize,
					this.filters.search,
				);
				if (data.error_code === 1) {
					this.invoicesData = (data.items || []).map(this.mapInvoiceFromApi);
					console.log('RAW INVOICE:', data.items?.[0]);
					this.totalInvoices = data.total ?? data.count ?? this.invoicesData.length;
					if (this.invoicesData.length) {
						this.selectedInvoice = this.invoicesData[0];
					}
				} else {
					this.$noty.error(data.error_str || 'Ошибка загрузки инвойсов', { layout: 'bottomRight', timeout: 3000 });
				}
				console.log('INVOICE AFTER SALE:', this.selectedInvoice);
console.log('PAYMENTS:', this.selectedInvoice?.payments);
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети', { layout: 'bottomRight', timeout: 3000 });
			} finally {
				this.isLoading = false;
			}
			// Статистика (count/sum по всей выборке) грузится тем же фильтром,
			// но отдельным запросом — не блокируем строки таблицы её ожиданием.
			this.loadStats();
		},

		// crm.api.invoice.stat — считает count/sum по ВСЕЙ выборке под текущим
		// фильтром (а не по одной странице), см. InvoiceApi::doStat.
		async loadStats() {
			try {
				const data = await this.mfModel.getInvoicesStat(this.buildServerFilter());
				if (data.error_code === 1) {
					this.statsData = data;
					// count с doStat считается по тому же фильтру, что и doSearch,
					// так что используем его как более точный источник "Найдено" —
					// data.total из getInvoices тоже верный, но держим оба в синхроне.
					if (data.invoices_count != null) {
						this.totalInvoices = data.invoices_count;
					}
				}
			} catch (e) {
				console.error(e);
			}
		},

		// Сырые поля из trade (bmc.trade2.model.invoices2.getDataMore, см.
		// InvoiceApi::doSearch -> data) приводим к виду, понятному таблице.
		// Полный набор полей — 1:1 с invoices_struct/FILTERABLE_FIELDS, плюс
		// служебные поля из самого шаблона строки (warehousesoptions[...],
		// amount_paid.value, client_cardnum) — см. invoices.html, строки 564-588.
		mapInvoiceFromApi(el) {
			// trade отдаёт client уже как HTML-строку вида "Имя<br/>(логин: X, id:Y)"
			// (легаси-формат под |raw в invoices.html). При обычной {{ }}-интерполяции
			// Vue экранирует теги, и на экране видна сырая разметка — см. скрин.
			// Разбираем на "имя" + "мета" и рендерим двумя строками без v-html
			// (v-html сюда ставить не стоит: client приходит от trade, а не от
			// доверенного источника на фронте).
			const clientRaw = el.client || '';
			const clientBrIdx = clientRaw.search(/<br\s*\/?>/i);
			const clientName = (clientBrIdx >= 0 ? clientRaw.slice(0, clientBrIdx) : clientRaw)
				.replace(/<[^>]+>/g, '')
				.trim();
			const clientMeta = (clientBrIdx >= 0 ? clientRaw.slice(clientBrIdx).replace(/<br\s*\/?>/i, '') : '')
				.replace(/<[^>]+>/g, '')
				.trim();
			return {
				id: el.pkid,
				pkid: el.pkid,
				id_str: el.invoice_number || el.pkid,
				client: clientName,
				clientMeta,
				hyperId: el.client_cardnum || '',
				clientPkid: el.client_pkid || null,
				date: el.ugmtimeAdd || el.dateSale || '',
				dateAdd: el.ugmtimeAdd || '',
				dateChange: el.ugmtimeChange || '',
				dateSale: el.dateSale || '',
				amount: (el.amount_paid && el.amount_paid.value) || el.amount_paid || 0,
				status: Number(el.status),
				isPayed: !!el.isPayed,
				type: el.type,
				warehouse: el.warehouse_name || (this.warehouseOptions.find((w) => w.value === el.warehouse_pkid)?.label) || '',
				warehouse_pkid: el.warehouse_pkid,
				delivery_method: el.delivery_method,
				deliveryInfo: el.delivery_info || '',
				productsCount: el.products_count || 0,
				pickerLogin: el.picker_login || '',
				refererLogin: el.referer_login || '',
				consultantLogin: el.consultant_login || '',
				cashierLogin: el.cashier_login || '',
				creatorLogin: el.creator_login || '',
				paymentsCount: el.payments_count || 0,
				payments: el.payments || [],
				paymentMethod: '',
				mlmRewardPct: 0,
				items: this.groupInvoiceProducts(el.products || []),
			};
		},

		// invoicedata.products в trade — массив ФИЗИЧЕСКИХ ЕДИНИЦ товара (у каждой свой
		// QR-код: qr_code_creator_number/qr_code_serial_number), а не строк заказа с
		// количеством — см. invoices.html, рендер invoice-product-row (~строка 12528):
		// $.each(invoicedata.products||[], function(i, product){...}). Поэтому один и тот
		// же tid встречается несколько раз отдельными записями. Тут группируем по tid,
		// чтобы получить нормальную строку состава: имя (product.offer_name — не tid и не
		// 'name', этого поля в trade нет), кол-во единиц, цена за единицу с учётом скидки
		// (product.amount.value минус product.discount%, см. invoices.html ~12691-12693)
		// и сумму по позиции.
		groupInvoiceProducts(products) {
			const map = new Map();
			products.forEach((p) => {
				const key = p.tid || p.offer_name;
				const unitAmount = (p.amount && p.amount.value) || 0;
				const discountPct = Number(p.discount) || 0;
				const unitPrice = Math.round(unitAmount - (unitAmount / 100) * discountPct);

				if (!map.has(key)) {
					map.set(key, {
						sku: p.tid || '',
						name: p.offer_name || p.tid || '—',
						qty: 0,
						unitPrice,
						price: 0,
					});
				}
				const entry = map.get(key);
				entry.qty += 1;
				entry.price += unitPrice;
			});
			return Array.from(map.values());
		},

		// Создание инвойса — раздел был "только чтение (SST)", но своего API
		// создания в InvoiceApi.php нет и заводить не стали: вызываем trade
		// напрямую тем же способом, что getWarehouses/getDeliveryMethods
		// (mfModel.createInvoiceOrder -> bmc.trade2.model.invoices2.addOrder).
		// error_code трактуем максимально широко (1 = успех) — конкретные
		// отрицательные коды ошибок из legacy (-1000001 и т.п.) здесь не
		// разобраны за неимением бэкенда trade под рукой, см. общий catch.
		async handleCreateInvoice(payload, { done, finish } = {}) {
			const { docType, ...rest } = payload;
			const isSale = docType === 'sale';
			try {
				const data = isSale
					? await this.mfModel.createInvoiceSale(rest)
					: await this.mfModel.createInvoiceOrder(rest);
				if (data.error_code === 1) {
					this.$noty.success(isSale ? 'Продажа успешно создана' : 'Заказ успешно создан', { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					this.pagination.pageIndex = 0;
					this.loadInvoices();
				} else {
					this.$noty.error(data.error_str || 'Не удалось создать инвойс', { layout: 'bottomRight', timeout: 4000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети при создании инвойса', { layout: 'bottomRight', timeout: 3000 });
				done?.();
			}
		},

		// Оформление возврата — зеркало invoiceReturnShowAdd()/createInvoiceReturn()
		// из invoices.html (кнопка .invoice-return-add-btn), см. InvoiceReturnModal.vue.
		async handleCreateReturnInvoice(payload, { done, finish } = {}) {
			try {
				const data = await this.mfModel.createInvoiceReturn(payload);
				if (data.error_code === 1) {
					this.$noty.success('Возврат успешно оформлен', { layout: 'bottomRight', timeout: 3000 });
					finish?.();
					this.pagination.pageIndex = 0;
					this.loadInvoices();
				} else {
					this.$noty.error(data.error_str || 'Не удалось оформить возврат', { layout: 'bottomRight', timeout: 4000 });
					done?.();
				}
			} catch (e) {
				console.error(e);
				this.$noty.error('Ошибка сети при оформлении возврата', { layout: 'bottomRight', timeout: 3000 });
				done?.();
			}
		},

		// Список из doSearch не содержит products (только сводный productsCount),
		// поэтому при открытии карточки инвойса дотягиваем полный состав отдельным
		// запросом (см. InvoiceApi::doDetails/mfModel.getInvoiceDetails) и группируем
		// его через groupInvoiceProducts. itemsLoading — чтобы в шаблоне показать
		// "Загрузка..." вместо пустого "Состав недоступен" на время запроса.
		async openDrawer(inv) {
			this.selectedInvoice = { ...inv, itemsLoading: true };
			this.editStatus = Number(inv.status);
			this.isDrawerOpen = true;
			console.log('FULL INVOICE:', this.selectedInvoice);

			try {
				const data = await this.mfModel.getInvoiceDetails(inv.pkid, this.companyPkid);
				if (data.error_code === 1 && data.item) {
					const items = this.groupInvoiceProducts(data.item.products || []);
					// пользователь мог успеть закрыть/переключить карточку, пока шёл запрос
					if (this.selectedInvoice && this.selectedInvoice.pkid === inv.pkid) {
						this.selectedInvoice = { ...this.selectedInvoice,...data.item, items, itemsLoading: false };
					}
				} else if (this.selectedInvoice && this.selectedInvoice.pkid === inv.pkid) {
					this.selectedInvoice.itemsLoading = false;
				}
			} catch (e) {
				console.error('Не удалось загрузить состав инвойса', e);
				if (this.selectedInvoice && this.selectedInvoice.pkid === inv.pkid) {
					this.selectedInvoice.itemsLoading = false;
				}
			}
		},
		closeDrawer() {
			this.isDrawerOpen = false
		},
		selectInvoice(inv) {
			this.selectedInvoice = inv;
		},

		// status — код из EnumApi::INVOICE_STATUS_LABELS (зеркало
		// ioEnum.invoices_statuses в trade): -1 отмена, 0..11 — в работе,
		// 12 — доставлен (финал), 101/102 — ветка возврата.
		getStatusBadgeClass(status) {
			status = Number(status);
			if (status === -1) return 'bg-red-50 text-red-700 border-red-200';
			if (status === 12) return 'bg-emerald-50 text-emerald-700 border-emerald-200';
			if (status === 101 || status === 102) return 'bg-slate-50 text-slate-500 border-slate-200';
			return 'bg-blue-50 text-blue-700 border-blue-200';
		},

		getStatusLabel(status) {
			// status от trade может прийти и числом, и строкой ("0") — сравниваем
			// приведя оба к Number, иначе Badge молча падает в fallback (сырой код).
			const found = this.statusOptions.find((o) => Number(o.value) === Number(status));
			return found ? found.label : (status ?? '-');
		},

		getTypeLabel(type) {
			const found = this.typeOptions.find((o) => o.value === type);
			return found ? found.label : (type ?? '-');
		},

		formatCurrency(val) {
			return new Intl.NumberFormat('ru-RU').format(val) + ' ₸';
		},

		resetFilters() {
			this.filters.search = '';
			this.globalFilter = '';
			this.columnFilters = [];
			this.toolbarFilters = [];
			if (this.table) {
				this.table.resetColumnFilters();
			}
			this.pagination.pageIndex = 0;
			this.loadInvoices();
			this.$noty.info('Фильтры сброшены. Отображаются все фискальные документы.', {
				layout: 'bottomRight',
				timeout: 3000
			});
		},

		downloadPDF(inv) {
			this.$noty.success(`PDF инвойса #${inv.id_str} успешно сгенерирован и скачивается.`, {
				layout: 'bottomRight',
				timeout: 3000
			});
		},

		async changeInvoiceStatus(inv, newStatus) {
			try {
				const res = await this.mfModel.changeInvoiceStatus({
					pkid: inv?.pkid,
					company_pkid: this.companyPkid,
					status: newStatus,
				});

				if (res && (res.error_code === 1 || res.error_code === 0)) {
					inv.status = newStatus;
					this.$noty.success('Статус инвойса успешно изменён', { layout: 'bottomRight', timeout: 3000 });
					this.loadInvoices();
				} else {
					const errorMsg = res?.error_str || 'Не удалось изменить статус инвойса';
					this.$noty.error(errorMsg, { layout: 'bottomRight', timeout: 3000 });
				}
			} catch (e) {
				this.$noty.error('Произошла ошибка при изменении статуса', { layout: 'bottomRight', timeout: 3000 });
			}
		},

		triggerRefundWebhook(inv) {
			inv.status = 'Refunded';
			this.$noty.error(`По инвойсу #${inv.id_str} оформлен возврат. С реферальной сети списано MLM вознаграждение, XP-очки надомных мастеров заморожены.`, {
				layout: 'bottomRight',
				timeout: 3000
			});
		},
		
		viewInvoice(inv) {
			localStorage.setItem('selectedInvoice', JSON.stringify(inv));
			this.$router.push({
				name: 'crm-invoice-details',
				params: { id: inv.id },
			});
		},

		formatDateTime(value) {
			if (!value) {
				return '—';
			}

			const date = new Date(value);

			if (isNaN(date.getTime())) {
				return '—';
			}

			const pad = (number) => String(number).padStart(2, '0');

			return `${pad(date.getDate())}.${pad(date.getMonth() + 1)}.${date.getFullYear()} ${pad(date.getHours())}:${pad(date.getMinutes())}`;
		},

		async saveInvoiceStatus() {
			await this.editInvoiceEvent('edit');
		},
		
		async editInvoiceEvent(event, payments = []) {
			if (!this.selectedInvoice) {
				return;
			}

			this.isSavingInvoice = true;

			try {
				const params = {
					pkid: this.selectedInvoice.pkid,
					company_pkid: this.companyPkid,
					status: Number(this.editStatus),
					event,
				};

				if (event === 'edit-sale' || event === 'edit-sale-delivery') {
					params.payments = payments;
				}
				console.log('SALE PARAMS:', JSON.stringify(params, null, 2));
				const res = await this.mfModel.editInvoice(params);
				console.log('SALE RESPONSE:', JSON.stringify(res, null, 2));

				if (res?.error_code === 1 || res?.error_code === 0) {
					this.$noty.success(
						event === 'edit-sale'
							? 'Продажа успешно выполнена'
							: 'Инвойс успешно изменён',
						{
							layout: 'bottomRight',
							timeout: 3000,
						}
					);

					await this.loadInvoices();
					return;
				}

				this.$noty.error(
					res?.error_str || 'Не удалось изменить инвойс',
					{
						layout: 'bottomRight',
						timeout: 3000,
					}
				);
			} catch (e) {
				this.$noty.error(
					'Произошла ошибка при изменении инвойса',
					{
						layout: 'bottomRight',
						timeout: 3000,
					}
				);
			} finally {
				this.isSavingInvoice = false;
			}
		},

		async addPaymentAndSale() {
			if (!this.selectedInvoice) {
				return;
			}

			const amount = Number(
				this.selectedInvoice?.amount_paid?.value
				|| this.selectedInvoice?.amount?.value
				|| 0
			);

			if (amount <= 0) {
				this.$noty.error('Некорректная сумма платежа');
				return;
			}

			const payments = [{
				type: '1',
				pay_type: '0',
				moneypacket_pkid: '0',
				moneypacket_group_pkid: '',
				moneypacket_company_pkid: '',
				vseobuch_period_pkid: '',
				amount: {
					value: amount,
					currency: this.selectedInvoice?.currency || 'KZT',
					pay_type: '0',
				},
			}];

			await this.editInvoiceEvent('edit-sale', payments);
		},

		openPaymentDialog() {
			if (!this.selectedInvoice) {
				return;
			}

			this.paymentType = '1';
			this.paymentPayType = '0';

			this.paymentAmount = Number(
				this.selectedInvoice?.amount_paid?.value
				|| this.selectedInvoice?.amount?.value
				|| 0
			);

			this.isPaymentDialogOpen = true;
		},

		closePaymentDialog() {
			if (!this.paymentProcessing) {
				this.isPaymentDialogOpen = false;
			}
		},

		async confirmPayment() {
			if (!this.selectedInvoice) {
				return;
			}

			const amount = Number(this.paymentAmount);

			if (amount <= 0) {
				this.$noty.error('Укажите сумму платежа');
				return;
			}

			const payment = {
				type: this.paymentType,
				pay_type: this.paymentPayType,
				moneypacket_pkid: '0',
				moneypacket_group_pkid: '',
				moneypacket_company_pkid: '',
				vseobuch_period_pkid: '',
				amount: {
					value: amount,
					currency: this.selectedInvoice?.currency || 'KZT',
					pay_type: this.paymentPayType,
				},
			};

			this.pendingPayments.push(payment);

			this.$noty.success('Платеж добавлен');
			console.log('pendingPayments:', this.pendingPayments);

			this.isPaymentDialogOpen = false;
		},
	},
};
</script>
