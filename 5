	computed: {
		companyPkid() {
			return this.$store.state.io7.auth.selectedCabPkid;
		},
		isInvoiceDelivered() {
			return Number(this.selectedInvoice?.status) === 12;
		},
		isInvoiceCancelled() {
			return Number(this.selectedInvoice?.status) === -1;
		},
		isInvoiceSold() {
			return Number(this.selectedInvoice?.status) === 2;
		},
		canEditInvoice() {
			return !this.isInvoicePreparing
				&& !this.isInvoiceDelivered
				&& !this.isInvoiceCancelled;
		},
		canSale() {
			return !this.isInvoiceSold
				&& !this.isInvoiceDelivered
				&& !this.isInvoiceCancelled
				&& this.pendingPayments.length > 0;
		},
		canAddPayment() {
			const status = Number(this.selectedInvoice?.status);

			return status !== 12
				&& status !== -1
				&& !this.selectedInvoice?.isPayed;
		},
		isInvoicePreparing() {
			return Number(this.selectedInvoice?.status) === 2;
		},
		availableStatusOptions() {
			return this.statusOptions.filter(option => {
				return ![12, -1].includes(Number(option.value));
			});
		},
		filteredRows() {
			return this.table ? this.table.getRowModel().rows : [];
		},
		// БЫЛО: считалось через filteredRows.reduce(...) — но при manualPagination
		// filteredRows это только строки ТЕКУЩЕЙ страницы (до 10 шт.), а не весь
		// набор, попадающий под фильтр. Из-за этого "Всего" в шапке на деле
		// показывало сумму по странице. Берём готовую сумму с бэка (doStat),
		// который считает её по всей выборке — см. loadStats().
		totalInvoicesSum() {
			return this.statsData?.invoices_sum ?? 0;
		},
		// Список полей для FilterSelector — 1:1 с INVOICE_FILTER_FIELDS
		// (select/number/date из invoices_struct), см. filterOptions в CustomersList.vue.
		filterOptions() {
			return Object.entries(INVOICE_FILTER_FIELDS).map(([value, meta]) => ({
				label: meta.label,
				value,
			}));
