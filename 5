<script>
import FacetedFilter from 'io7/components/tailux/shared/table/FacedtedFilter.vue';
import RangeFilter from 'io7/components/tailux/shared/table/RangeFilter.vue';
import DateFilter from 'io7/components/tailux/shared/table/DateFilter.vue';
import FilterSelector from 'io7/components/tailux/shared/table/FilterSelector.vue';
import Badge from 'io7/components/tailux/ui/Badge.vue';
import Button from 'io7/components/tailux/ui/Button.vue';
import Table from 'io7/components/tailux/ui/Table.vue';
import Input from 'io7/components/tailux/ui/form/Input.vue';
import Checkbox from 'io7/components/tailux/ui/form/Checkbox.vue';
import SelectedRowsActions from "io7/components/tailux/shared/table/SelectedRowsActions.vue";
import PaginationSection from "io7/components/tailux/shared/table/PaginationSection.vue";
import InvoiceCreateModal from '../components/pages/invoices/modals/InvoiceCreateModal.vue';
import InvoiceReturnModal from '../components/pages/invoices/modals/InvoiceReturnModal.vue';
import {
	getCoreRowModel,
	getFilteredRowModel,
	getSortedRowModel,
	getFacetedRowModel,
	getFacetedUniqueValues,
	useVueTable,
	createColumnHelper,
	getPaginationRowModel,
} from '@tanstack/vue-table';
import { rankItem } from '@tanstack/match-sorter-utils';
import { TransitionRoot, TransitionChild, Dialog, DialogPanel } from '@headlessui/vue'

const fuzzyFilter = (row, columnId, value, addMeta) => {
	const itemRank = rankItem(row.getValue(columnId), value);
	addMeta({ itemRank });
	return itemRank.passed;
};

// Дискретный фильтр (чекбоксы) — под FacetedFilter. 1:1 с facetFilterFn из CustomersList.vue.
const facetedFilter = (row, columnId, filterValue) => {
	if (!filterValue) return true;
	const { op, values } = filterValue;
	const cell = row.getValue(columnId);
	if (op === 'empty') return !cell;
	if (op === 'notEmpty') return !!cell;
	if (!values?.length) return true;
	switch (op) {
		case 'equals': return values.includes(cell);
		case 'notEquals': return !values.includes(cell);
		default: return values.includes(cell);
	}
};

// Диапазонный фильтр (мин/макс, числа) — под RangeFilter. 1:1 с rangeFilterFn из CustomersList.vue.
const rangeFilterFn = (row, columnId, filterValue) => {
	if (!filterValue) return true;
	const { op, min, max } = filterValue;
	const raw = row.getValue(columnId);
	const value = raw === '' || raw === null || raw === undefined ? null : Number(raw);
	if (value === null) return false;

	const minN = min !== '' && min !== undefined ? Number(min) : null;
	const maxN = max !== '' && max !== undefined ? Number(max) : null;

	switch (op) {
		case 'equals': return minN !== null && value === minN;
		case 'notEquals': return minN !== null && value !== minN;
		case 'gt': return minN !== null && value > minN;
		case 'gte': return minN !== null && value >= minN;
		case 'lt': return minN !== null && value < minN;
		case 'lte': return minN !== null && value <= minN;
		case 'between':
			if (minN !== null && value < minN) return false;
			if (maxN !== null && value > maxN) return false;
			return true;
		default: return true;
	}
};

// Фильтр по дате — под DateFilter. 1:1 с dateFilterFn из CustomersList.vue (там же пометка,
// что сигнатура {op, value} / {op, from, to} — предположение по формату emit'а DateFilter.vue,
// т.к. исходника компонента не было под рукой; если он другой — поправить тут).
const dateFilterFn = (row, columnId, filterValue) => {
	if (!filterValue) return true;
	const { op, value, from, to } = filterValue;
	const raw = row.getValue(columnId);
	if (!raw) return op === 'empty';

	const cellTime = new Date(raw).getTime();

	switch (op) {
		case 'empty': return false;
		case 'notEmpty': return true;
		case 'equals': return value ? new Date(raw).toDateString() === new Date(value).toDateString() : true;
		case 'before': return value ? cellTime < new Date(value).getTime() : true;
		case 'after': return value ? cellTime > new Date(value).getTime() : true;
		case 'between': {
			if (from && cellTime < new Date(from).getTime()) return false;
			if (to && cellTime > new Date(to).getTime()) return false;
			return true;
		}
		default: return true;
	}
};

const columnHelper = createColumnHelper();

// Метаданные select/number/date-полей invoices_struct — источник для FilterSelector
// (:options="filterOptions") и для выбора виджета (isDateFilterField/isRangeFilterField
// ниже). Текстовые ('input') поля сюда не входят — как и TEXT_TYPES в CustomersList,
// они не участвуют в FilterSelector. Отдельного текстового инпута под них тоже нет:
// InvoiceApi::buildFilter комбинирует все ключи через AND, а не OR, поэтому "один
// инпут -> много полей сразу" физически не работает, пока на бэке не появится
// честный OR по списку текстовых полей — поиск по ним не реализован в UI.
const INVOICE_FILTER_FIELDS = {
	invoice_number:   { type: 'number', label: 'Номер инвойса' },
	ugmtimeAdd:       { type: 'date',   label: 'Дата создания' },
	ugmtimeChange:    { type: 'date',   label: 'Дата изменения' },
	dateSale:         { type: 'date',   label: 'Дата продажи' },
	type:             { type: 'select', label: 'Тип' },
	delivery_method:  { type: 'select', label: 'Способ доставки' },
	warehouse_pkid:   { type: 'select', label: 'Склад' },
	status:           { type: 'select', label: 'Статус' },
	isPayed:          { type: 'select', label: 'Оплата' },
	products_count:   { type: 'number', label: 'Кол-во товаров' },
};

// Колонки таблицы: покрывают все поля invoices_struct из trade (см. InvoiceApi::FILTERABLE_FIELDS).
// select -> facetedFilter, number -> rangeFilterFn, date -> dateFilterFn — сама фильтрация
// теперь идёт на сервере (manualFiltering: true), эти filterFn нужны только для того, чтобы
// у колонки была валидная filterFn (того же требует TanStack Table) и для getFacetedUniqueValues.
const columns = [
	columnHelper.accessor('client',         { id: 'client',         filterFn: 'fuzzy' }),
	columnHelper.accessor('id_str',         { id: 'id_str',         filterFn: 'fuzzy' }),
	columnHelper.accessor('hyperId',        { id: 'hyperId',        filterFn: 'fuzzy' }),
	columnHelper.accessor('status',         { id: 'status',         filterFn: facetedFilter }),
	columnHelper.accessor('type',           { id: 'type',           filterFn: facetedFilter }),
	columnHelper.accessor('isPayed',        { id: 'isPayed',        filterFn: facetedFilter }),
	columnHelper.accessor('warehouse_pkid', { id: 'warehouse_pkid', filterFn: facetedFilter }),
	columnHelper.accessor('delivery_method',{ id: 'delivery_method',filterFn: facetedFilter }),
	columnHelper.accessor('id_str',         { id: 'invoice_number', filterFn: rangeFilterFn }),
	columnHelper.accessor('productsCount',  { id: 'products_count', filterFn: rangeFilterFn }),
	columnHelper.accessor('dateAdd',        { id: 'ugmtimeAdd',     filterFn: dateFilterFn }),
	columnHelper.accessor('dateChange',     { id: 'ugmtimeChange',  filterFn: dateFilterFn }),
	columnHelper.accessor('dateSale',       { id: 'dateSale',       filterFn: dateFilterFn }),
];

export default {
	name: 'InvoicesListPage',

	components: {
		FacetedFilter,
		RangeFilter,
		DateFilter,
		FilterSelector,
		Badge,
		Table,
		Input,
		Button,
		Checkbox,
		SelectedRowsActions,
		PaginationSection,
		TransitionRoot,
		TransitionChild,
		Dialog,
		DialogPanel,
		InvoiceCreateModal,
		InvoiceReturnModal,
	},

	data() {
		return {
			isDrawerOpen: false,

			isPaymentDialogOpen: false,
			paymentTypes: [
